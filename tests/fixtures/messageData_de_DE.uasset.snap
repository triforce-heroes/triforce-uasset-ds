        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10020,
    "idSub": 11,
    "message": "In einem ungewerteten Kampf kannst du sofort spielen, ohne Bedingungen festzulegen. Empfohlen, wenn du schnell kämpfen möchtest.",
  },
  "Tutorial_APK2_DLC_Title_0020:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
