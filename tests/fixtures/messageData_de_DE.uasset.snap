        0,
      ],
      "type": "Buffer",
    },
    "id": 1122,
    "idSub": 2641,
    "message": "Du bist die Neue, oder? Sind deine Arme nicht ein bisschen ... dick? Und deine Schultern sind auch eigenartig breit ...",
  },
  "APK_Main11_Talk:2642" => {
    "attribute": {
