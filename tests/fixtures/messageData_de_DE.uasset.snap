      ],
      "type": "Buffer",
    },
    "id": 7945,
    "idSub": 0,
    "message": "Und als ich in die Stadt kam, kauften alle Leute unsere Holzkohle. Ich war wirklich dankbar dafür, ich war ...",
  },
  "PictureBook_Line_0150:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
