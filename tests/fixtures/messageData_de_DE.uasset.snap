        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 9117,
    "idSub": 0,
    "message": "Wir wurden alle auf dem schaurigen Berg voneinander getrennt. Tief im Wald traf ich ein Dämonenkind, das Lügen über seine familiäre „Bande" erzählte.",
  },
  "StoryBattle_0500:0" => {
    "attribute": {
      "data": [
        0,
        9,
        19,
        0,
