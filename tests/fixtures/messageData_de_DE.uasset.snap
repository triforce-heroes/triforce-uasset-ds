      "type": "Buffer",
    },
    "id": 1315,
    "idSub": 0,
    "message": "Hey, wusstest du, dass ein wunderschönes junges Mädchen kürzlich dem Haus Ogimoto beigetreten ist? Ihr Name ist Inoko.",
  },
  "APK_Main12_Talk_0171:0" => {
