    "id": 9097,
    "idSub": 0,
    "message": "Jedes Mal, wenn Glück zerbricht, liegt der Geruch von Blut in der Luft.",
  },
  "StoryBattle_0140:0" => {
    "attribute": {
      "data": [
        0,
        9,
        19,
        0,
        0,
        0,
        214,
        4,
        0,
        0,
