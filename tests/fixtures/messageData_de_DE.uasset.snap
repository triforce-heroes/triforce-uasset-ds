      "type": "Buffer",
    },
    "id": 1343,
    "idSub": 0,
    "message": "In Yoshiwara gibt es sowohl Kurtisanen, die gerade erst angekommen sind, als auch Kurtisanen, die Yoshiwara wieder verlassen.",
  },
  "APK_Main12_Talk_0251:0" => {
