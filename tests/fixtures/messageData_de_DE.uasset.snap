    "id": 4576,
    "idSub": 2391,
    "message": "Ich sagte ihr: „Menschen sind deine Familie. Beschütze deine Familie! Dämonen sind deine Feinde! Erlaube keinem Dämon, Menschen zu verletzen!"",
  },
  "FamousSaying:2401" => {
