      ],
      "type": "Buffer",
    },
    "id": 10030,
    "idSub": 11,
    "message": "Ranglistenkampf",
  },
  "Tutorial_APK2_DLC_text_0020:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10021,
    "idSub": 11,
    "message": "Bestreite und gewinne Kämpfe in diesem Modus, um Rangpunkte und Jägerpunkte zu erhalten. Die Ranglisten sind in Saisons unterteilt, die jeweils einen Monat lang dauern.",
  },
  "Tutorial_APK2_DLC_text_0020:21" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10021,
    "idSub": 21,
    "message": "Die Rangpunkte sinken bei einer Niederlage. Jägerpunkte werden im Laufe der Saisons gesammelt und gehen nicht verloren, wenn du Kämpfe verlierst.",
  },
  "Tutorial_APK2_DLC_Title_0030:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10031,
    "idSub": 11,
    "message": "Jägerrang",
  },
  "Tutorial_APK2_DLC_text_0030:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10022,
    "idSub": 11,
    "message": "Dein Jägerrang steigt mit den Jägerpunkten, die du in den Ranglistenkämpfen sammelst. Strebe nach dem höchsten Säule-Rang!",
  },
  "Tutorial_APK2_DLC_Title_0040:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
