      ],
      "type": "Buffer",
    },
    "id": 10235,
    "idSub": 0,
    "message": "Fersenkick: Drücke <kcId_kcId_Battle_Skill/> während du <kcId_kcId_Battle_Move/> verwendest.",
  },
  "Tutorial_t_0037:0" => {
    "attribute": {
