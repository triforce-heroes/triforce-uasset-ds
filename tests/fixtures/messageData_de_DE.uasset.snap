        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 9112,
    "idSub": 0,
    "message": "Er war ein eindrucksvoller Gegner, der mit einer mysteriösen Trommel angriff. Trotzdem habe ich es überstanden und gewonnen.",
  },
  "StoryBattle_0450:0" => {
    "attribute": {
      "data": [
        0,
        9,
        19,
        0,
        0,
        0,
