    "id": 1340,
    "idSub": 0,
    "message": "Das neue Mädchen in Haus Tokitō hat ein Mal auf der Stirn, genau wie du. Ich habe dich mit ihr verwechselt.",
  },
  "APK_Main12_Talk_0242:0" => {
    "attribute": {
