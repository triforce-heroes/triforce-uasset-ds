        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2364,
    "idSub": 0,
    "message": "Es kann immer ein Dämon erscheinen. Darum stehen wir weiter Wache und patrouillieren nachts.",
  },
  "APK_Main20_Talk_0540:0" => {
    "attribute": {
      "data": [
