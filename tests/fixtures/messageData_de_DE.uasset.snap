      "type": "Buffer",
    },
    "id": 1338,
    "idSub": 0,
    "message": "Schließlich ist das ein Geschäft. Und in einem Geschäft sollte man keine Kurtisanen beschäftigen, die nicht arbeiten können.",
  },
  "APK_Main12_Talk_0240:0" => {
    "attribute": {
