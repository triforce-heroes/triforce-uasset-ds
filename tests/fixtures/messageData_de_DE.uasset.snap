        78,
        26,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 7937,
    "idSub": 0,
    "message": "Das ist wohl ein Tagebuch von jemandem.",
  },
  "PictureBook_Line_0070:0" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        78,
        26,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 7938,
    "idSub": 0,
    "message": "Damals, als ich bei Urokodaki-san wohnte, habe ich auch ein Tagebuch über Nezuko geführt.",
  },
  "PictureBook_Line_0080:0" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        78,
        26,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 7939,
    "idSub": 0,
    "message": "Ich machte mir ernsthaft Sorgen, weil es so schien, als würde sie für immer schlafen ... Ich bin so froh, dass sie wieder aufgewacht ist und keine Probleme hat.",
  },
  "PictureBook_Line_0090:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        63,
        5,
        0,
        0,
        78,
        26,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 7940,
    "idSub": 0,
    "message": "Oh, ein Reiscracker! Das erinnert mich irgendwie an alte Zeiten.",
  },
  "PictureBook_Line_0100:0" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
