        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4653,
    "idSub": 0,
    "message": "(Würden die Leute wieder behaupten, dass ich nicht menschlich sein kann, wenn ich stark wäre? Ich hatte solche Angst, dass ich meine Kraft zurückhielt ... Aber jetzt nicht mehr.)",
  },
  "FamousSaying_0780:0" => {
    "attribute": {
