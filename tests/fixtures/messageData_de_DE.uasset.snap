      "type": "Buffer",
    },
    "id": 2959,
    "idSub": 0,
    "message": "Nun, ich sagte zwar „kleiner Streit" aber wir hatten eigentlich eine kleine Meinungsverschiedenheit über die Arbeit.",
  },
  "APK_Sub13_Talk_0022:0" => {
    "attribute": {
