        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 7943,
    "idSub": 0,
    "message": "Holzkohle, hm ... Das erinnert mich an mein Leben, bevor ich zu den Dämonenjägern kam.",
  },
  "PictureBook_Line_0130:0" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
