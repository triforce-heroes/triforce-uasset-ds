      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 2401,
    "message": "Falls Nezuko noch einen Menschen angreift, werden Kamado Tanjirō, Tomioka Giyū und ich dafür büßen, indem wir Seppuku begehen.",
  },
  "FamousSaying:2411" => {
