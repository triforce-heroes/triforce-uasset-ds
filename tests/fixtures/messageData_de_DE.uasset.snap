      "type": "Buffer",
    },
    "id": 1339,
    "idSub": 0,
    "message": "Hm? Moment mal, bist du ...? Nein. Du bist es nicht. Tut mir leid.",
  },
  "APK_Main12_Talk_0241:0" => {
    "attribute": {
      "data": [
