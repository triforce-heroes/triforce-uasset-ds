      "type": "Buffer",
    },
    "id": 2377,
    "idSub": 0,
    "message": "Wenn mich dieses Training besser macht, bekomme ich vielleicht zumindest eine Frau ab.",
  },
  "APK_Main20_Talk_0570:0" => {
    "attribute": {
      "data": [
