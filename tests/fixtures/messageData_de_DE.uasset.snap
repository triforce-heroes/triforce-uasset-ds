      ],
      "type": "Buffer",
    },
    "id": 7783,
    "idSub": 0,
    "message": "Bildet dünne Klingen aus Blut und wirft sie auf den Gegner. Verursacht Gift. Kann durch schnelles Ausweichen unterbrochen werden. Verbraucht 20 % der Technikanzeige.",
  },
  "P1015_V00_C00_SkillInfo_0010:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 7784,
    "idSub": 0,
    "message": "Greift mehrfach mit schwingenden Sicheln an. Ein zusätzlicher Treffer wird durch Wiederholen der Eingabe hinzugefügt. Verursacht Gift. Kann durch schnelles Ausweichen unterbrochen werden. Verbraucht 20 % der Technikanzeige.",
  },
  "P1015_V00_C00_SkillInfo_0020:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 7785,
    "idSub": 0,
    "message": "Greift den umliegenden Bereich mit Bluthieben an. Zu Beginn unbesiegbar. Verursacht Gift. Eingabe zum Verlängern halten. Kann durch schnelles Ausweichen unterbrochen werden. Verbraucht 20 % der Technikanzeige.",
  },
  "P1015_V00_C00_SkillInfo_0030:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 7786,
    "idSub": 0,
    "message": "Bedeckt die Arme mit Spiralen aus Blut und greift den Gegner an. Während des Angriffs weichst du bei einem Treffer des Gegners nicht zurück. Verursacht Gift. Verbraucht 50 % der Dämonenanzeige.",
  },
  "P1015_V00_C00_SkillInfo_0040:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 7787,
    "idSub": 0,
    "message": "Bildet dünne Klingen aus Blut und wirft sie auf den Gegner. Nach einer bestimmten Flugdistanz richten sich die Klingen erneut auf ihr Ziel aus. Verursacht Gift. Verbraucht 50 % der Dämonenanzeige.",
  },
  "P1015_V00_C00_SkillInfo_0060:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 7788,
    "idSub": 0,
    "message": "Zu Beginn unbesiegbar. Verursacht Gift. Verbraucht bei Aktivierung einen Spezialbalken und bei Treffer alle verbleibenden Balken. Je mehr Balken verbraucht werden, desto stärker der Angriff.",
  },
