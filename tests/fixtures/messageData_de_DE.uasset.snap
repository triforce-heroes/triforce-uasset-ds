    "id": 2977,
    "idSub": 0,
    "message": "Tut mir leid wegen all dem. Irgendetwas „Besonderes" an seinem Aussehen, hm?",
  },
  "APK_Sub13_Talk_0160:0" => {
    "attribute": {
