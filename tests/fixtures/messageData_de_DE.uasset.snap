      ],
      "type": "Buffer",
    },
    "id": 2383,
    "idSub": 0,
    "message": "Ich selbst bin froh, dass endlich alle Dämonenjäger trainiert werden.",
  },
  "APK_Main20_Talk_0611:0" => {
