        0,
      ],
      "type": "Buffer",
    },
    "id": 1336,
    "idSub": 0,
    "message": "Es gibt Kurtisanen, die nicht arbeiten können, und deshalb ihr Haus verlassen.",
  },
  "APK_Main12_Talk_0231:0" => {
    "attribute": {
      "data": [
        0,
