      ],
      "type": "Buffer",
    },
    "id": 7591,
    "idSub": 0,
    "message": "Erschafft zu Füßen des Gegners Pfeile, die nach oben zeigen. Diese lösen eine schadenverursachende Schockwelle aus. Bei Aktivierung der Technik weichst du nicht zurück. Verbraucht 50 % der Dämonenanzeige.",
  },
  "P1004_V00_C00_SkillInfo_0060:0" => {
