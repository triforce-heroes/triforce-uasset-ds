      "type": "Buffer",
    },
    "id": 2376,
    "idSub": 0,
    "message": "Sie sehen gut aus, sind stark, und es gibt gleich drei davon!",
  },
  "APK_Main20_Talk_0562:0" => {
    "attribute": {
      "data": [
