    "id": 439,
    "idSub": 0,
    "message": "Vor vielen, vielen Jahren ... nahm ich Waisenkinder auf und zog sie eigenhändig in einem kleinen Tempel groß.",
  },
  "APK2_BSG01_MemoryFragment_025_0020:0" => {
