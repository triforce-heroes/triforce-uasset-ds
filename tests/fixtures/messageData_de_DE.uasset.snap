      "type": "Buffer",
    },
    "id": 2957,
    "idSub": 0,
    "message": "Wa-Was ist los? Warum bist du so verärgert?",
  },
  "APK_Sub13_Talk_0020:0" => {
    "attribute": {
      "data": [
        0,
        9,
