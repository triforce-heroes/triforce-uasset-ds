  "BasicActionInfo_0115:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 3402,
    "idSub": 0,
    "message": "Wehrt einen Angriff ab und zieht sich zurück. Verbraucht 100 % der Dämonenanzeige.",
  },
  "NormalAttackInfo_0125:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 6118,
    "idSub": 0,
    "message": "Füllt die Technik- und Dämonenanzeige vollständig und stellt bei Aktivierung die Gesundheit wieder her. Erhöht Angriffskraft und Bewegungsgeschwindigkeit. Die Normaler-Angriff-Kombo erhält einen fünften Angriff. Verbraucht einen Balken der Spezialanzeige.",
  },
  "NormalAttackInfo_0135:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 6120,
    "idSub": 0,
    "message": "Zusätzlich zu den Vorteilen von Schub kannst du beliebig viele Techniken einsetzen. Während des Angriffs weichst du bei einem Treffer des Gegners nicht zurück. Stellt mehr Gesundheit wieder her als „Schub". Verbraucht einen Balken der Spezialanzeige.",
  },
