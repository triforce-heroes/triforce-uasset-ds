      "type": "Buffer",
    },
    "id": 1335,
    "idSub": 0,
    "message": "Ach, ich wollte unbedingt die Shamisen-Virtuosin des Hauses Kyogoku kennenlernen!",
  },
  "APK_Main12_Talk_0230:0" => {
    "attribute": {
      "data": [
