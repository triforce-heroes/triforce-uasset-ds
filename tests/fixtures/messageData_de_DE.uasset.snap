    "id": 4576,
    "idSub": 1811,
    "message": "Wenn ich das Mädchen verschlinge und ihre Eigenschaften erbe, dann kann auch ich die verfluchte Sonne besiegen!",
  },
  "FamousSaying:1821" => {
    "attribute": {
      "data": [
