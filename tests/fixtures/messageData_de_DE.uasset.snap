        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 1333,
    "idSub": 0,
    "message": "Doch als ich dort ankam, erklärten mir die Mitarbeiter des Hauses Kyogoku, dass ich mich geirrt haben müsse.",
  },
  "APK_Main12_Talk_0222:0" => {
    "attribute": {
