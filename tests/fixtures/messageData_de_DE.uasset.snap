      "type": "Buffer",
    },
    "id": 7947,
    "idSub": 0,
    "message": "Als ich Rengoku-san zum ersten Mal im Mugen-Zug traf, verschlang er alles mit solcher Begeisterung und rief die ganze Zeit: „Lecker! Lecker!"",
  },
  "PictureBook_Line_0170:0" => {
    "attribute": {
