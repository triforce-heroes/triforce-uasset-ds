      "type": "Buffer",
    },
    "id": 1337,
    "idSub": 0,
    "message": "Irgendwie habe ich ein schlechtes Gefühl dabei, aber es ist nun mal nicht zu ändern, wenn sie nicht arbeiten können.",
  },
  "APK_Main12_Talk_0232:0" => {
    "attribute": {
      "data": [
