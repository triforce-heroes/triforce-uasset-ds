        0,
        0,
        188,
        22,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2366,
    "idSub": 0,
    "message": "Ich hab sie gesehen! Was hat sie auf dem Kopf und um den Hals getragen? Juwelen? Hat echt geglitzert!",
  },
  "APK_Main20_Talk_0542:0" => {
    "attribute": {
      "data": [
