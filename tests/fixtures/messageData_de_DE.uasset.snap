      "type": "Buffer",
    },
    "id": 2381,
    "idSub": 0,
    "message": "Die Säulen sind einfach unglaublich. Wenn wir unseren Beitrag leisten wollen, müssen wir alles geben!",
  },
  "APK_Main20_Talk_0602:0" => {
    "attribute": {
      "data": [
