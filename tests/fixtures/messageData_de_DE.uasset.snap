        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2363,
    "idSub": 0,
    "message": "... stehen die Säulen und die anderen Jäger weiter Wache und patrouillieren nachts. Es kann immer ein Dämon erscheinen.",
  },
  "APK_Main20_Talk_0532:0" => {
    "attribute": {
      "data": [
