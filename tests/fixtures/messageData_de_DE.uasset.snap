      ],
      "type": "Buffer",
    },
    "id": 1334,
    "idSub": 0,
    "message": "Merkwürdig, nicht wahr? Ich habe es gerade erst erfahren, also muss sie dort sein.",
  },
  "APK_Main12_Talk_0223:0" => {
    "attribute": {
      "data": [
