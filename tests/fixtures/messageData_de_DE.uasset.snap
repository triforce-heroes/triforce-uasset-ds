      "type": "Buffer",
    },
    "id": 2368,
    "idSub": 0,
    "message": "Hast du Uzui-sans Verbindungskrähe gesehen? Die sah unglaublich spektakulär aus!",
  },
  "APK_Main20_Talk_0544:0" => {
    "attribute": {
      "data": [
