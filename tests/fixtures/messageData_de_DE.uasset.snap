      ],
      "type": "Buffer",
    },
    "id": 2357,
    "idSub": 0,
    "message": "Doch jetzt ist das allen Dämonenjägern erlaubt. So eine Gelegenheit kommt nie wieder!",
  },
  "APK_Main20_Talk_0512:0" => {
    "attribute": {
      "data": [
