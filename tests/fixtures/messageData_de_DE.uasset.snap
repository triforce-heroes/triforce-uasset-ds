    "id": 6108,
    "idSub": 0,
    "message": "Ein vierter, nachfolgender leichter Angriff. Bei einem Treffer wird der Gegner überwältigt und du kannst mit einer Technik nachsetzen.",
  },
  "NormalAttackInfo_0040:0" => {
    "attribute": {
