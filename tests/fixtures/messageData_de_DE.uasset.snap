    },
    "id": 364,
    "idSub": 0,
    "message": "Viel zu essen, stark zu sein, meine Haarfarbe ... Das ist alles ein Teil von mir. Werde ich vortäuschen, eine andere Person zu sein?",
  },
  "APK2_BSG01_MemoryFragment_018_0050:0" => {
