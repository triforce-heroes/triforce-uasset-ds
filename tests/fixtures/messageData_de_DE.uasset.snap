      ],
      "type": "Buffer",
    },
    "id": 2382,
    "idSub": 0,
    "message": "Die Säulen trainieren uns, schieben Wache und trainieren sich gegenseitig. Unglaublich! Wenn wir unseren Beitrag leisten wollen, müssen wir alles geben!",
  },
  "APK_Main20_Talk_0610:0" => {
