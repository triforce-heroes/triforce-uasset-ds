    "id": 1597,
    "idSub": 0,
    "message": "Und das, nachdem ich in Yoshiwara so vermöbelt wurde! Und als es mir besser ging, wurde ich sofort auf eine Mission geschickt!",
  },
  "APK_Main14_Talk_0572:0" => {
