        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 9122,
    "idSub": 0,
    "message": "Die übrigen Dämonen wurden alle getötet und unsere Mission am Natagumo-Berg war beendet.",
  },
  "StoryBattle_0710:0" => {
    "attribute": {
      "data": [
        0,
        9,
