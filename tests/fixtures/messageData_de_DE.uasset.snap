      ],
      "type": "Buffer",
    },
    "id": 10234,
    "idSub": 0,
    "message": "Irres Kratzen: <kcId_kcId_Battle_Skill/>",
  },
  "Tutorial_t_0036:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
