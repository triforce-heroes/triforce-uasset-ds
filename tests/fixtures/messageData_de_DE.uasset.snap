      "type": "Buffer",
    },
    "id": 1316,
    "idSub": 0,
    "message": "Sie ist nicht so gesprächig, aber ich hab gehört, dass sie bildhübsch ist. Mann, ich kann es kaum erwarten, sie kennenzulernen!",
  },
  "APK_Main12_Talk_0172:0" => {
