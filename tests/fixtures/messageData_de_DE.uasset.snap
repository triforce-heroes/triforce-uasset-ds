      ],
      "type": "Buffer",
    },
    "id": 9114,
    "idSub": 0,
    "message": "Wir kannten uns damals nicht besonders gut ...",
  },
  "StoryBattle_0470:0" => {
    "attribute": {
      "data": [
        0,
        9,
        19,
        0,
        0,
        0,
