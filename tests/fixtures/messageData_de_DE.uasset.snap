    "id": 4576,
    "idSub": 1441,
    "message": "Du bist wirklich eine Schande, was? Du bist so nutzlos, dass du nicht mal deine eigene Schwester beschützen kannst.",
  },
  "FamousSaying:1451" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        144,
        0,
        0,
        0,
        85,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1451,
    "message": "Jetzt bist du auf dich allein gestellt, also warum? Warum gibst du nicht auf? Wieso versuchst du so verbissen, mich zu enthaupten?!",
  },
  "FamousSaying:1461" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        145,
        0,
        0,
        0,
        85,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1461,
    "message": "Was war der Grund? So viel zur Verknüpfung von Glück und Pech. Wir kennen nur Tragödien und Schmerz.",
  },
  "FamousSaying:1471" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        146,
        0,
        0,
        0,
        85,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1471,
    "message": "Zusammen kann uns nichts erschüttern. Kälte oder Hunger können uns nichts anhaben. Wir werden immer zusammen sein, versprochen. Ich werde dich nie verlassen! Jetzt hast du keine Angst mehr, oder?",
  },
  "FamousSaying:1481" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        147,
        0,
        0,
        0,
        85,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1481,
    "message": "Zwei sind besser als einer, verstehst du?",
  },
  "FamousSaying:1491" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        148,
        0,
        0,
        0,
        85,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1491,
    "message": "Das ist bitter für dich, oder? Wenn du erkennst, wie schwach du bist. Ihr Menschen seid so niedlich – ihr schaut himmelwärts, wenn ihr trauert. Nur damit eure Tränen nicht zu Boden tropfen.",
  },
  "FamousSaying:1501" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        149,
        0,
        0,
        0,
        85,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1501,
    "message": "Wenn du stirbst, wirst du meine Worte in deinem Kopf hören. Ich werde keine Gnade zeigen, sodass du den Namen Gyūtarō niemals vergisst!",
  },
  "FamousSaying:1511" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        150,
        0,
        0,
        0,
        115,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1511,
    "message": "Du hast echt Nerven, meine Kunst zu zerstören! Meine großartige Schöpfung! Nur ein Banause, der kein Auge für die Schönheit hat, würde so etwas tun!",
  },
  "FamousSaying:1521" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        151,
        0,
        0,
        0,
        115,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1521,
    "message": "Mir wird ganz schwindelig, wenn ich an all die Kunstwerke denke, die ich aus dir erschaffen kann!",
  },
  "FamousSaying:1531" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        152,
        0,
        0,
        0,
        115,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1531,
    "message": "Grrr ... Das gefällt mir ganz und gar nicht! So intensiv habe ich mich noch nie auf eines meiner Werke gestürzt! Ich fühle mich, als wäre ich der schlechtere Künstler!",
  },
  "FamousSaying:1541" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        153,
        0,
        0,
        0,
        115,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1541,
    "message": "Hyo, hyo! Meine Güte, was für eine kindische Beleidigung! Du dachtest doch nicht, dass das reicht, um mich aus der Fassung zu bringen!",
  },
  "FamousSaying:1551" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        154,
        0,
        0,
        0,
        115,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1551,
    "message": "Wie kannst du es wagen, meine Kunst mit deinen verdorbenen Augäpfeln zu bekritteln?",
  },
  "FamousSaying:1561" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        155,
        0,
        0,
        0,
        115,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1561,
    "message": "Was hältst du von meiner gottgleichen Kraft? Was meine Fäuste berühren, verwandelt sich in die schönsten Fische, die du je gesehen hast!",
  },
  "FamousSaying:1571" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        156,
        0,
        0,
        0,
        115,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1571,
    "message": "Diese Geschwindigkeit verstößt gegen die Naturgesetze, meinst du nicht?!",
  },
  "FamousSaying:1581" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        157,
        0,
        0,
        0,
        115,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1581,
    "message": "Du weißt edle Kultur und Eleganz einfach nicht zu schätzen, weil ein Schwachkopf wie du zu arm und dumm ist, sie zu begreifen!",
  },
  "FamousSaying:1591" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        158,
        0,
        0,
        0,
        115,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1591,
    "message": "Ganz zu schweigen von meiner Geschwindigkeit und Beweglichkeit! Mit meinen pulsierenden Schuppen kann ich mich problemlos fortbewegen!",
  },
  "FamousSaying:1601" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        159,
        0,
        0,
        0,
        115,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1601,
    "message": "Erlebe meine unbändige Kraft in ihrer ganzen Herrlichkeit!",
  },
  "FamousSaying:1611" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        160,
        0,
        0,
        0,
        130,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1611,
    "message": "Seit meiner Geburt habe ich nicht ein einziges Mal gelogen! So erbärmlich ich auch bin, niemand hat Mitleid mit mir!",
  },
  "FamousSaying:1621" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        161,
        0,
        0,
        0,
        130,
