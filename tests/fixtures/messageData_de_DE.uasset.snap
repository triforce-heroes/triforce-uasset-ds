      "type": "Buffer",
    },
    "id": 2752,
    "idSub": 0,
    "message": "(„Oh, Zen'itsu-san ... Wie konntest du das nur zulassen? Ich bin so enttäuscht von dir!")",
  },
  "APK_Sub06_Talk_0240:0" => {
