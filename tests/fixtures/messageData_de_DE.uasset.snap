      ],
      "type": "Buffer",
    },
    "id": 9123,
    "idSub": 0,
    "message": "Viele unserer Kameraden wurden verwundet oder getötet, darunter auch die Einheit, die vorausgegangen war. Zen'itsu und Inosuke kamen auch fast ums Leben.",
  },
  "StoryBattle_0720:0" => {
