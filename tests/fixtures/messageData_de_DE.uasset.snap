        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2370,
    "idSub": 0,
    "message": "Es geht das Gerücht um, dass Uzui-sans Frauen ehemalige Shinobi sind.",
  },
  "APK_Main20_Talk_0551:0" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        189,
        22,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2371,
    "idSub": 0,
    "message": "Er hat sie wohl aufgrund der Tradition seines Klans geheiratet. Dort bekommt man drei Frauen, sobald man 15 wird.",
  },
  "APK_Main20_Talk_0552:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        181,
        0,
        0,
        0,
        190,
        22,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2372,
    "idSub": 0,
    "message": "Wie?! Die drei waren Shinobi?! Für mich sehen sie wie ganz normale, hübsche Mädchen aus!",
  },
  "APK_Main20_Talk_0553:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        157,
        0,
        0,
        0,
        189,
        22,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2373,
    "idSub": 0,
    "message": "Die Frauen von Uzui-san sollen im Vergnügungsviertel gemeinsam mit ihm gekämpft haben.",
  },
  "APK_Main20_Talk_0554:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        181,
        0,
        0,
        0,
        190,
        22,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2374,
    "idSub": 0,
    "message": "Woah! Sie sind also nicht nur schön, sondern auch stark! Ich bin so neidisch auf ihn.",
  },
  "APK_Main20_Talk_0560:0" => {
    "attribute": {
      "data": [
        0,
        9,
