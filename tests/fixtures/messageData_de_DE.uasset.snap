    "id": 7931,
    "idSub": 1061,
    "message": "Er war gekommen, um sie zu töten, aber ich versuchte, ihn mit meiner Axt aufzuhalten.",
  },
  "PictureBook_Line:1071" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
