      ],
      "type": "Buffer",
    },
    "id": 2358,
    "idSub": 0,
    "message": "Ich sollte mich ganz auf die Technik der Säulen konzentrieren. Ich will sie nicht enttäuschen!",
  },
  "APK_Main20_Talk_0520:0" => {
    "attribute": {
      "data": [
