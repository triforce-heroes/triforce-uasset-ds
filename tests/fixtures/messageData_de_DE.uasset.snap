        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2365,
    "idSub": 0,
    "message": "Hast du Uzui-san Verbindungskrähe gesehen? Unglaublich, oder?",
  },
  "APK_Main20_Talk_0541:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        234,
