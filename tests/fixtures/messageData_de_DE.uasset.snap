    "id": 7587,
    "idSub": 0,
    "message": "Wirft mithilfe eines Pfeils einen Felsen. Kann durch zweifache Eingabe verlängert werden. Verbraucht 20 % der Technikanzeige.",
  },
  "P1004_V00_C00_SkillInfo_0010:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
