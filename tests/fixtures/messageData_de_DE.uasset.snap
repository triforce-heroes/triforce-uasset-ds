        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4655,
    "idSub": 0,
    "message": "Wir haben es geschafft! Wir haben gewonnen! Ich kann es kaum glauben, dass wir das wirklich durchgestanden haben! Es ist ein Wunder, dass wir alle noch leben!",
  },
  "FamousSaying_0800:0" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        79,
        0,
        0,
        0,
        19,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4656,
    "idSub": 0,
    "message": "„BAM!" Durch meinen ganzen Körper! Meine Gliedmaßen? „BAM!" Mein Geist? „WUSCH!" Und mein Herz hat wie verrückt gepocht! „BADUMM! BADUUM!" Meine Ohren machten „KLINGEL! KLINGEL!" Dann „RIESEL! RIESEL! RIE...SEL!"",
  },
  "FamousSaying_0810:0" => {
