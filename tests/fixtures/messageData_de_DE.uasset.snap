        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 7933,
    "idSub": 0,
    "message": "Nach unserer Mission im Trommelanwesen nahmen Zen'itsu, Inosuke und ich uns etwas Zeit, um uns im Haus der Glyzinie zu erholen.",
  },
  "PictureBook_Line_0030:0" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        78,
        26,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 7934,
    "idSub": 0,
    "message": "Als wir aufbrachen, wünschte uns die alte Dame dort viel Glück, indem sie Funken schlug.",
  },
  "PictureBook_Line_0040:0" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        78,
        26,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 7935,
    "idSub": 0,
    "message": "Die Leute im Haus der Glyzinie unterstützen die Dämonenjäger immer, ohne eine Gegenleistung zu verlangen.",
  },
  "PictureBook_Line_0050:0" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        78,
        26,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 7936,
    "idSub": 0,
    "message": "Sie sind wirklich eine große Hilfe!",
  },
  "PictureBook_Line_0060:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        63,
