        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1041,
    "message": "Gepriesen sei Amitabha-Buddha. Gepriesen sei Amitabha-Buddha.",
  },
  "FamousSaying:1051" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        104,
        0,
        0,
        0,
        35,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1051,
    "message": "Du hast das Felsbrockentraining abgeschlossen. Ich möchte dir auch für deine edlen Aktionen im Dorf ein Lob aussprechen. Du hast meinen Respekt verdient.",
  },
  "FamousSaying:1061" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        105,
        0,
        0,
        0,
        35,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1061,
    "message": "Kein Grund, sich zu schämen. Du bist ein vorbildlicher Schwertkämpfer. Du solltest stolz auf deine tugendhaften Handlungen sein.",
  },
  "FamousSaying:1071" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        106,
        0,
        0,
        0,
        35,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1071,
    "message": "Ein Lebewesen so gewalttätig zu schlagen war die Hölle für mich. Ich werde mein Leben lang nicht vergessen, wie abstoßend sich das angefühlt hat.",
  },
  "FamousSaying:1081" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        107,
        0,
        0,
        0,
        35,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1081,
    "message": "Ich wollte „Danke ... dass du für mich gekämpft hast" von ihr hören. Das hätte gereicht, um mich zu retten. Aber Kinder können nur an sich selbst denken.",
  },
  "FamousSaying:1091" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        108,
        0,
        0,
        0,
        35,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1091,
    "message": "Wenn es darum geht, was vor uns liegt, haben wir alle unsere eigenen Zweifel. Von nun an helfe auch ich dir, wo ich kann ... um dich auf deinem Weg zu begleiten.",
  },
  "FamousSaying:1101" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        109,
        0,
        0,
        0,
        35,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1101,
    "message": "Dein Training hier ist abgeschlossen. Deine Anstrengungen zahlen sich aus.",
  },
  "FamousSaying:1111" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        110,
        0,
        0,
        0,
        193,
        27,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1111,
    "message": "Mir egal! Jetzt verschwinde! Hör auf, mit mir zu reden, als wären wir befreundet!",
  },
  "FamousSaying:1121" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        111,
        0,
        0,
        0,
        193,
        27,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1121,
    "message": "Ich schneide euch eure verdammten Köpfe ab, so oft wie nötig! Verreckt, ihr Dreckschweine!",
  },
  "FamousSaying:1131" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        112,
        0,
        0,
        0,
        193,
        27,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1131,
    "message": "Mein Name ist Shinazugawa Gen'ya. Vergiss das niemals! Denn das ist der Name des Mannes, der dich töten wird!",
  },
  "FamousSaying:1141" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        113,
        0,
        0,
        0,
        193,
        27,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1141,
    "message": "Hör mir genau zu! Ich werde diesen Zunehmenden Dämonenmond ganz alleine besiegen!",
  },
  "FamousSaying:1151" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        114,
        0,
        0,
        0,
        193,
        27,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1151,
    "message": "Ich bin es, der zur Säule ernannt werden wird!",
  },
  "FamousSaying:1161" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        115,
        0,
        0,
        0,
        193,
        27,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1161,
    "message": "Ich kann ihn nicht enthaupten. Du musst es tun! Ausnahmsweise darfst du das übernehmen!",
  },
  "FamousSaying:1171" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        116,
        0,
        0,
        0,
        193,
        27,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1171,
    "message": "Ich bereite dem ein Ende, du sturer Esel!",
  },
  "FamousSaying:1181" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        117,
        0,
        0,
        0,
        193,
        27,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1181,
    "message": "Spiel hier nicht das Opfer! Als könnte ein Zunehmender Dämonenmond je schwach sein! Erzähl keinen Mist!",
  },
  "FamousSaying:1191" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        118,
        0,
        0,
        0,
        193,
        27,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1191,
    "message": "Ich habe sogar Dämonen verspeist ... nur um kämpfen zu können.",
  },
  "FamousSaying:1201" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        119,
        0,
        0,
        0,
        193,
        27,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1201,
    "message": "Tja, Himejima-san ist nicht gerade der beste Lehrer. Du musst ihn beobachten, um es zu lernen.",
  },
  "FamousSaying:1211" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        120,
        0,
        0,
        0,
        244,
        27,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1211,
    "message": "Offensichtlich hast du nichts gelernt. Du hast kein einziges Training gemeistert!",
  },
  "FamousSaying:1221" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        121,
        0,
        0,
        0,
        244,
        27,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1221,
    "message": "Du kannst das! Sei ein Mann! Willst du kein Dämonenjäger sein? Es gibt nur einen Weg, und der führt nach vorn!",
  },
  "FamousSaying:1231" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        122,
        0,
        0,
        0,
        244,
        27,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1231,
    "message": "Sei beruhigt, du brauchst dir keine Sorgen zu machen. Ich bin weitaus mächtiger als du. Ich habe meinen Felsen bereits gespalten!",
  },
  "FamousSaying:1241" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        123,
        0,
        0,
        0,
        244,
        27,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1241,
    "message": "Es hat sechs Monate gedauert ... Aber endlich siehst du aus, als ob du hierhergehörst.",
  },
  "FamousSaying:1251" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        124,
        0,
        0,
        0,
        244,
        27,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1251,
    "message": "Wie es scheint ... wird es nie genug sein.",
  },
  "FamousSaying:1261" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        125,
        0,
        0,
        0,
        244,
        27,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1261,
    "message": "Ich kann nicht sagen, ob er gewinnen oder verlieren wird. Nur eines steht fest.",
  },
  "FamousSaying:1271" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        126,
        0,
        0,
        0,
        244,
        27,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1271,
    "message": "Du bist langsam. Schwach. Und unerfahren. Überhaupt nicht wie ein Dämonenjäger.",
  },
  "FamousSaying:1281" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        127,
        0,
        0,
        0,
        244,
        27,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1281,
    "message": "Wie lange willst du noch auf deinem Hintern sitzen? In Angriffsposition!",
  },
  "FamousSaying:1291" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        128,
        0,
        0,
        0,
        244,
        27,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1291,
    "message": "Das Leben und die Zukunft, die deine Schwester dir durch ihr Opfer ermöglichte ... Das musst du weitergeben, Giyū!",
  },
  "FamousSaying:1301" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        129,
        0,
        0,
        0,
        244,
        27,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1301,
    "message": "Wage es nicht, noch einmal zu sagen, dass du hättest sterben sollen! Beim nächsten Mal war's das mit uns beiden!",
  },
  "FamousSaying:1311" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        130,
        0,
        0,
        0,
        47,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1311,
    "message": "Gerade als ich dachte, du könntest nicht noch mehr nerven. Glücklicherweise erinnere ich mich an nichts von früher!",
  },
  "FamousSaying:1321" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        131,
        0,
        0,
        0,
        47,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1321,
    "message": "Wessen Einkünfte haben diesem Haus wohl ermöglicht, jahrelang zu erblühen, du Hexe?!",
  },
  "FamousSaying:1331" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        132,
        0,
        0,
        0,
        47,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1331,
    "message": "Schöne, mächtige Dämonen wie ich können tun, was sie wollen!",
  },
  "FamousSaying:1341" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        133,
        0,
        0,
        0,
        47,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1341,
    "message": "Ihr Menschen erstaunt mich mit eurer Erbärmlichkeit stets aufs Neue. Wenn du nicht mehr zu bieten hast, tust du mir sogar ein wenig leid.",
  },
  "FamousSaying:1351" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        134,
        0,
        0,
        0,
        47,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1351,
    "message": "Du bist zwar hässlich, aber irgendwie auch niedlich. Langsam wächst du mir richtig ans Herz. Du bist wie ein Mäuschen, das im Sterben liegt!",
  },
  "FamousSaying:1361" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        135,
        0,
        0,
        0,
        47,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1361,
    "message": "So ist das Leben viel besser. Wir müssen keine Nahrung kaufen und werden nicht alt. Wir werden nicht krank und sterben auch nicht. Wir haben nichts zu verlieren.",
  },
  "FamousSaying:1371" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        136,
        0,
        0,
        0,
        47,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1371,
    "message": "Keiner dieser Narren hat den neuen Tag erlebt! Schließlich sind die langen Nächte auf unserer Seite.",
  },
  "FamousSaying:1381" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        137,
        0,
        0,
        0,
        47,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1381,
    "message": "Verreckt! Verreckt! Ihr alle sollt einfach verrecken! Waaaaaah! Er hat meinen Kopf abgetrennt! Er hat meinen Kopf abgetrennt! Hilf mir, Onī-chan!",
  },
  "FamousSaying:1391" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        138,
        0,
        0,
        0,
        47,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1391,
    "message": "Ich fasse es nicht, dass das passiert! Ich will noch nicht sterben! Tu etwas, bitte! Onī-chan!",
  },
  "FamousSaying:1401" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        139,
        0,
        0,
        0,
        47,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1401,
    "message": "Bitte geh nicht! Du kannst nicht! Ich werde dich nicht gehen lassen! Das werde ich nicht! Wir werden immer zusammen sein! Wie oft ich auch wiedergeboren werde, ich werde immer deine Schwester sein.",
  },
  "FamousSaying:1411" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        140,
        0,
        0,
        0,
        85,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1411,
    "message": "Meine liebe Schwester hat ihr Bestes gegeben mit dem bisschen Verstand, den sie hat. Jetzt werde ich ihre Peiniger niedermetzeln.",
  },
  "FamousSaying:1421" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        141,
        0,
        0,
        0,
        85,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1421,
    "message": "Ich glaube fest an Rache. Also werde ich dir genau den Schmerz zufügen, den du ihr zugefügt hast.",
  },
  "FamousSaying:1431" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        142,
        0,
        0,
        0,
        85,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1431,
    "message": "Ihr könnt so viele Helfer beschwören, wie ihr wollt, aber euer Schicksal war leider von Anfang an besiegelt.",
  },
  "FamousSaying:1441" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
