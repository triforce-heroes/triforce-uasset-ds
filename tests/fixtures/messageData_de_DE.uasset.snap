      "type": "Buffer",
    },
    "id": 2975,
    "idSub": 0,
    "message": "Ja ... Du hast ja recht. Schon gut, schon gut, ich werde mich bei ihm ordentlich entschuldigen. Abermals.",
  },
  "APK_Sub13_Talk_0150:0" => {
    "attribute": {
