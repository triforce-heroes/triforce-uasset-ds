      "type": "Buffer",
    },
    "id": 2379,
    "idSub": 0,
    "message": "Was ist los? Hast du dich verirrt? Das Anwesen der Säule des Nebels liegt woanders.",
  },
  "APK_Main20_Talk_0600:0" => {
    "attribute": {
      "data": [
