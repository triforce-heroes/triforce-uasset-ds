        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 9110,
    "idSub": 0,
    "message": "Ich setzte jede mir bekannte Atemtechnik ein ... und irgendwie schaffte ich es, zu gewinnen. Nachdem ich mich von Tamayo-san verabschiedet hatte, machte ich mich auf den Weg zu meinem nächsten Ziel.",
  },
  "StoryBattle_0430:0" => {
    "attribute": {
      "data": [
        0,
        9,
        19,
        0,
        0,
        0,
