    "id": 4657,
    "idSub": 0,
    "message": "Hmm, das zählt aber als Sieg über einen Zunehmenden Dämonenmond, also darf man wohl gratulieren ... obwohl es nur eine Zunehmende Sechs war.",
  },
  "FamousSaying_0820:0" => {
