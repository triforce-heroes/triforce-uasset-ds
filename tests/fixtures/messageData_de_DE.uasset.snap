        0,
      ],
      "type": "Buffer",
    },
    "id": 2958,
    "idSub": 0,
    "message": "Du fragst: „Was ist los?" Ich sage dir, was los ist! Vor ein paar Tagen hatten mein bester Kumpel und ich einen kleinen Streit, weißt du ...",
  },
  "APK_Sub13_Talk_0021:0" => {
    "attribute": {
      "data": [
