      ],
      "type": "Buffer",
    },
    "id": 2360,
    "idSub": 0,
    "message": "Man sagt, nachdem sie uns trainiert haben, bestreiten sie Übungskämpfe untereinander. Das klingt echt hart ...",
  },
  "APK_Main20_Talk_0522:0" => {
    "attribute": {
