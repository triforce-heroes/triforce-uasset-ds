        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10032,
    "idSub": 11,
    "message": "Ranglistenkampf (mit Ausrüstung)",
  },
  "Tutorial_APK2_DLC_text_0040:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10023,
    "idSub": 11,
    "message": "Ein vom Ranglistenkampf unabhängiger Modus. Kämpfe mit Ausrüstung und verdiene Ausrüstungspunkte. Meistere den Umgang mit Ausrüstung und strebe den höchsten Rang an!",
  },
  "Tutorial_APK2_DLC_Title_0050:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
