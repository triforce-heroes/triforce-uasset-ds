      ],
      "type": "Buffer",
    },
    "id": 6109,
    "idSub": 0,
    "message": "Ein vierter, nachfolgender leichter Angriff. Bei einem Treffer wird der Gegner in die Luft geschleudert und du kannst mit einem Verfolgungssprint in der Luft nachsetzen.",
  },
  "NormalAttackInfo_0050:0" => {
    "attribute": {
      "data": [
