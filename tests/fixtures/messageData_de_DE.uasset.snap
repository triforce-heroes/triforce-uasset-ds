        26,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 9120,
    "idSub": 0,
    "message": "Mein Schwert brach, Nezuko wurde gefasst und ich konnte keine Atemtechniken anwenden. Ich war nur noch Augenblicke vom Tod entfernt ... da hörte ich die Stimme meines Vaters.",
  },
  "StoryBattle_0690:0" => {
    "attribute": {
      "data": [
        0,
        9,
        19,
        0,
        0,
        0,
        237,
        4,
