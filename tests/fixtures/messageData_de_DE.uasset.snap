        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4652,
    "idSub": 0,
    "message": "Vielen Dank, Leute! Ich habe es verpatzt, obwohl ich eine Säule bin! Ich schwöre, ich werde meine Kameraden immer beschützen ...",
  },
  "FamousSaying_0770:0" => {
    "attribute": {
