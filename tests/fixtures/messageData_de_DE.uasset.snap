        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2367,
    "idSub": 0,
    "message": "Uzui-san liebt es glanzvoll. Zu seiner Verbindungskrähe würde es also passen.",
  },
  "APK_Main20_Talk_0543:0" => {
    "attribute": {
      "data": [
