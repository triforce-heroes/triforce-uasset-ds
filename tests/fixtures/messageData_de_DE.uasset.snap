        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2378,
    "idSub": 0,
    "message": "Hey. Willst du nicht mit der Säule des Nebels trainieren? Sein Anwesen liegt nicht in dieser Richtung.",
  },
  "APK_Main20_Talk_0571:0" => {
    "attribute": {
      "data": [
