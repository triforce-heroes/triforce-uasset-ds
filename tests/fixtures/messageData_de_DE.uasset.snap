      "type": "Buffer",
    },
    "id": 1342,
    "idSub": 0,
    "message": "Ich habe ein Mädchen gesehen, das dir ähnlich sah, und ich habe dich mit ihr verwechselt. Aber du bist keine Kurtisane, geschweige denn ein Mädchen.",
  },
  "APK_Main12_Talk_0250:0" => {
