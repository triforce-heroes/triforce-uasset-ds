        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 9115,
    "idSub": 0,
    "message": "Aber jetzt sind sie meine engsten Vertrauten. Wenn ich sie nie getroffen hätte, wäre ich nicht da, wo ich heute bin.",
  },
  "StoryBattle_0480:0" => {
    "attribute": {
      "data": [
        0,
        9,
        19,
        0,
