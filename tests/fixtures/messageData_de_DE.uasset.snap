        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 9113,
    "idSub": 0,
    "message": "Bei dieser Mission hatte ich auch das Vergnügen, Zen'itsu und Inosuke kennenzulernen.",
  },
  "StoryBattle_0460:0" => {
    "attribute": {
      "data": [
        0,
        9,
