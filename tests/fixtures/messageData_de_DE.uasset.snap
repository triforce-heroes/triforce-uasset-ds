        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 9121,
    "idSub": 0,
    "message": "Der Kagura-Tanz der Feuergottheit, den mir mein Vater lehrte, rettete mein Leben. Dann erschien Giyū-san, die Säule des Wassers, und das wendete das Blatt.",
  },
  "StoryBattle_0700:0" => {
    "attribute": {
      "data": [
        0,
        9,
        19,
        0,
        0,
        0,
