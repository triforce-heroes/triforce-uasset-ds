        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 9116,
    "idSub": 0,
    "message": "Wir drei machten uns zusammen auf den Weg, um den Natagumo-Berg zu untersuchen, wo viele Dämonenjäger verschwunden waren.",
  },
  "StoryBattle_0490:0" => {
    "attribute": {
      "data": [
        0,
        9,
        19,
        0,
        0,
        0,
        233,
        4,
