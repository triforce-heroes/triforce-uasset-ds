        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2359,
    "idSub": 0,
    "message": "Die Säulen beschützen nicht bloß ganze Regionen, sie müssen auch trainieren und Informationen beschaffen. Die sind gut eingespannt!",
  },
  "APK_Main20_Talk_0521:0" => {
    "attribute": {
      "data": [
