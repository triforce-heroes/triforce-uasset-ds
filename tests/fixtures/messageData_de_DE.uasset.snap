      ],
      "type": "Buffer",
    },
    "id": 2369,
    "idSub": 0,
    "message": "Sogar meine eigene Krähe war beeindruckt. Vielleicht sollte ich ihr ein Halsband kaufen ...",
  },
  "APK_Main20_Talk_0550:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
