        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 7588,
    "idSub": 0,
    "message": "Greift mit einem Pfeil an, der über dem Kopf des Gegners erscheint. Schleudert den Gegner bei Treffer auf den Boden. Kann durch schnelles Ausweichen unterbrochen werden. Verbraucht 20 % der Technikanzeige.",
  },
  "P1004_V00_C00_SkillInfo_0020:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 7589,
    "idSub": 0,
    "message": "Platziert Pfeile in die Luft. Nach einer bestimmten Zeit fliegen diese auf den Gegner zu. Die Pfeile fügen keinen Schaden zu, überraschen den Gegner allerdings. Verbraucht 20 % der Technikanzeige.",
  },
  "P1004_V00_C00_SkillInfo_0030:0" => {
    "attribute": {
      "data": [
