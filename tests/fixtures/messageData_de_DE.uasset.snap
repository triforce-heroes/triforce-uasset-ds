        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 7590,
    "idSub": 0,
    "message": "Feuert einen Pfeil auf den Gegner ab. Schleudert den Gegner bei Treffer in die Luft und dann auf den Boden. Verbraucht 50 % der Dämonenanzeige.",
  },
  "P1004_V00_C00_SkillInfo_0040:0" => {
    "attribute": {
      "data": [
