      ],
      "type": "Buffer",
    },
    "id": 4654,
    "idSub": 0,
    "message": "Als ob ich jemals gegen einen Idioten wie dich verlieren würde! Mach dich lieber auf was gefasst! Denn ich werde alles geben!",
  },
  "FamousSaying_0790:0" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
