      "type": "Buffer",
    },
    "id": 2380,
    "idSub": 0,
    "message": "Wenn die Säulen uns abends nicht trainieren, schieben sie entweder Wache oder trainieren sich gegenseitig.",
  },
  "APK_Main20_Talk_0601:0" => {
    "attribute": {
      "data": [
