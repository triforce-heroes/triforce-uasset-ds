      ],
      "type": "Buffer",
    },
    "id": 7941,
    "idSub": 0,
    "message": "Vater und Mutter bereiteten nach einem Fest immer welche zu.",
  },
  "PictureBook_Line_0110:0" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        78,
        26,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 7942,
    "idSub": 0,
    "message": "Sie haben selbst altes Mochi zerdrückt, um welche daraus zu machen. Unsere ganze Familie hat diese Reiscracker geliebt!",
  },
  "PictureBook_Line_0120:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
