    "id": 366,
    "idSub": 0,
    "message": "Oder gibt es auf dieser Welt keinen Platz für mich, so wie ich bin? Gibt es niemanden, der mich so liebt, wie ich bin?",
  },
  "APK2_BSG01_MemoryFragment_018_0070:0" => {
    "attribute": {
