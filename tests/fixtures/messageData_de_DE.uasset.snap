  "Tutorial_text_0092_00:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10320,
    "idSub": 0,
    "message": "Interagiere mit den leuchtenden Punkten auf der Spielfläche, um Kimetsu-Punkte zu erhalten. Diese können verwendet werden, um Belohnungsfelder freizuschalten. Erkunde jeden Winkel, um so viele Punkte wie möglich zu sammeln!",
  },
  "Tutorial_text_0092_01:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10321,
    "idSub": 0,
    "message": "Kimetsu-Punkte erhältst du nicht nur auf der Spielfläche, sondern verdienst sie dir auch, indem du bestimmte Bedingungen erfüllst, die im Belohnungsmenü aufgelistet sind.

Einige dieser Bedingungen können nur einmal erfüllt werden, doch andere lassen sich wiederholen (diese sind mit <otherId_Icon_Repeat/> markiert). Verdiene dir deine Kimetsu-Punkte also, indem du wiederholbare Bedingungen beliebig oft erfüllst!",
  },
