        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 9111,
    "idSub": 0,
    "message": "Bei meinem nächsten Auftrag musste ich einen Dämon töten, der sich auf einem Anwesen verbarg.",
  },
  "StoryBattle_0440:0" => {
    "attribute": {
      "data": [
        0,
        9,
        19,
        0,
        0,
        0,
        228,
