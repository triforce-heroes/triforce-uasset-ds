    "id": 7958,
    "idSub": 0,
    "message": "Oh! Tempura! Ach, verdammt, wenn ich nur nicht verdeckt ermitteln würde, dann würde das Tempura ganz mir gehören.",
  },
  "PictureBook_Line_0280:0" => {
