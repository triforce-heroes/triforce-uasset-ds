        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1621,
    "message": "Nnngh!",
  },
  "FamousSaying:1631" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        162,
        0,
        0,
        0,
        130,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1631,
    "message": "Hast du nicht ... das geringste Mitleid mit jemandem ... der so jämmerlich ist wie ich?",
  },
  "FamousSaying:1641" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        163,
        0,
        0,
        0,
        130,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1641,
    "message": "Wer gibt dir das Recht, die Schwächeren zu schikanieren?",
  },
  "FamousSaying:1651" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        164,
        0,
        0,
        0,
        140,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1651,
    "message": "Ihr brutalen Unholde, ihr quält die Schwachen ... Ihr seid abscheulich, widerwärtig ... und verachtenswert!",
  },
  "FamousSaying:1661" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        165,
        0,
        0,
        0,
        140,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1661,
    "message": "Was? Hast du ein Problem mit dem, was ich mache, Mistkerl?",
  },
  "FamousSaying:1671" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        166,
        0,
        0,
        0,
        140,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1671,
    "message": "Verdammt seid ihr alle, ihr fiesen Schurken.",
  },
  "FamousSaying:1681" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        167,
        0,
        0,
        0,
        140,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1681,
    "message": "Deine Taten sind einfach abscheulich – das Werk eines wahren Scheusals!",
  },
  "FamousSaying:1691" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        168,
        0,
        0,
        0,
        140,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1691,
    "message": "Ein Mal? Hatte sie das schon immer? Das sieht aus wie ... das Wappen eines Dämons.",
  },
  "FamousSaying:1701" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        169,
        0,
        0,
        0,
        140,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1701,
    "message": "Sei still, du schamloses Flittchen. Nur einer kann mir Befehle erteilen, und das bist nicht du.",
  },
  "FamousSaying:1711" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        170,
        0,
        0,
        0,
        120,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1711,
    "message": "Du kannst mit dieser Puppe trainieren und stärker werden als dieser stumpfe kleine Idiot! Und du hast meine volle Unterstützung!",
  },
  "FamousSaying:1721" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        171,
        0,
        0,
        0,
        120,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1721,
    "message": "Du kannst mich nicht dazu bringen, dir den Schlüssel zu geben! Und ich würde dir auch nicht zeigen, wie man ihn benutzt!",
  },
  "FamousSaying:1731" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        172,
        0,
        0,
        0,
        120,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1731,
    "message": "Ich hätte dich nicht Seetangbirne nennen sollen!",
  },
  "FamousSaying:1741" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        173,
        0,
        0,
        0,
        120,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1741,
    "message": "Sag mir nicht, dass das reicht, um dich zu erledigen. Komm, hör zu! Ich sage es noch mal: Gib nicht auf!",
  },
  "FamousSaying:1751" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        174,
        0,
        0,
        0,
        120,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1751,
    "message": "Und als zusätzliche Motivation gibt es kein Essen, bevor wir fertig sind!",
  },
  "FamousSaying:1761" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        175,
        0,
        0,
        0,
        120,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1761,
    "message": "Mach es! Wenn sie kaputtgeht, dann ... Dann werde ich sie einfach reparieren!",
  },
  "FamousSaying:1771" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        176,
        0,
        0,
        0,
        120,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1771,
    "message": "Für dich gibt es heute auch kein Essen!",
  },
  "FamousSaying:1781" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
