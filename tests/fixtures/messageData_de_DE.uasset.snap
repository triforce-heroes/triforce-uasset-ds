        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2375,
    "idSub": 0,
    "message": "Ich bin eher neidisch darauf, dass er drei Frauen hat.",
  },
  "APK_Main20_Talk_0561:0" => {
    "attribute": {
      "data": [
        0,
        9,
