      "type": "Buffer",
    },
    "id": 7944,
    "idSub": 0,
    "message": "Früher habe ich jeden Tag Holzkohle gebrannt.",
  },
  "PictureBook_Line_0140:0" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
