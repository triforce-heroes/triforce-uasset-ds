        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10033,
    "idSub": 11,
    "message": "Rangpunkte",
  },
  "Tutorial_APK2_DLC_text_0050:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10024,
    "idSub": 11,
    "message": "Dein Rang ändert sich entsprechend der Rangpunkte, die du während der Saison erhältst. Wenn du besiegt wirst, sinken die Punkte, also kann auch dein Rang sinken.",
  },
  "Tutorial_APK2_DLC_text_0050:21" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10024,
    "idSub": 21,
    "message": "Dein Rang wird am Ende der Saison zurückgesetzt. Zeig, was du draufhast, und strebe in dieser und der nächsten Saison einen hohen Rang an!",
  },
  "Tutorial_APK2_DLC_Title_0060:11" => {
