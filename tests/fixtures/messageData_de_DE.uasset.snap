        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 9118,
    "idSub": 0,
    "message": "Das ist keine Bande! Sie sind nicht echt!",
  },
  "StoryBattle_0550:0" => {
    "attribute": {
      "data": [
        0,
        9,
        19,
        0,
        0,
        0,
        235,
        4,
        0,
        0,
        78,
        26,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 9119,
    "idSub": 0,
    "message": "Wir waren ebenbürtig – dachte ich zumindest. Wie sich herausstellte, war der Dämon stärker, als ich gedacht hatte ...",
  },
  "StoryBattle_0570:0" => {
    "attribute": {
      "data": [
        0,
        9,
        19,
        0,
        0,
        0,
        236,
        4,
