    "id": 2974,
    "idSub": 0,
    "message": "Aber ... ihr seid doch beste Kumpels, richtig? Ihr dürft das nicht einfach so stehen lassen.",
  },
  "APK_Sub13_Talk_0140:0" => {
    "attribute": {
