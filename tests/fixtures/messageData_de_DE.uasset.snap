    "id": 365,
    "idSub": 0,
    "message": "Kann ich nichts tun? Gibt es keine Möglichkeit, anderen zu helfen, und mir selbst treu zu bleiben?",
  },
  "APK2_BSG01_MemoryFragment_018_0060:0" => {
    "attribute": {
