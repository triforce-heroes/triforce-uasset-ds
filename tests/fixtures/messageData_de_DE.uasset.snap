        0,
      ],
      "type": "Buffer",
    },
    "id": 2362,
    "idSub": 0,
    "message": "Wir können auf diese Weise trainieren, weil keine Dämonen mehr auftauchen. Allerdings ...",
  },
  "APK_Main20_Talk_0531:0" => {
    "attribute": {
      "data": [
