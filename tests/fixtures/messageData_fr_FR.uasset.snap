        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1271,
    "message": "Tu es lent, faible et inexpérimenté. Ce n'est pas ce que j'appelle un pourfendeur.",
  },
  "FamousSaying:1281" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
