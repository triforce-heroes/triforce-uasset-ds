        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1541,
    "message": "Tu essaies de me provoquer ? Il faudra être plus inventif pour m'atteindre !",
  },
  "FamousSaying:1551" => {
    "attribute": {
      "data": [
        0,
        9,
