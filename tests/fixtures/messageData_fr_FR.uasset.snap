    },
    "id": 10032,
    "idSub": 11,
    "message": "Match classé (avec équipement)",
  },
  "Tutorial_APK2_DLC_text_0040:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10023,
    "idSub": 11,
    "message": "Un mode différent des matchs classés. Choisissez votre équipement et gagnez des points d'équipement. Maîtrisez votre équipement sur le bout des doigts et visez le plus haut rang !",
  },
  "Tutorial_APK2_DLC_Title_0050:11" => {
    "attribute": {
