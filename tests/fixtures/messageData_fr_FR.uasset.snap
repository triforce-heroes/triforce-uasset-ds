      ],
      "type": "Buffer",
    },
    "id": 2426,
    "idSub": 0,
    "message": "Le sabre du pilier de l'amour se déroule comme une corde. Je lui ai demandé comme elle le rengainait.",
  },
  "APK_Main20_Talk_0721:0" => {
    "attribute": {
