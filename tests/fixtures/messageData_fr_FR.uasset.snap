        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1361,
    "message": "La vie est bien plus simple pour un démon. On ne tombe pas malade, on ne meurt pas. On ne peut rien nous dérober.",
  },
  "FamousSaying:1371" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        136,
        0,
        0,
        0,
