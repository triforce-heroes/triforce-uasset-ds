        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 8028,
    "idSub": 0,
    "message": "Oh, des sakura mochi. La friandise préférée de Kanroji, si je me souviens bien.",
  },
  "PictureBook_Line_0980:0" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
        255,
