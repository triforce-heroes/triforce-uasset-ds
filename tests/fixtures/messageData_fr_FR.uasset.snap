      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1611,
    "message": "Pas une fois depuis le jour de ma naissance, je n'ai proféré le moindre mensonge. Mais personne ne m'accorde sa pitié !",
  },
  "FamousSaying:1621" => {
