        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1051,
    "message": "Tu as réussi l'épreuve du rocher. Et j'aimerais aussi te féliciter pour ton attitude au village. Tu as gagné mon respect.",
  },
  "FamousSaying:1061" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        105,
        0,
