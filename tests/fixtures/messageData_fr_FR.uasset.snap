        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1351,
    "message": "C'est adorable ! Même si tu es très laid. Je commence étrangement à m'attacher à toi. Un peu comme à un rat qui s'apprête à mourir.",
  },
  "FamousSaying:1361" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
