        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1301,
    "message": "Ne dis plus jamais que tu aurais dû mourir à sa place ! Sinon notre amitié est terminée !",
  },
  "FamousSaying:1311" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
