    "message": "Match classé",
  },
  "Tutorial_APK2_DLC_text_0020:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10021,
    "idSub": 11,
    "message": "Remportez des combats dans ce mode pour gagner des points de rang et des points d'armée. Les classements sont divisés en saisons d'une durée d'un mois.",
  },
  "Tutorial_APK2_DLC_text_0020:21" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10021,
    "idSub": 21,
    "message": "Vous perdez des points de rang à chaque défaite. En revanche, les points d'armée s'accumulent au fil des saisons et ne diminuent pas en cas de défaite.",
  },
  "Tutorial_APK2_DLC_Title_0030:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10031,
    "idSub": 11,
    "message": "Rang d'armée",
  },
  "Tutorial_APK2_DLC_text_0030:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10022,
    "idSub": 11,
    "message": "Votre rang d'armée augmente selon le total de points d'armée obtenus en gagnant des matchs classés. Visez le rang le plus élevé, celui de pilier !",
  },
  "Tutorial_APK2_DLC_Title_0040:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
