        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1291,
    "message": "Ta sœur a offert sa vie pour la tienne, pour ton avenir. Alors honore-la, Giyû !",
  },
  "FamousSaying:1301" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
