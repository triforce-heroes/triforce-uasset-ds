      "type": "Buffer",
    },
    "id": 2427,
    "idSub": 0,
    "message": "Et là, elle m'a montré. Le sabre a fait comme ça, BAM ! Et puis, comme ça, BIM ! C'était dément !",
  },
  "APK_Main20_Talk_0722:0" => {
