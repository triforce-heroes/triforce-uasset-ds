        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1341,
    "message": "Y a pas à dire, vous êtes pitoyables, les humains. Si c'est vraiment tout ce que vous pouvez faire, vous me feriez presque de la peine.",
  },
  "FamousSaying:1351" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        134,
        0,
        0,
        0,
