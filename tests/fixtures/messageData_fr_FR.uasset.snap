        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1331,
    "message": "Si on possède beauté et puissance, tout nous est permis !",
  },
  "FamousSaying:1341" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
