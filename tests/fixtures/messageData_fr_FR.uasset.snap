      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1211,
    "message": "Tu n'as rien retenu. Et tu n'as certainement rien assimilé !",
  },
  "FamousSaying:1221" => {
    "attribute": {
      "data": [
        0,
        9,
