        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1591,
    "message": "Sans parler de ma vitesse et de ma souplesse incomparable ! Grâce à mes écailles, je me déplace comme je le souhaite.",
  },
  "FamousSaying:1601" => {
    "attribute": {
      "data": [
