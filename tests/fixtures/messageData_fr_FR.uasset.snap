      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1481,
    "message": "Deux valent mieux qu'un, pas vrai ?",
  },
  "FamousSaying:1491" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        148,
        0,
