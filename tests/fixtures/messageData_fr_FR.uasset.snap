        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1371,
    "message": "Personne n'a survécu jusqu'à l'aube face à nous ! La nuit est longue, et c'est nous qu'elle avantage.",
  },
  "FamousSaying:1381" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        137,
        0,
        0,
        0,
        47,
        30,
