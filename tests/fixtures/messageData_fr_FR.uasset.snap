      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1441,
    "message": "Ce que t'es pathétique ! T'as pas réussi à protéger ta sœur !",
  },
  "FamousSaying:1451" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
