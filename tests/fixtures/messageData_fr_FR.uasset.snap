      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1701,
    "message": "Silence, la dépravée. Il n'y a qu'une personne qui peut me donner des ordres, et ce n'est pas toi.",
  },
  "FamousSaying:1711" => {
    "attribute": {
      "data": [
