      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1581,
    "message": "Si tu ne vois pas à quel point je suis cultivé et élégant, c'est parce que tu n'es qu'un miséreux et un inculte !",
  },
  "FamousSaying:1591" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        158,
        0,
        0,
        0,
