        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1711,
    "message": "Tu pourras t'entraîner avec ce mannequin ! Tu as intérêt à devenir plus fort que ce morveux inexpressif !",
  },
  "FamousSaying:1721" => {
    "attribute": {
      "data": [
