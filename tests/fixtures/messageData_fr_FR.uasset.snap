  "Tutorial_text_0084_00:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10309,
    "idSub": 0,
    "message": "Yahaba attaque en tirant des flèches. Celles-ci ne causent aucun dégât, mais peuvent déséquilibrer l'adversaire et donner l'occasion d'enchaîner d'autres attaques.

Vous pouvez aussi infliger des dégâts à votre adversaire en l'envoyant au sol à l'aide de flèches ou en lui jetant des rochers.",
  },
  "Tutorial_text_0088_00:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10313,
    "idSub": 0,
    "message": "Entrer en contact avec du poison provenant d'un adversaire ou d'une flaque au sol vous empoisonne et fait décroître peu à peu votre santé. L'empoisonnement se dissipe au bout d'un certain temps ou si vous changez de personnage, mais il vaut toujours mieux éviter ce désagrément.",
  },
  "Tutorial_text_0089_00:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10314,
    "idSub": 0,
    "message": "Les missions en ligne sont disponibles uniquement pendant une durée limitée. Vous pouvez obtenir des points Kimetsu en relevant des défis pendant que ces missions sont actives.

Missions quotidiennes :
Missions à effectuer tous les jours.

Missions saisonnières :
Missions qui changent selon un calendrier régulier.",
  },
