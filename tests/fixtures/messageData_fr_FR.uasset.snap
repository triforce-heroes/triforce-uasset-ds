      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1121,
    "message": "Je vous couperai la tête autant de fois qu'il le faut ! Disparaissez, vermines !",
  },
  "FamousSaying:1131" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
