        26,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 8027,
    "idSub": 0,
    "message": "J'imagine qu'elle est forte de naissance !",
  },
  "PictureBook_Line_0970:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        63,
        5,
