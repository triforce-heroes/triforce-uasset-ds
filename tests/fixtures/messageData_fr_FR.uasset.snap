        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1471,
    "message": "Ensemble, on est les plus forts. Le froid et la faim, c'est rien pour nous ! Je te promets qu'on restera toujours ensemble. Je t'abandonnerai jamais. Plus rien te fait peur, maintenant, pas vrai ?",
  },
  "FamousSaying:1481" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
