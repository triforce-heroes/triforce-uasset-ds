        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1061,
    "message": "Ne sois pas honteux. Tu es un grand épéiste. Sois fier de tes nobles actions.",
  },
  "FamousSaying:1071" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        106,
        0,
