        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1521,
    "message": "J'ai hâte de créer une œuvre avec ton corps !",
  },
  "FamousSaying:1531" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        152,
        0,
        0,
        0,
        115,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1531,
    "message": "C'est un crime ! Moi-même, je n'ai jamais été absorbé à ce point. En tant qu'artiste, c'est inadmissible qu'il me surpasse !",
  },
  "FamousSaying:1541" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        153,
        0,
        0,
        0,
