      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1111,
    "message": "J'en sais rien ! Dégage ! Arrête de faire comme si on était amis !",
  },
  "FamousSaying:1121" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
