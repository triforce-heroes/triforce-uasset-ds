      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1231,
    "message": "Pour info : je suis plus fort que toi ! Moi, j'ai déjà tranché mon rocher !",
  },
  "FamousSaying:1241" => {
    "attribute": {
