        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1071,
    "message": "Sentir un être se briser sous mes coups était insoutenable. Je n'oublierai jamais le dégoût que ça a provoqué en moi.",
  },
  "FamousSaying:1081" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        107,
        0,
