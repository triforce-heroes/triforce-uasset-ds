        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1411,
    "message": "Mon adorable petite sœur s'est très bien débrouillée malgré son peu de neurones. Ceux qui la respectent pas, je les zigouille tous.",
  },
  "FamousSaying:1421" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        141,
        0,
        0,
        0,
        85,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1421,
    "message": "Je rends toujours la pareille. Si on nous fait du mal, je le rends au centuple.",
  },
  "FamousSaying:1431" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        142,
        0,
        0,
        0,
