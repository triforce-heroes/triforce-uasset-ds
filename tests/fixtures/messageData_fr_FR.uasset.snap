        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10041,
    "idSub": 0,
    "message": "Des objets divers et variés sont dispersés dans plusieurs zones. Vous pouvez même en trouver dans les ruelles et sur les toits.",
  },
  "Tutorial_t_0101:0" => {
    "attribute": {
