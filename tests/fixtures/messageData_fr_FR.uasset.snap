        26,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 8029,
    "idSub": 0,
    "message": "Apparemment, ses cheveux et ses yeux ont changé de couleur tant elle en a mangé.",
  },
  "PictureBook_Line_0990:0" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        78,
        26,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 8030,
    "idSub": 0,
    "message": "Moi aussi, je me défends ! Mais je dois en manger plus encore pour devenir aussi fort que Kanroji.",
  },
  "PictureBook_Line:1001" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        63,
