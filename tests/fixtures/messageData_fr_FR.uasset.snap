        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1501,
    "message": "La mort est une juste compensation. J'ai été agent de recouvrement, après tout.",
  },
  "FamousSaying:1511" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        150,
        0,
        0,
        0,
        115,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1511,
    "message": "Tu as osé casser un de mes pots ! C'était une œuvre d'art, pauvre macaque aveugle !",
  },
  "FamousSaying:1521" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        151,
        0,
        0,
        0,
