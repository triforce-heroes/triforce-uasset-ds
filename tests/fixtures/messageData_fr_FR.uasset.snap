        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1081,
    "message": "J'aurais aimé qu'elle me remercie de m'être battu pour elle. Ces simples paroles m'auraient sauvé. Mais les enfants ont du mal à penser à autre chose qu'à eux-mêmes.",
  },
  "FamousSaying:1091" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
