        47,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1311,
    "message": "Tu as réussi à m'agacer. Par chance, je ne me rappelle rien de ma vie d'avant !",
  },
  "FamousSaying:1321" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        131,
        0,
        0,
        0,
        47,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1321,
    "message": "À ton avis, qui permet à cette maison de prospérer comme elle le fait, morue ?",
  },
  "FamousSaying:1331" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
