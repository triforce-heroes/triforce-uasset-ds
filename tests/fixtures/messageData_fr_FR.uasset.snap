        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1431,
    "message": "Tu peux invoquer tous les sbires que tu veux, son avenir est déjà scellé.",
  },
  "FamousSaying:1441" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        143,
        0,
