      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1131,
    "message": "Mon nom est Shinazugawa Gen'ya, retiens bien ça ! Car c'est moi qui vais te tuer !",
  },
  "FamousSaying:1141" => {
    "attribute": {
      "data": [
