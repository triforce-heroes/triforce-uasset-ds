      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1141,
    "message": "Écoute, morveux ! C'est moi qui éliminerai cette lune supérieure !",
  },
  "FamousSaying:1151" => {
    "attribute": {
      "data": [
