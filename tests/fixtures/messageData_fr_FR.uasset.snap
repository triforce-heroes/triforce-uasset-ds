      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1221,
    "message": "Continue d'avancer si tu es un homme ! Si tu veux devenir un pourfendeur de démons ! Ton seul choix, c'est d'avancer !",
  },
  "FamousSaying:1231" => {
