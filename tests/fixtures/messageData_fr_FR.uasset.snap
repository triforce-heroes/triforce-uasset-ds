        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1381,
    "message": "Meurs ! Tu vas crever ! Avec tous les autres ! Il m'a tranché la tête ! Il a réussi à me décapiter ! Aide-moi, grand frère !",
  },
  "FamousSaying:1391" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        138,
        0,
        0,
        0,
        47,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1391,
    "message": "C'est trop frustrant ! Fais quelque chose, grand frère ! Je veux pas mourir, Gyûtarô !",
  },
  "FamousSaying:1401" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        139,
        0,
        0,
        0,
        47,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1401,
    "message": "Ne pars pas ! Je t'interdis ! Je te laisserai pas ! On restera ensemble ! À chaque réincarnation, je serai toujours ta sœur !",
  },
  "FamousSaying:1411" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        140,
        0,
        0,
