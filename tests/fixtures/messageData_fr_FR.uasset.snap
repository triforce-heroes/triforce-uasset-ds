        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1721,
    "message": "Tu ne peux pas m'obliger à te donner la clé. Quand bien même, je ne te dirai pas comment l'utiliser !",
  },
