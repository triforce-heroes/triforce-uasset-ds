        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1091,
    "message": "Personne ne sait ce que l'avenir nous réserve. Je te prêterai main-forte, afin que tu restes sur le droit chemin.",
  },
  "FamousSaying:1101" => {
    "attribute": {
      "data": [
