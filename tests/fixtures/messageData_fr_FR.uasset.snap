        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 8026,
    "idSub": 0,
    "message": "D'ailleurs, Kanroji a pu porter une pierre de quinze kilos quand elle n'était encore qu'un bébé.",
  },
  "PictureBook_Line_0960:0" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
