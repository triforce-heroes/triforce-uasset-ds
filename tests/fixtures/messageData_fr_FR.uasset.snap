      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1261,
    "message": "Je ne sais pas s'il gagnera ou non aujourd'hui. En tout cas, une chose est sûre.",
  },
  "FamousSaying:1271" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        126,
        0,
