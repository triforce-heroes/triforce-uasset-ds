        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1491,
    "message": "Je sais que t'es frustré par ta fragilité. Les humains se tournent vers le ciel pour se lamenter. Ça vous aide à empêcher vos larmes de couler.",
  },
  "FamousSaying:1501" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        149,
        0,
        0,
        0,
