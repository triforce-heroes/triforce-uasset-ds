        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 248,
    "idSub": 0,
    "message": "Mettete la vostra vita prima della missione! L'ordine di importanza delle vite è chiaro e sgargiante nella mia testa.",
  },
  "APK2_BSG01_MemoryFragment_007_0040:0" => {
    "attribute": {
