        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1431,
    "message": "Puoi chiamare a raccolta tutti i sottoposti che vuoi, ma purtroppo la tua fine era segnata dall'inizio.",
  },
  "FamousSaying:1441" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        143,
        0,
        0,
        0,
        85,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1441,
    "message": "Sei patetico. Non riesci nemmeno a proteggere la tua sorellina!",
  },
  "FamousSaying:1451" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        144,
        0,
        0,
        0,
