    },
    "id": 3402,
    "idSub": 0,
    "message": "Evita un attacco ed effettua una ritirata. Consuma il 100% della barra demoniaca.",
  },
  "NormalAttackInfo_0125:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
