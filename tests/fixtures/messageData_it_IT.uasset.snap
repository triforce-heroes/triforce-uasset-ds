        0,
      ],
      "type": "Buffer",
    },
    "id": 2428,
    "idSub": 0,
    "message": "I pilastri sono davvero incredibili! Non riuscirei mai a muovermi come loro!",
  },
  "APK_Main20_Talk_0800:0" => {
    "attribute": {
      "data": [
