        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2433,
    "idSub": 0,
    "message": "Eh? Sicuro? I pilastri dell'amore e delle serpi sono agli antipodi!",
  },
  "APK_Main20_Talk_0812:0" => {
    "attribute": {
      "data": [
        0,
