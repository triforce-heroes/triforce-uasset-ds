      ],
      "type": "Buffer",
    },
    "id": 2853,
    "idSub": 0,
    "message": "Ultimamente qualcosa sembra preoccupare molto mia sorella. Le ho chiesto se c'è qualche problema, ma mi ha detto che non è nulla...",
  },
  "APK_Sub11_Talk_0050:0" => {
    "attribute": {
