        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 219,
    "idSub": 0,
    "message": "Non sono riuscito a parlare con suo padre, ma ho raccontato i suoi ultimi istanti al fratello minore, Senjuro.",
  },
  "APK2_BSG01_MemoryFragment_002_0030:0" => {
