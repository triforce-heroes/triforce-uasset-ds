      "type": "Buffer",
    },
    "id": 254,
    "idSub": 0,
    "message": "Giovane Kamado... so di essermi comportato male. Ti ringrazio per aver versato lacrime per Kyojuro.",
  },
  "APK2_BSG01_MemoryFragment_008_0030:0" => {
    "attribute": {
