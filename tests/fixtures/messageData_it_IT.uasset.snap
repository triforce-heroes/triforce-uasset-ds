        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 1332,
    "idSub": 0,
    "message": "Ho sentito che Casa Kyogoku vanta una ragazza che sa suonare molto bene lo shamisen. La cosa mi ha incuriosito e sono andato lì.",
  },
  "APK_Main12_Talk_0221:0" => {
    "attribute": {
      "data": [
