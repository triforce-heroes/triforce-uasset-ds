      "type": "Buffer",
    },
    "id": 10236,
    "idSub": 0,
    "message": "Calcio volante: premi <kcId_kcId_Battle_Skill/> mantenendo <kcId_kcId_Battle_Guard/>",
  },
  "Tutorial_Battle_Title_0010:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10151,
    "idSub": 11,
    "message": "Consigli di battaglia per principianti: Inseguimento",
  },
  "Tutorial_Battle_Message_0010:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10131,
    "idSub": 11,
    "message": "Carichi verso l'avversario con un inseguimento. Durante lo scatto, puoi eseguire un Passo rapido, un salto o un attacco qualsiasi. Una volta raggiunto il bersaglio, puoi continuare con un attacco leggero.",
  },
  "Tutorial_Battle_Message_0010:21" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10131,
    "idSub": 21,
    "message": "Puoi annullare un inseguimento con la guardia. Avvicinandoti all'avversario con un inseguimento, i suoi attacchi potrebbero colpirti. Puoi evitarlo annullando l'inseguimento con la guardia, per poi decidere la mossa successiva.",
  },
  "Tutorial_Battle_Title_0020:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10152,
    "idSub": 11,
    "message": "Consigli di battaglia per principianti: Schivare gli attacchi",
  },
  "Tutorial_Battle_Message_0020:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10132,
    "idSub": 11,
    "message": "Usa i passi laterali e l'arretramento per evitare il tracciamento dell'avversario e schivare gli attacchi.",
  },
  "Tutorial_Battle_Message_0020:21" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10132,
    "idSub": 21,
    "message": "Durante il Passo rapido la tua barra abilità smette momentaneamente di caricarsi. Usando troppi Passi rapidi non riuscirai a riempire la barra abilità, quindi schiva con attenzione.",
  },
  "Tutorial_Battle_Title_0030:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10153,
    "idSub": 11,
    "message": "Consigli di battaglia per principianti: Schivata rapida",
  },
  "Tutorial_Battle_Message_0030:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10133,
    "idSub": 11,
    "message": "Puoi interrompere gli attacchi leggeri, gli attacchi aerei e alcune abilità, come le abilità demoniache, con la Schivata rapida (Passo rapido, salto e inseguimento).",
  },
  "Tutorial_Battle_Message_0030:21" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10133,
    "idSub": 21,
    "message": "Anche se all'attivazione consuma una parte della barra abilità, la Schivata rapida può eliminare eventuali aperture sfruttabili dall'avversario. Padroneggiare quest'abilità riduce il rischio di subire gli attacchi nemici.",
  },
  "Tutorial_Battle_Message_0030:31" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10133,
    "idSub": 31,
    "message": "Memorizzando le azioni annullabili con la Schivata rapida, avrai un vantaggio in battaglia. Ricordati di controllare l'elenco comandi del personaggio.",
  },
  "Tutorial_Battle_Title_0040:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10154,
    "idSub": 11,
    "message": "Consigli di battaglia per principianti: Spinta",
  },
  "Tutorial_Battle_Message_0040:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10134,
    "idSub": 11,
    "message": "Usa la spinta per lasciare spazio tra te e gli attacchi dell'avversario. Oltre a subire meno colpi, con la spinta puoi muoverti più rapidamente rispetto a quando sfrutti la guardia per incassare gli attacchi.",
  },
  "Tutorial_Battle_Message_0040:21" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10134,
    "idSub": 21,
    "message": "Inoltre, puoi usare la spinta per agire rapidamente e contrastare l'avversario con abilità e attacchi non parabili.",
  },
  "Tutorial_Battle_Message_0040:31" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10134,
    "idSub": 31,
    "message": "Ricorda che la spinta può non avere effetto in alcune situazioni, come contro i lanci e gli attacchi pesanti.",
  },
  "Tutorial_Battle_Title_0050:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10155,
    "idSub": 11,
    "message": "Consigli di battaglia per principianti: Impeto e Furore",
  },
  "Tutorial_Battle_Message_0050:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10135,
    "idSub": 11,
    "message": "Quando usi Impeto o Furore, la barra abilità, la barra del supporto e la barra demoniaca si caricano. Giocando nei panni di un demone, si recuperano anche i PV.",
  },
  "Tutorial_Battle_Message_0050:21" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10135,
    "idSub": 21,
    "message": "Avere la barra del supporto e la barra demoniaca cariche aumenta le possibilità di sopravvivenza, dal momento che servono entrambe per la fuga d'emergenza.",
  },
  "Tutorial_Battle_Message_0050:31" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10135,
    "idSub": 31,
    "message": "Combattendo imparerai a usare Impeto e Furore per ricaricare più spesso la barra del supporto e la barra demoniaca. Con la pratica, capirai qual è il momento migliore per l'attivazione.",
  },
  "Tutorial_Battle_Title_0060:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10156,
    "idSub": 11,
    "message": "Consigli di battaglia per principianti: Rottura della guardia",
  },
  "Tutorial_Battle_Message_0060:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10136,
    "idSub": 11,
    "message": "Quando usi la guardia contro gli attacchi dell'avversario, la sua integrità si riduce portando eventualmente alla sua rottura. Quando questo accade, non ti restano difese.",
  },
  "Tutorial_Battle_Message_0060:21" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10136,
    "idSub": 21,
    "message": "Sfrutta l'inseguimento per compromettere rapidamente l'integrità della guardia avversaria. Inoltre, mettendo a segno un attacco pesante caricato al massimo provochi subito la rottura della guardia.",
  },
  "Tutorial_Battle_Title_0070:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10157,
    "idSub": 11,
    "message": "Consigli di battaglia per principianti: Attacco aereo (tuffo)",
  },
  "Tutorial_Battle_Message_0070:21" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10137,
    "idSub": 21,
    "message": "Non tutti i personaggi dispongono di questa abilità. Controlla l'elenco dei comandi per assicurarti che quello che hai selezionato possa usarla.",
  },
  "Tutorial_Battle_Title_0080:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10158,
    "idSub": 11,
    "message": "Consigli di battaglia intermedi: Difesa",
  },
  "Tutorial_Battle_Message_0080:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10138,
    "idSub": 11,
    "message": "Dal momento che ogni personaggio ha livelli di difesa differenti, cambiano anche i danni subiti. I personaggi con la difesa più fragile subiscono più danni.",
  },
  "Tutorial_Battle_Message_0080:21" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10138,
    "idSub": 21,
    "message": "Allenati con tutti i personaggi per studiarne i livelli di difesa.",
  },
  "Tutorial_Battle_Title_0090:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10159,
    "idSub": 11,
    "message": "Consigli di battaglia intermedi: Parata",
  },
  "Tutorial_Battle_Message_0090:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10139,
    "idSub": 11,
    "message": "Contrasta gli attacchi dell'avversario con la parata. Usandola con successo, puoi colpire l'avversario. Se fallisci, rischi di subire un contrattacco.",
  },
  "Tutorial_Battle_Message_0090:21" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10139,
    "idSub": 21,
    "message": "Naturalmente, l'avversario si aspetta le parate e non è facile sfruttarle. Osserva attentamente gli attacchi di cui non si può alterare il tempismo. (Ad esempio: le abilità incompatibili con la schivata rapida o le abilità di supporto che non si possono interrompere.)",
  },
  "Tutorial_Battle_Message_0090:31" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10139,
    "idSub": 31,
    "message": "All'attivazione, il tempismo delle abilità di supporto è sempre lo stesso. Osserva attentamente questi attacchi e sincronizza la parata. Una volta imparata questa tecnica, sarai davvero temibile da affrontare.",
  },
  "Tutorial_Battle_Title_0100:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10160,
    "idSub": 11,
    "message": "Consigli di battaglia intermedi: Attacchi pesanti",
  },
  "Tutorial_Battle_Message_0100:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10140,
    "idSub": 11,
    "message": "Gli attacchi pesanti richiedono un tempo di caricamento per attaccare l'avversario. Per questo motivo, consumano sempre una piccola parte della barra abilità. In sostanza, se la barra abilità non è abbastanza carica, anche gli attacchi caricati sono limitati.",
  },
  "Tutorial_Battle_Message_0100:21" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10140,
    "idSub": 21,
    "message": "Assicurati che la barra abilità sia abbastanza carica per poter eseguire un attacco pesante. La barra abilità si consuma solo durante il caricamento e l'esecuzione di un attacco pesante, quindi puoi affidarti agli altri attacchi per incalzare l'avversario.",
  },
  "Tutorial_Battle_Title_0110:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10161,
    "idSub": 11,
    "message": "Consigli di battaglia intermedi: Strategie di lancio",
  },
  "Tutorial_Battle_Message_0110:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10141,
    "idSub": 11,
    "message": "I salti sono efficaci contro i lanci. Evita i lanci saltando quando l'avversario cerca di afferrarti.",
  },
  "Tutorial_Battle_Message_0110:21" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10141,
    "idSub": 21,
    "message": "Se hai difficoltà a trovare il giusto tempismo, prova ad attivare Impeto quando ti aspetti un lancio. Se l'avversario cercherà davvero di lanciarti, lo scaglierai lontano con l'attivazione di Impeto.",
  },
  "Tutorial_Battle_Title_0120:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10162,
    "idSub": 11,
    "message": "Consigli di battaglia intermedi: Attacchi con tracciamento",
  },
  "Tutorial_Battle_Message_0120:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10142,
    "idSub": 11,
    "message": "Alcuni attacchi non si possono schivare con il Passo rapido. Annullano le schivate perché il personaggio è ancorato al bersaglio e scatta per colpirlo.",
  },
  "Tutorial_Battle_Message_0120:21" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10142,
    "idSub": 21,
    "message": "Controlla l'elenco comandi del personaggio per vedere quali attacchi annullano le schivate. Conoscere le caratteristiche degli attacchi aumenta le probabilità di vittoria.",
  },
  "Tutorial_Battle_Title_0130:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10163,
    "idSub": 11,
    "message": "Consigli di battaglia intermedi: Recupero della barra abilità",
  },
  "Tutorial_Battle_Message_0130:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10143,
    "idSub": 11,
    "message": "Anche se la barra abilità si ricarica automaticamente dopo l'uso, il tempo di inizio della ricarica dipende dal tipo di abilità usata.",
  },
  "Tutorial_Battle_Message_0130:21" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10143,
    "idSub": 21,
    "message": "La barra abilità può iniziare a caricarsi subito, o con un lieve ritardo. (Più la barra abilità viene usata, più tempo passa prima dell'inizio della ricarica.)",
  },
  "Tutorial_Battle_Message_0130:31" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10143,
    "idSub": 31,
    "message": "Conoscendo i tempi di partenza e conclusione dei tuoi attacchi e la rispettiva influenza sui tempi di ricarica della barra abilità, puoi annullare il rischio di esaurire la barra abilità nel momento del bisogno. Non dimenticarlo.",
  },
  "Tutorial_Battle_Title_0140:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10164,
    "idSub": 11,
    "message": "Consigli di battaglia intermedi: Barra speciale",
  },
  "Tutorial_Battle_Message_0140:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10144,
    "idSub": 11,
    "message": "La barra speciale si carica attaccando ed eseguendo azioni di vario tipo. Anche l'inseguimento riempie la barra. Le azioni minori e gli attacchi come quelli leggeri o aerei contribuiscono poco al riempimento. Al contrario, le abilità contribuiscono in modo più consistente.",
  },
  "Tutorial_Battle_Message_0140:21" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10144,
    "idSub": 21,
    "message": "La barra speciale si carica facilmente se giochi in modo aggressivo. Non dimenticarlo, mentre combatti.",
  },
  "Tutorial_Battle_Message_0140:31" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10144,
    "idSub": 31,
    "message": "Inoltre, la combinazione di quattro attacchi leggeri (inferiore) carica in modo considerevole la barra speciale. Anche se la combinazione si conclude, è il modo migliore per caricare la barra speciale in caso di necessità.",
  },
  "Tutorial_Battle_Title_0150:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10165,
    "idSub": 11,
    "message": "Consigli di battaglia avanzati: Consigli per le combinazioni 1",
  },
  "Tutorial_Battle_Message_0150:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10145,
    "idSub": 11,
    "message": "Quando esegui una combinazione, i danni inflitti con ogni attacco consecutivo diminuiscono. È l'effetto del sistema di scalabilità dei danni, che riduce in modo predefinito ogni tipo di attacco.",
  },
  "Tutorial_Battle_Message_0150:21" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10145,
    "idSub": 21,
    "message": "La scalabilità dei danni varia in base all'attacco. Prova diverse combinazioni nella Modalità allenamento per capire quali infliggono più danni in totale.",
  },
  "Tutorial_Battle_Title_0160:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10166,
    "idSub": 11,
    "message": "Consigli di battaglia avanzati: Consigli per le combinazioni 2",
  },
  "Tutorial_Battle_Message_0160:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10146,
    "idSub": 11,
    "message": "Quando esegui una combinazione, i danni totali inflitti possono variare in base al primo attacco.",
  },
  "Tutorial_Battle_Message_0160:21" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10146,
    "idSub": 21,
    "message": "Ad esempio, iniziando una combinazione con un attacco aggressivo come un inseguimento, i danni inflitti diminuiscono. (Iniziare una combinazione con attacchi facili da mettere a segno tende a ridurre i danni.)",
  },
  "Tutorial_Battle_Message_0160:31" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10146,
    "idSub": 31,
    "message": "Al contrario, alcune combinazioni aumentano i danni totali inflitti se l'attacco è difficile da portare a segno. Puoi constatare le differenze nella Modalità allenamento.",
  },
  "Tutorial_Battle_Title_0170:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10167,
    "idSub": 11,
    "message": "Consigli di battaglia avanzati: Caratteristiche degli attacchi pesanti 1",
  },
  "Tutorial_Battle_Message_0170:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10147,
    "idSub": 11,
    "message": "Gli attacchi pesanti funzionano in modo diverso, a seconda di quanto vengono caricati. Se un avversario ti colpisce durante l'esecuzione, non sussulti. Tuttavia, questa capacità svanisce prima dell'attacco. Non dimenticarlo.",
  },
  "Tutorial_Battle_Message_0170:21" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10147,
    "idSub": 21,
    "message": "Dal momento che puoi usare la Schivata rapida quando il tuo attacco pesante non è caricato al massimo, anche se l'avversario schiva, puoi pressarlo con un inseguimento dopo la Schivata rapida. L'improvvisazione può essere molto utile per attaccare.",
  },
  "Tutorial_Battle_Message_0170:31" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10147,
    "idSub": 31,
    "message": "Inoltre, poiché non sussulti fino a poco prima dell'attacco, con il giusto tempismo sul colpo dell'avversario puoi far apparire un indicatore di combinazione giallo. Avendo la possibilità di iniziare una combinazione in questo modo, vale la pena tentare.",
  },
  "Tutorial_Battle_Title_0180:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10168,
    "idSub": 11,
    "message": "Consigli di battaglia avanzati: Caratteristiche degli attacchi pesanti 2",
  },
  "Tutorial_Battle_Message_0180:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10148,
    "idSub": 11,
    "message": "Quando carichi del tutto un attacco pesante, non sussulti durante l'attacco. Può essere una carta utile per battere l'avversario. Usala per sferrare il colpo di grazia.",
  },
  "Tutorial_Battle_Message_0180:21" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10148,
    "idSub": 21,
    "message": "Tuttavia, quando è caricato al massimo, l'attacco pesante non si può interrompere con la Schivata rapida. Se l'avversario schiva, quindi, ti esponi abbastanza a lungo da permettergli di approfittarne. L'ideale è usare i colpi caricati al massimo negli scontri ravvicinati, durante i quali è difficile schivare gli attacchi pesanti.",
  },
  "Tutorial_Battle_Message_0180:31" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10148,
    "idSub": 31,
    "message": "Inoltre, quando un attacco pesante caricato al massimo va a segno, annulla il recupero dell'avversario. In questo modo puoi ribaltare le sorti di uno scontro e passare all'attacco.",
  },
  "Tutorial_Battle_Title_0190:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10169,
    "idSub": 11,
    "message": "Consigli di battaglia avanzati: Recupero integrità della guardia",
  },
  "Tutorial_Battle_Message_0190:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10149,
    "idSub": 11,
    "message": "Poco dopo l'uso della guardia contro l'attacco di un avversario, la sua integrità si ripristina.",
  },
  "Tutorial_Battle_Message_0190:21" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10149,
    "idSub": 21,
    "message": "Se cerchi di usare la guardia durante il recupero della sua integrità, il recupero rallenta per l'intera durata della difesa. Se si esegue una spinta, il recupero dell'integrità della guardia si interrompe del tutto.",
  },
  "Tutorial_Battle_Message_0190:31" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10149,
    "idSub": 31,
    "message": "L'abuso della guardia aumenta il rischio della sua rottura. Cerca sempre di avere un'alternativa pronta.",
  },
  "Tutorial_Battle_Title_0200:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10170,
    "idSub": 11,
    "message": "Consigli di battaglia avanzati: Tecniche di Schivata rapida",
  },
  "Tutorial_Battle_Message_0200:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10150,
    "idSub": 11,
    "message": "Quando un giocatore usa un'abilità in corrispondenza con una Schivata rapida, per poi continuare con un inseguimento, l'attivazione di quest'ultimo richiede il consumo della barra abilità. Tuttavia, puoi proseguire con altre abilità che non consumano la barra.",
  },
  "Tutorial_Battle_Message_0200:21" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10150,
    "idSub": 21,
    "message": "Dipende tutto dal tempismo dell'inseguimento dopo l'uso dell'abilità. In altre parole, un inseguimento si può verificare entro la fase finale di un'abilità, diventando parte dell'abilità stessa. Se aspetti che la tecnica vada a segno completando l'esecuzione, non sarà più possibile eseguire l'inseguimento senza consumare la barra abilità.",
  },
  "Tutorial_Battle_Message_0200:31" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10150,
    "idSub": 31,
    "message": "Ricorrendo alle abilità con questa meccanica in mente, puoi eseguire combinazioni con un consumo minore della barra abilità. Impara la meccanica studiando le abilità e le combinazioni in Modalità allenamento, o in altre situazioni.",
  },
  "Tutorial_NoReplace_Message_0010:0" => {
    "attribute": {
      "data": [
