        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2426,
    "idSub": 0,
    "message": "La spada del pilastro dell'amore è simile a una corda. Le ho chiesto come fa a rimetterla nel fodero.",
  },
  "APK_Main20_Talk_0721:0" => {
    "attribute": {
