      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1531,
    "message": "Grrr... Non mi piace per niente. Nemmeno io mi sono mai concentrato a tal punto! Mi sento sconfitto come artista!",
  },
  "FamousSaying:1541" => {
