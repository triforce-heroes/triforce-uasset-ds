        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10235,
    "idSub": 0,
    "message": "Schianto del calcagno: premi <kcId_kcId_Battle_Skill/> mentre usi <kcId_kcId_Battle_Move/>",
  },
  "Tutorial_t_0037:0" => {
    "attribute": {
