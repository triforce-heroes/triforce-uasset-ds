      "type": "Buffer",
    },
    "id": 1334,
    "idSub": 0,
    "message": "Strano, vero? La voce mi era giunta da poco. Non ci credo che non fosse lì.",
  },
  "APK_Main12_Talk_0223:0" => {
    "attribute": {
      "data": [
