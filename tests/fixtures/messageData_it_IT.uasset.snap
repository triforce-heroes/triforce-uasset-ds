      "type": "Buffer",
    },
    "id": 2868,
    "idSub": 0,
    "message": "Qualche giorno fa, ho sentito un rumore fuori dalla mia stanza.",
  },
  "APK_Sub11_Talk_0220:0" => {
    "attribute": {
