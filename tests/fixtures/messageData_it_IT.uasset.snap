      ],
      "type": "Buffer",
    },
    "id": 247,
    "idSub": 0,
    "message": "Voglio che voi tre pensiate alla vostra vita prima di ogni altra cosa. La massima priorità è tornare sane e salve da me.",
  },
  "APK2_BSG01_MemoryFragment_007_0030:0" => {
    "attribute": {
