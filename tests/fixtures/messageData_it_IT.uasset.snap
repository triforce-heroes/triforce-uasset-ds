        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1571,
    "message": "Questa velocità va oltre la logica di questo mondo, non trovi?!?",
  },
  "FamousSaying:1581" => {
