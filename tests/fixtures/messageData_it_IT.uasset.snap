        0,
      ],
      "type": "Buffer",
    },
    "id": 207,
    "idSub": 0,
    "message": "Eliminato Kyojuro, sono tornato dal nobile Muzan per fare rapporto.",
  },
  "APK2_BSG01_MemoryFragment_001_0020:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        1,
        0,
        0,
        0,
        14,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 208,
    "idSub": 0,
    "message": "Come mi avete ordinato, ho ucciso uno dei pilastri, spero che questo vi rassicuri.",
  },
  "APK2_BSG01_MemoryFragment_001_0030:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        2,
        0,
        0,
        0,
        122,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 209,
    "idSub": 0,
    "message": "Non sono tranquillo, perché sembra che tu abbia frainteso le mie parole, Akaza.",
  },
  "APK2_BSG01_MemoryFragment_001_0040:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        3,
        0,
        0,
        0,
        122,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 210,
    "idSub": 0,
    "message": "Vuoi essere lodato? Era una nullità. È cosa ovvia a chiunque che i demoni vincano contro gli umani.",
  },
  "APK2_BSG01_MemoryFragment_001_0050:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        4,
        0,
        0,
        0,
        122,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 211,
    "idSub": 0,
    "message": "Ciò che io bramo è la scomparsa della squadra ammazzademoni. Ammazzateli uno per uno, così che i miei occhi non debbano più posarsi su nessuno di loro!",
  },
  "APK2_BSG01_MemoryFragment_001_0060:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        5,
        0,
        0,
        0,
        122,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 212,
    "idSub": 0,
    "message": "Sei venuto qui per metterti in mostra, fregiandoti dell'uccisione di un pilastro, ma sapevi bene che sul posto erano presenti altri tre ammazzademoni.",
  },
  "APK2_BSG01_MemoryFragment_001_0070:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        6,
        0,
        0,
        0,
        122,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 213,
    "idSub": 0,
    "message": "Perché non li hai finiti come mi sarei aspettato?",
  },
  "APK2_BSG01_MemoryFragment_001_0080:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        7,
        0,
        0,
        0,
        122,
