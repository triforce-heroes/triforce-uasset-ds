      "type": "Buffer",
    },
    "id": 2420,
    "idSub": 0,
    "message": "L'altro giorno, ho visto il pilastro dell'amore al ristorante. Ero senza parole!",
  },
  "APK_Main20_Talk_0711:0" => {
    "attribute": {
      "data": [
