      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1511,
    "message": "Come hai osato colpire la mia arte, la mia splendida creazione! Solo una scimmia che non comprende la bellezza lo farebbe!",
  },
  "FamousSaying:1521" => {
    "attribute": {
      "data": [
