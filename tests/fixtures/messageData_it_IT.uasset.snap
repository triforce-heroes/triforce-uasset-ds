      ],
      "type": "Buffer",
    },
    "id": 218,
    "idSub": 0,
    "message": "Dopo le vicende del treno Mugen, sono andato dalla famiglia del signor Rengoku per riportare le sue ultime parole.",
  },
  "APK2_BSG01_MemoryFragment_002_0020:0" => {
    "attribute": {
      "data": [
