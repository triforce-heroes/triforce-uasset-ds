        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 1333,
    "idSub": 0,
    "message": "Ma una volta sul posto, il personale di Casa Kyogoku mi ha detto che mi ero sbagliato.",
  },
  "APK_Main12_Talk_0222:0" => {
    "attribute": {
      "data": [
