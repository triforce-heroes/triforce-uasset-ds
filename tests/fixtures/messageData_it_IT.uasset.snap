      "type": "Buffer",
    },
    "id": 2870,
    "idSub": 0,
    "message": "Non mi aspettavo alcun regalo e, dopo un momento di spavento, ho sentito dei passi che si allontanavano in fretta.",
  },
  "APK_Sub11_Talk_0250:0" => {
    "attribute": {
