    "id": 252,
    "idSub": 0,
    "message": "Grazie a Kamado e al suo gruppo, noi quattro stiamo tornando a casa... vivi. Quei ragazzi meritano un applauso!",
  },
  "APK2_BSG01_MemoryFragment_008_0010:0" => {
