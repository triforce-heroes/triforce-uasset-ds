      "type": "Buffer",
    },
    "id": 2429,
    "idSub": 0,
    "message": "Sai, l'altro giorno mi chiedevo... A quanto ammonterà la paga di un pilastro?",
  },
  "APK_Main20_Talk_0801:0" => {
    "attribute": {
      "data": [
