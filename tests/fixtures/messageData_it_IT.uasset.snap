        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1311,
    "message": "Proprio quando pensavo che non potessi essere più irritante di così. Non ricordo il passato!",
  },
  "FamousSaying:1321" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        131,
        0,
        0,
        0,
        47,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1321,
    "message": "Secondo te... chi è stato a procurare a questa casa i guadagni necessari per prosperare così, vecchia megera?!?",
  },
  "FamousSaying:1331" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        132,
        0,
        0,
        0,
        47,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1331,
    "message": "I demoni forti e belli possono fare quello che vogliono!",
  },
  "FamousSaying:1341" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        133,
        0,
        0,
        0,
        47,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1341,
    "message": "Patetico, come tutta la vostra razza. Siete così, voi esseri umani. Se questo fosse davvero il massimo che sai fare, forse proverei addirittura pietà per te.",
  },
  "FamousSaying:1351" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        134,
        0,
        0,
        0,
        47,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1351,
    "message": "Che cosa carina, se solo non fossi così ripugnante. Devo ammettere che inizi a piacermi. Sei come un topo chiuso in un vicolo cieco!",
  },
  "FamousSaying:1361" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        135,
        0,
        0,
        0,
        47,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1361,
    "message": "La vita è migliore da demoni. Non dobbiamo comprare il cibo, o invecchiare, o ammalarci, o morire. Non abbiamo nulla da perdere.",
  },
  "FamousSaying:1371" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        136,
        0,
        0,
        0,
        47,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1371,
    "message": "Nessuno di quegli idioti è mai sopravvissuto fino all'alba! Dopotutto, le lunghe notti sono dalla nostra parte.",
  },
  "FamousSaying:1381" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        137,
        0,
        0,
        0,
        47,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1381,
    "message": "Morite! Tutti quanti! Uaaaaah!!! Mi ha tagliato la testa! Mi ha tagliato la testa...! Aiutami, fratellone!",
  },
  "FamousSaying:1391" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        138,
        0,
        0,
        0,
        47,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1391,
    "message": "Mi sento così frustrata! Mi sento frustratissima! Fa' qualcosa, fratellone! Non voglio morire, fratellone!",
  },
  "FamousSaying:1401" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        139,
        0,
        0,
        0,
        47,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1401,
    "message": "Non andare, ti prego! Non puoi! Non ti voglio lasciare! Staremo sempre insieme, io e te! Non importa quante volte rinascerò, io sarò sempre la tua brava sorellina.",
  },
  "FamousSaying:1411" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        140,
        0,
        0,
        0,
        85,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1411,
    "message": "La mia sorellina ha fatto il possibile, con quel cervellino che si ritrova. Ora tocca a me massacrare i suoi aguzzini.",
  },
  "FamousSaying:1421" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        141,
        0,
        0,
        0,
        85,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1421,
    "message": "Credo fermamente nella vendetta. Ti farò provare tutto il dolore che le hai inflitto.",
  },
  "FamousSaying:1431" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        142,
        0,
        0,
        0,
        85,
