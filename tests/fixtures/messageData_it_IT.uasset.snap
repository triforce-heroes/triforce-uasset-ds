      "type": "Buffer",
    },
    "id": 2852,
    "idSub": 0,
    "message": "Cielo, chiedo scusa per il disturbo. È una mera questione di famiglia.",
  },
  "APK_Sub11_Talk_0040:0" => {
    "attribute": {
      "data": [
