      ],
      "type": "Buffer",
    },
    "id": 2427,
    "idSub": 0,
    "message": "Così me l'ha mostrato. La spada ha fatto "sba-BAM!" e poi "ZZZ-bam, BAM"! È stato fantastico!",
  },
  "APK_Main20_Talk_0722:0" => {
    "attribute": {
