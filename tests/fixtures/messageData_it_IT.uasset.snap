      ],
      "type": "Buffer",
    },
    "id": 217,
    "idSub": 0,
    "message": "La prossima volta che ci vedremo, ti farò a pezzi e spappolerò il tuo cervello!",
  },
  "APK2_BSG01_MemoryFragment_002_0010:0" => {
    "attribute": {
