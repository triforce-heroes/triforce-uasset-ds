        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1471,
    "message": "Noi due insieme siamo invincibili. Il freddo e la fame non possono farci nulla. Te lo prometto, staremo sempre insieme. Non ti abbandonerò mai! Vedi? Non abbiamo più nulla da temere, ora.",
  },
  "FamousSaying:1481" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
