      "type": "Buffer",
    },
    "id": 253,
    "idSub": 0,
    "message": "Circa quattro mesi dopo la morte del signor Rengoku, con mia grande sorpresa, ho ricevuto una lettera da suo padre, Shinjuro.",
  },
  "APK2_BSG01_MemoryFragment_008_0020:0" => {
