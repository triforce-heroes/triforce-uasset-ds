      "type": "Buffer",
    },
    "id": 2866,
    "idSub": 0,
    "message": "Sono molto grato per la premura che tutti mi riservano in questa casa. Sarei felice di poter aiutare, se possibile.",
  },
  "APK_Sub11_Talk_0200:0" => {
    "attribute": {
