        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 216,
    "idSub": 0,
    "message": "Dannato moccioso...!",
  },
  "APK2_BSG01_MemoryFragment_001_0110:0" => {
    "attribute": {
      "data": [
