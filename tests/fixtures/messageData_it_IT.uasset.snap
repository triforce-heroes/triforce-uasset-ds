        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2432,
    "idSub": 0,
    "message": "L'altro giorno, ho visto i pilastri dell'amore e delle serpi che mangiavano insieme. Non me lo aspettavo! Immagino che quei due siano in ottimi rapporti.",
  },
  "APK_Main20_Talk_0811:0" => {
    "attribute": {
      "data": [
