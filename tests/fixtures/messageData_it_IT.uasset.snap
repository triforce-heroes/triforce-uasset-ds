      "type": "Buffer",
    },
    "id": 2425,
    "idSub": 0,
    "message": "Anche per me è troppo. Otto porzioni di soba, nove di gyūdon... Bleah!",
  },
  "APK_Main20_Talk_0720:0" => {
    "attribute": {
      "data": [
