      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1561,
    "message": "Allora, che ne pensi di questo potere degno di un dio? Tutto ciò che tocco si trasforma in un bellissimo pesce!",
  },
  "FamousSaying:1571" => {
