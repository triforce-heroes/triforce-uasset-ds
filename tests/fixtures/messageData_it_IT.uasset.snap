        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1501,
    "message": "Mentre muori, le mie parole ti rigireranno in testa. Non avrò alcuna pietà, così non dimenticherai mai il nome Gyutaro!",
  },
  "FamousSaying:1511" => {
    "attribute": {
      "data": [
        0,
        9,
