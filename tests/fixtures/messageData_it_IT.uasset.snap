      "type": "Buffer",
    },
    "id": 2867,
    "idSub": 0,
    "message": "Ah, è così...? Allora perdonami per il disturbo, quando dovresti concentrarti sulla tua missione.",
  },
  "APK_Sub11_Talk_0210:0" => {
    "attribute": {
