      "type": "Buffer",
    },
    "id": 2439,
    "idSub": 0,
    "message": "Il corvo del legame del pilastro dell'amore ha sicuramente un certo fascino!",
  },
  "APK_Main20_Talk_0823:0" => {
    "attribute": {
