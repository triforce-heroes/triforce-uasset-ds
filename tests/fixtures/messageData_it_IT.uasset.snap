    "id": 2430,
    "idSub": 0,
    "message": "Ho sentito che le loro ville non sono male. Scommetto che vengono pagati più di quanto io riesca a immaginare.",
  },
  "APK_Main20_Talk_0802:0" => {
    "attribute": {
      "data": [
