        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1451,
    "message": "(È rimasto solo! Ma allora perché? Perché non si arrende?!? Come fa a non avere alcuna esitazione?!?)",
  },
  "FamousSaying:1461" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
