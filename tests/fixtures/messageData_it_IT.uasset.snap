    "id": 1342,
    "idSub": 0,
    "message": "Ho visto una ragazza identica a te, perciò ti ho scambiato per lei. Tu però non sei una cortigiana, men che meno una ragazza.",
  },
  "APK_Main12_Talk_0250:0" => {
