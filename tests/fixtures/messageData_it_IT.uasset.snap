      ],
      "type": "Buffer",
    },
    "id": 2421,
    "idSub": 0,
    "message": "Perché? Anche i pilastri mangiano, sai?",
  },
  "APK_Main20_Talk_0712:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
