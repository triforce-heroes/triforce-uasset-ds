        0,
      ],
      "type": "Buffer",
    },
    "id": 2438,
    "idSub": 0,
    "message": "Anche il pilastro dell'amore è molto carina! Dato che sono sempre insieme, immagino che il suo corvo abbia preso un po' della sua bellezza.",
  },
  "APK_Main20_Talk_0822:0" => {
    "attribute": {
