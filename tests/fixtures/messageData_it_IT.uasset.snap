      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1491,
    "message": "Ti senti frustrato, vero? Per la tua debolezza, sì... Quando gli umani soffrono, guardano sempre il cielo. Così che non scendano le lacrime, lo so.",
  },
  "FamousSaying:1501" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
