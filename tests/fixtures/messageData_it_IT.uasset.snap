      ],
      "type": "Buffer",
    },
    "id": 2422,
    "idSub": 0,
    "message": "Il fatto è che l'ho vista divorare otto porzioni di soba, nove di gyūdon e sei contorni. E dopo aver finito questi, ha ordinato altro! Era una roba assurda.",
  },
  "APK_Main20_Talk_0713:0" => {
    "attribute": {
