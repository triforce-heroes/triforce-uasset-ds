      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1481,
    "message": "Due è meglio di uno, sai?",
  },
  "FamousSaying:1491" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        148,
        0,
        0,
        0,
