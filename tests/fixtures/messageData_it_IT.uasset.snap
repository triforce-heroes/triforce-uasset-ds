      "type": "Buffer",
    },
    "id": 2869,
    "idSub": 0,
    "message": "Quando ho aperto la porta per controllare... ho trovato fasce e pettini lasciati appena fuori.",
  },
  "APK_Sub11_Talk_0230:0" => {
    "attribute": {
