        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2434,
    "idSub": 0,
    "message": "Ecco perché è stata una sorpresa! Il pilastro dell'amore sembrava così felice... E proprio insieme al pilastro delle serpi!",
  },
  "APK_Main20_Talk_0813:0" => {
