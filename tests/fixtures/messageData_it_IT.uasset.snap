        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1521,
    "message": "Che opera potrei realizzare con te? Non sto più nella pelle!",
  },
  "FamousSaying:1531" => {
    "attribute": {
      "data": [
