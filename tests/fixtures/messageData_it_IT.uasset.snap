    },
    "id": 7783,
    "idSub": 0,
    "message": "Forma sottili lame di sangue per scagliarle contro l'avversario. Infligge veleno. Si può annullare con una Schivata rapida. Consuma il 20% della barra abilità.",
  },
  "P1015_V00_C00_SkillInfo_0010:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 7784,
    "idSub": 0,
    "message": "Attacca con più fendenti dei falcetti. Si aggiunge un colpo extra ripetendo l'input. Infligge veleno. Si può annullare con una Schivata rapida. Consuma il 20% della barra abilità.",
  },
  "P1015_V00_C00_SkillInfo_0020:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 7785,
    "idSub": 0,
    "message": "Attacca l'area circostante con sangue tagliente. Invincibile all'avvio. Infligge veleno. Tieni premuto per estendere la durata. Si può annullare con una Schivata rapida. Consuma il 20% della barra abilità.",
  },
  "P1015_V00_C00_SkillInfo_0030:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 7786,
    "idSub": 0,
    "message": "Avvolgi le braccia con spirali di sangue taglienti e usale per attaccare l'avversario. I colpi dell'avversario subiti mentre attacchi non ti fanno sussultare. Infligge veleno. Consuma il 50% della barra demoniaca.",
  },
  "P1015_V00_C00_SkillInfo_0040:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 7787,
    "idSub": 0,
    "message": "Forma sottili lame di sangue per scagliarle contro l'avversario. Dopo aver percorso una certa distanza in volo, correggeranno la loro traiettoria. Infligge veleno. Consuma il 50% della barra demoniaca.",
  },
  "P1015_V00_C00_SkillInfo_0060:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 7788,
    "idSub": 0,
    "message": "Invincibile all'avvio. Infligge veleno. Consuma una carica speciale all'attivazione e le cariche rimanenti se il colpo va a segno. Più cariche vengono consumate, maggiore sarà il danno inflitto.",
  },
