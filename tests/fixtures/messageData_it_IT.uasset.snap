    "id": 233,
    "idSub": 0,
    "message": "Tu sei più bella di chiunque altro e sei anche la più forte. Finora hai eliminato da sola sette pilastri.",
  },
  "APK2_BSG01_MemoryFragment_005_0070:0" => {
    "attribute": {
