    "id": 4665,
    "idSub": 0,
    "message": "Sono colpevoli di essere deboli, di non imparare nulla, di farmi perdere un sacco di tempo e di farmi arrabbiare.",
  },
  "FamousSaying_0900:0" => {
    "attribute": {
