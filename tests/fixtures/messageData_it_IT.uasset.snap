  "Tutorial_text_0091_00:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10318,
    "idSub": 0,
    "message": "Quando un demone (tranne Nezuko e Scuola Nezuko) attiva Impeto o Furore, la barra abilità e la barra demoniaca si riempiranno al massimo e i PV inizieranno a ripristinarsi. Verranno recuperati più PV con Furore che con Impeto. Tuttavia, effettuare un Passo rapido, una guardia oppure subire un attacco da parte dell'avversario interromperà momentaneamente il processo di cura e ridurrà la quantità curata in totale.",
  },
  "Tutorial_text_0091_01:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10319,
    "idSub": 0,
    "message": "Se stai subendo danni prolungati da veleno o effetti simili, attivare Impeto o Furore rimuoverà quell'effetto. Tuttavia, se subisci l'effetto dopo l'ingresso in stato di Impeto o Furore, il processo di cura verrà interrotto.",
  },
  "Tutorial_title_0091_00:0" => {
