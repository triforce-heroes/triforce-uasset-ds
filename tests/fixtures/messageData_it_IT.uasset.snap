      "type": "Buffer",
    },
    "id": 2431,
    "idSub": 0,
    "message": "La paga di un pilastro... Scommetto che è più di quanto io riesca a immaginare.",
  },
  "APK_Main20_Talk_0810:0" => {
    "attribute": {
