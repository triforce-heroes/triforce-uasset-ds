  "StoryBoard_Message_0010:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9174,
    "idSub": 0,
    "message": "Nel sanguinoso Quartiere dei piaceri, Kamado Tanjiro della squadra ammazzademoni affronta un demone, ed è furioso per il modo in cui gioca con gli esseri umani per puro divertimento.",
  },
  "StoryBoard_Message_0020:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9175,
    "idSub": 0,
    "message": "Andiamo indietro nel tempo. Tanjiro, che sta attraversando l'intero paese, manda una lettera al proprio mentore, Urokodaki. Leggendo le parole scritte con cura da Tanjiro, Urokodaki percepisce una grande determinazione nel proprio allievo.",
  },
  "StoryBoard_Message_0030:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9176,
    "idSub": 0,
    "message": "Tanjiro si trova ai piedi di una montagna, sotto la pioggia battente. Avendo ricevuto l'ordine di sconfiggere il demone che si nasconde nei pressi del tempio montano, si incammina lungo il pendio fangoso.",
  },
  "StoryBoard_Message_0040:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9177,
    "idSub": 0,
    "message": "Tanjiro raggiunge il tempio montano e va a caccia del demone che si aggira nei dintorni. Lui e sua sorella Nezuko affrontano insieme il feroce avversario.",
  },
  "StoryBoard_Message_0050:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9178,
    "idSub": 0,
    "message": "Dopo aver completato la missione di eliminazione del demone, Tanjiro scende dalla montagna al sorgere del sole. Ricorda il passato, quando poteva camminare insieme alla sorella durante il giorno...",
  },
  "StoryBoard_Message_0060:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9179,
    "idSub": 0,
    "message": "Presso la Villa delle farfalle, Uzui Tengen, il pilastro del suono, è in cerca di persone con cui infiltrarsi nel Quartiere dei piaceri. Tanjiro si offre di accompagnarlo insieme a Inosuke e Zen'itsu.",
  },
  "StoryBoard_Message_0070:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9180,
    "idSub": 0,
    "message": "Uzui organizza una riunione strategica prima della missione di infiltrazione nel Quartiere dei piaceri. Così, svela cosa lo spinge a farlo...",
  },
  "StoryBoard_Message_0080:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9181,
    "idSub": 0,
    "message": "Prima di recarsi al Quartiere dei piaceri, Tanjiro ricorda la sua visita alla casa di Rengoku Kyojuro, il pilastro delle fiamme, per riportare il suo messaggio.",
  },
  "StoryBoard_Message_0090:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9182,
    "idSub": 0,
    "message": "Pregno della vanità e del desiderio di uomini e donne, al calare della notte il Quartiere dei piaceri trasuda passione e odio. Lungo le strade affollate camminano Tanjiro e i suoi compagni, travestiti e spaesati.",
  },
  "StoryBoard_Message_0100:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9183,
    "idSub": 0,
    "message": "L'obiettivo dell'infiltrazione nel Quartiere dei piaceri è uno solo: trovare le mogli di Uzui. Tanjiro e gli altri vengono assegnati ognuno a una casa di cortigiane.",
  },
  "StoryBoard_Message_0110:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9184,
    "idSub": 0,
    "message": "Travestito da Inoko, Inosuke vaga all'interno di Casa Ogimoto per indagare. Durante la ricerca, sente uno strano rumore...",
  },
  "StoryBoard_Message_0120:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9185,
    "idSub": 0,
    "message": "Presso Casa Kyogoku, Zen'itsu, travestito da Zenko, si dedica con fervore allo shamisen. Dopo aver ritrovato la calma, sente il pianto di una ragazza con il suo udito finissimo...",
  },
  "StoryBoard_Message_0130:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9186,
    "idSub": 0,
    "message": "Uzui rivela che Zen'itsu è scomparso. Tanjiro e Inosuke percepiscono la presenza sempre più forte di un demone. Lo scontro nel Quartiere dei piaceri si avvicina...",
  },
  "StoryBoard_Message_0140:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9187,
    "idSub": 0,
    "message": "Recandosi da Inosuke presso Ogimoto, Tanjiro percepisce l'odore di un demone feroce, proveniente da Tokito...",
  },
  "StoryBoard_Message_0150:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9188,
    "idSub": 0,
    "message": "Daki, la luna crescente che ha reso il Quartiere dei piaceri la propria riserva di caccia, affronta Tanjiro. Scacciando la paura, l'ammazzademoni prepara la spada.",
  },
  "StoryBoard_Message_0160:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9189,
    "idSub": 0,
    "message": "Andiamo leggermente indietro nel tempo. Aspettando Tanjiro, Inosuke decide di agire per conto proprio e di cercare il passaggio nascosto usato dal demone.",
  },
  "StoryBoard_Message_0170:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9190,
    "idSub": 0,
    "message": "Durante la ricerca di un passaggio segreto, Inosuke trova una grande grotta al di sotto del Quartiere dei piaceri. Lì si nasconde uno strano demone a forma di fascia.",
  },
  "StoryBoard_Message_0180:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9191,
    "idSub": 0,
    "message": "Lo scontro tra Tanjiro e Daki diventa ancora più intenso quando il demone-fascia appare dal suo nido, fondendosi con Daki e rivelandone la forma finale.",
  },
  "StoryBoard_Message_0190:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9192,
    "idSub": 0,
    "message": "Quando Tanjiro raggiunge il limite, Nezuko accorre in suo aiuto. In questo rapido volgere della situazione, arriva anche Uzui. Ma dalla schiena di Daki emerge un nuovo demone...",
  },
  "StoryBoard_Message_0200:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9193,
    "idSub": 0,
    "message": "Uzui e Gyutaro portano avanti uno scontro brutale. Nel frattempo, Tanjiro si allontana dalla battaglia per unirsi a Inosuke e Zen'itsu. Insieme, si affrettano ad aiutare Uzui.",
  },
  "StoryBoard_Message_0210:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9194,
    "idSub": 0,
    "message": "Tanjiro e gli altri uniscono le forze a quelle di Uzui. Si dividono in due gruppi per combattere. Inosuke e Zen'itsu si occupano di Daki, mentre Tanjiro e Uzui affrontano Gyutaro.",
  },
  "StoryBoard_Message_0220:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9195,
    "idSub": 0,
    "message": "Gli ultimi istanti della battaglia mortale tra i demoni e i combattenti si avvicinano. Nonostante le scarse probabilità di vittoria, gli ammazzademoni continuano a lottare. È giunta l'ultima occasione per chiudere lo scontro...",
  },
  "StoryBoard_Message_0230:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9196,
    "idSub": 0,
    "message": "Il sei crescente è stato sconfitto. Quando Ubuyashiki riceve la notizia, la considera un segno di cambiamento nella lunga lotta contro i demoni.",
  },
  "StoryBoard_Message_0240:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9197,
    "idSub": 0,
    "message": "Mentre riposa alla Villa delle farfalle dopo l'intenso scontro al Quartiere dei piaceri, Tanjiro fa un sogno...",
  },
  "StoryBoard_Message_0250:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9198,
    "idSub": 0,
    "message": "Tanjiro chiede il permesso di recarsi al Villaggio dei forgiatori per verificare le condizioni della propria spada, che si è danneggiata nell'ultima battaglia. Tuttavia, prima di ricevere l'autorizzazione ha molto tempo libero...",
  },
  "StoryBoard_Message_0260:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9199,
    "idSub": 0,
    "message": "Mentre Tanjiro si gode un momento di tranquillità, arriva una lettera dal quartier generale della squadra ammazzademoni. È l'atteso permesso per visitare il Villaggio dei forgiatori.",
  },
  "StoryBoard_Message_0270:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9200,
    "idSub": 0,
    "message": "Ottenuto il permesso di visitare il Villaggio dei forgiatori, Tanjiro si mette in viaggio accompagnato da un membro della squadra segreta.",
  },
  "StoryBoard_Message_0280:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9201,
    "idSub": 0,
    "message": "Il Villaggio dei forgiatori è stato abilmente nascosto per evitare le invasioni dei demoni. Di fronte a quel villaggio così unico, Tanjiro rimane a bocca aperta.",
  },
  "StoryBoard_Message_0290:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9202,
    "idSub": 0,
    "message": "Dopo aver salutato Tecchin, il capo del Villaggio dei forgiatori, a Tanjiro vengono mostrati i dintorni, ma poi...",
  },
  "StoryBoard_Message_0300:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9203,
    "idSub": 0,
    "message": "Mentre Tanjiro recupera le forze nel Villaggio dei forgiatori, riceve informazioni interessanti da Kanroji Mitsuri, il pilastro dell'amore...",
  },
  "StoryBoard_Message_0310:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9204,
    "idSub": 0,
    "message": "Durante la ricerca di un'arma segreta, Tanjiro si imbatte in Kotetsu e Tokito Muichiro, il pilastro della nebbia. Con l'intento di vendicarsi di Muichiro, Kotetsu allena Tanjiro usando Yoriichi modello zero.",
  },
  "StoryBoard_Message_0320:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9205,
    "idSub": 0,
    "message": "Dopo l'addestramento con il fantoccio meccanico, Tanjiro e Muichiro parlano negli alloggi di quest'ultimo. All'improvviso, appare un demone. È Hantengu, il quattro crescente.",
  },
  "StoryBoard_Message_0330:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9206,
    "idSub": 0,
    "message": "Karaku, separatosi da Hantengu, attacca Muichiro e lo fa volare nella foresta, dove vede un demone che attacca Kotetsu.",
  },
  "StoryBoard_Message_0340:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9207,
    "idSub": 0,
    "message": "Anche se i demoni hanno quasi distrutto il Villaggio dei forgiatori, Mitsuri arriva per aiutare gli abitanti nel momento del bisogno.",
  },
  "StoryBoard_Message_0350:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9208,
    "idSub": 0,
    "message": "Muichiro recupera la memoria durante lo scontro con Gyokko, il cinque crescente. Ricorda sua madre, suo padre e l'amato fratello maggiore Yuichiro...",
  },
  "StoryBoard_Message_0360:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9209,
    "idSub": 0,
    "message": "Gyokko rivela la sua forma finale e gioca con Muichiro, che resta impassibile dopo aver recuperato i ricordi. Impugnando la spada, mira a tagliare agilmente la testa del demone.",
  },
  "StoryBoard_Message_0370:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9210,
    "idSub": 0,
    "message": "Muichiro decapita Gyokko. Tuttavia, ha raggiunto il limite del suo corpo e perde i sensi. In quel momento, sente le voci della sua famiglia...",
  },
  "StoryBoard_Message_0380:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9211,
    "idSub": 0,
    "message": "Lo scontro tra Hantengu e gli ammazzademoni è estremamente violento. Tanjiro non riesce a tenere testa a Hantengu, che si è diviso in quattro. Colto di sorpresa, Tanjiro viene scagliato nel bosco.",
  },
  "StoryBoard_Message_0390:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9212,
    "idSub": 0,
    "message": "Tanjiro, scagliato violentemente nel bosco, percepisce l'odore di un altro demone. È l'odore di Shinazugawa Genya, un altro membro della squadra ammazzademoni. Anche lui sta affrontando una delle parti di Hantengu.",
  },
  "StoryBoard_Message_0400:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9213,
    "idSub": 0,
    "message": "Tanjiro trova Nezuko sepolta sotto le macerie. Non avendo modo di allontanarsi dal nemico, Nezuko afferra la lama di Tanjiro per creare la katana di sangue esplosivo.",
  },
  "StoryBoard_Message_0410:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9214,
    "idSub": 0,
    "message": "Tanjiro, Nezuko e Genya mettono Hantengu alle strette. Tuttavia, i suoi corpi divisi si fondono in Zohakuten, capovolgendo le sorti dello scontro.",
  },
  "StoryBoard_Message_0420:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9215,
    "idSub": 0,
    "message": "Tanjiro e i suoi alleati sono in svantaggio contro gli attacchi di Zohakuten. Fortunatamente, Mitsuri scende in campo contro Zohakuten. Durante lo scontro, il corpo di Mitsuri inizia a cambiare all'improvviso...",
  },
  "StoryBoard_Message_0430:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9216,
    "idSub": 0,
    "message": "Durante la battaglia, Tanjiro percepisce un'altra forma di Hantengu. Affinando i sensi, trova finalmente il demone. Con l'aiuto dei suoi amici, attacca con la spada...",
  },
  "StoryBoard_Message_0440:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9217,
    "idSub": 0,
    "message": "Hantengu continua a fuggire. Arriva il giorno e il sole sorge. Uccidere il demone o salvare Nezuko? Tanjiro non riesce a decidere.",
  },
  "StoryBoard_Message_0450:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9218,
    "idSub": 0,
    "message": "Dopo una spinta da parte di Nezuko, Tanjiro riesce a sconfiggere Hantengu. Poi piange per il sacrificio della sorella.",
  },
  "StoryBoard_Message_0460:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9219,
    "idSub": 0,
    "message": "Muzan è soddisfatto per ciò che è accaduto nel Villaggio dei forgiatori. Ora che Nezuko non teme più il sole, attorno alla ragazza sta per iniziare una feroce battaglia...",
  },
  "StoryBoard_Message_0470:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9220,
    "idSub": 0,
    "message": "Zen'itsu si reca alla Villa delle farfalle per fare visita a Tanjiro e viene accolto da Nezuko, alla luce del sole.",
  },
  "StoryBoard_Message_0480:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9221,
    "idSub": 0,
    "message": "Zen'itsu dichiara il proprio amore a Nezuko, ormai libera di camminare alla luce del sole. Tuttavia, ricorda il motivo originale della visita alla Villa delle farfalle: incontrare Tanjiro.",
  },
  "StoryBoard_Message_0490:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9222,
    "idSub": 0,
    "message": "Mentre Tanjiro riposa a letto, Zen'itsu parla tranquillamente con lui. Il tempo passa in pace e serenità...",
  },
  "StoryBoard_Message_0500:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9223,
    "idSub": 0,
    "message": "È una notte di luna piena. Shinazugawa Sanemi, pilastro dei venti, e Iguro Obanai, pilastro delle serpi, hanno il compito di indagare su un antico castello. Sembra che il luogo pulluli di demoni...",
  },
  "StoryBoard_Message_0510:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9224,
    "idSub": 0,
    "message": "Nel vecchio castello, Sanemi e Iguro si imbattono in un'orda di nemici. I due pilastri sguainano le spade, percependo qualcosa di inquietante.",
  },
  "StoryBoard_Message_0520:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9225,
    "idSub": 0,
    "message": "Mentre risalgono la torre del castello inseguendo i demoni, i due pilastri si imbattono in una sorpresa. Davanti ai loro occhi si manifesta una strana dimensione alternativa. Sanemi attacca con la spada un demone intento a fuggire in quella dimensione, ma...",
  },
  "StoryBoard_Message_0530:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9226,
    "idSub": 0,
    "message": "I pilastri organizzano una riunione per discutere di quanto accaduto al Villaggio dei forgiatori. Dopo aver commentato la manifestazione dei marchi, viene proposto di organizzare un addestramento dei pilastri, per preparare gli ammazzademoni alla battaglia imminente.",
  },
  "StoryBoard_Message_0540:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9227,
    "idSub": 0,
    "message": "Anche se l'addestramento dei pilastri è già iniziato, Tomioka Giyu, il pilastro dell'acqua, rifiuta di partecipare. Alla fine, cede solo davanti all'insistenza di Tanjiro.",
  },
  "StoryBoard_Message_0550:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9228,
    "idSub": 0,
    "message": "Dopo essersi completamente ripreso dalle ferite, Tanjiro comincia l'addestramento dei pilastri con qualche giorno di ritardo dall'inizio ufficiale. Prima di tutto, affronta l'allenamento di Uzui per migliorare la resistenza fisica.",
  },
  "StoryBoard_Message_0560:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9229,
    "idSub": 0,
    "message": "Dopo l'addestramento di Uzui, Tanjiro si reca alla villa di Muichiro. Grazie all'attenta e precisa guida di Muichiro, Tanjiro riesce a superare l'addestramento per l'agilità.",
  },
  "StoryBoard_Message_0570:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9230,
    "idSub": 0,
    "message": "Tanjiro supera l'addestramento di Muichiro e si reca alla villa di Kanroji. L'allenamento di Mitsuri è pensato per migliorare la flessibilità. Pur sembrando innocua, la ricerca forzata della flessibilità è tremendamente dolorosa...",
  },
  "StoryBoard_Message_0580:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9231,
    "idSub": 0,
    "message": "Tanjiro supera l'addestramento per la flessibilità di Mitsuri e procede verso la villa di Iguro. Seguendo le parole mordaci di Iguro, la tecnica di spada di Tanjiro migliora notevolmente.",
  },
  "StoryBoard_Message_0590:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9232,
    "idSub": 0,
    "message": "Alla villa di Iguro cala la notte. Tanjiro vede Iguro allontanarsi e decide di seguirlo. Arriva in un luogo dove questi si incontra con altri due pilastri...",
  },
  "StoryBoard_Message_0600:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9233,
    "idSub": 0,
    "message": "Dopo aver completato l'addestramento con la spada di Iguro, Tanjiro si reca alla villa di Shinazugawa per la prova successiva...",
  },
  "StoryBoard_Message_0610:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9234,
    "idSub": 0,
    "message": "Tanjiro cerca disperatamente di stare al passo dell'addestramento di Sanemi, mentre gli altri membri della squadra ammazzademoni tremano di paura. Tuttavia, Tanjiro non riesce a fermare gli attacchi incessanti di Sanemi...",
  },
  "StoryBoard_Message_0620:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9235,
    "idSub": 0,
    "message": "Sospeso dall'addestramento con Sanemi, Tanjiro passa ad allenarsi con Himejima Gyomei, il pilastro della roccia. Lì, la maggior parte degli ammazzademoni fa fatica a superare i suoi tre esercizi.",
  },
  "StoryBoard_Message_0630:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9236,
    "idSub": 0,
    "message": "Completato l'addestramento di Himejima, Tanjiro si reca alla villa di Giyu per l'ultimo allenamento.",
  },
  "StoryBoard_Message_0640:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9237,
    "idSub": 0,
    "message": "È l'ultima prova di Tanjiro: uno scontro faccia a faccia con Giyu. Usando ciò che ha appreso durante l'addestramento, Tanjiro scatena tutta la propria forza!",
  },
  "StoryBoard_Message_0650:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9238,
    "idSub": 0,
    "message": "Muzan appare alla villa di Ubuyashiki. Dopo aver ricevuto notizie urgenti, i pilastri si affrettano per intervenire. Attaccano con le spade il loro arcinemico, ma...",
  },
