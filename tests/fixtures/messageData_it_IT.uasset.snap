        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 6118,
    "idSub": 0,
    "message": "All'attivazione ripristina del tutto la barra abilità e la barra demoniaca, e inizia il ripristino della salute. Aumenta la velocità di movimento e la potenza dei colpi e aggiunge un quinto attacco alla combinazione di attacchi normali. Consuma una carica speciale.",
  },
  "NormalAttackInfo_0135:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
