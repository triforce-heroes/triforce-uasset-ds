        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1291,
    "message": "Tua sorella ha sacrificato la sua vita per donartene una. Ti ha donato un futuro! E tu devi portarlo agli altri, Giyu!",
  },
  "FamousSaying:1301" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        129,
        0,
        0,
        0,
        244,
        27,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1301,
    "message": "Non dire mai più che sarebbe stato meglio se fossi morto tu! Provaci e tra noi è finita.",
  },
  "FamousSaying:1311" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        130,
        0,
