  "Tutorial_text_0092_00:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10320,
    "idSub": 0,
    "message": "Interagisci con i punti luminosi sul terreno per ottenere Punti Kimetsu. Questi possono essere usati per sbloccare gruppi di ricompense. Assicurati di esplorare ogni anfratto per raccoglierne quanti più possibile!",
  },
  "Tutorial_text_0092_01:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10321,
    "idSub": 0,
    "message": "Oltre a trovarli sul campo, puoi ottenere Punti Kimetsu anche completando certe condizioni elencate nel menu Ricompense.

È possibile completare alcune di queste condizioni solo una volta, mentre altre sono ripetibili (segnalate con <otherId_Icon_Repeat/>). Puoi ottenere Punti Kimetsu completando quelle ripetibili quante volte vuoi.",
  },
