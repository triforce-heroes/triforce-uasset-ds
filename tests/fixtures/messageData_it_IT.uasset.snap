      ],
      "type": "Buffer",
    },
    "id": 2441,
    "idSub": 0,
    "message": "Ah, non sto più nella pelle per l'addestramento del pilastro dell'amore! E se le nostre mani si toccassero per sbaglio?!?",
  },
  "APK_Main20_Talk_0831:0" => {
