      "type": "Buffer",
    },
    "id": 2437,
    "idSub": 0,
    "message": "Non pensi che il corvo del legame del pilastro dell'amore sia affascinante?",
  },
  "APK_Main20_Talk_0821:0" => {
    "attribute": {
      "data": [
