    "id": 2419,
    "idSub": 0,
    "message": "La signorina Kanroji non si è mai lamentata durante l'addestramento con il signor Rengoku. È una donna incredibile.",
  },
  "APK_Main20_Talk_0710:0" => {
    "attribute": {
