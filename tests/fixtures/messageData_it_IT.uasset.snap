      ],
      "type": "Buffer",
    },
    "id": 2862,
    "idSub": 0,
    "message": "Buonasera, signorina. È lei la sorella del capo?",
  },
  "APK_Sub11_Talk_0150:0" => {
    "attribute": {
      "data": [
