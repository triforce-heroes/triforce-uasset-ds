        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 215,
    "idSub": 0,
    "message": "Hai perfino ricevuto un colpo da uno spadaccino privo del rango di pilastro. Il tre crescente è miserabilmente caduto in basso.",
  },
  "APK2_BSG01_MemoryFragment_001_0100:0" => {
    "attribute": {
      "data": [
