      ],
      "type": "Buffer",
    },
    "id": 232,
    "idSub": 0,
    "message": "Io ripongo grandi aspettative in te.",
  },
  "APK2_BSG01_MemoryFragment_005_0060:0" => {
    "attribute": {
      "data": [
