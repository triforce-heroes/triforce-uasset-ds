    "id": 250,
    "idSub": 0,
    "message": "Naturalmente, in quanto ammazzademoni intendo proteggere anche le scialbe esistenze dei cittadini.",
  },
  "APK2_BSG01_MemoryFragment_007_0060:0" => {
    "attribute": {
