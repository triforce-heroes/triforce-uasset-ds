        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1461,
    "message": "Perché? La fortuna, prima o poi, gira per tutti, no? Perché, tra una cosa e l'altra, a noi non succede mai niente di bello?",
  },
  "FamousSaying:1471" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        146,
        0,
        0,
        0,
        85,
        30,
