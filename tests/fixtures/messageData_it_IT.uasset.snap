    "id": 10237,
    "idSub": 0,
    "message": "Attacco pesante: premi <kcId_kcId_Battle_Dash/> mantenendo <kcId_kcId_Battle_Guard/>",
  },
  "Tutorial_t_0035:0" => {
    "attribute": {
