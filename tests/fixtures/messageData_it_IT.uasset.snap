      ],
      "type": "Buffer",
    },
    "id": 7931,
    "idSub": 1051,
    "message": "Ho incontrato Giyu poco dopo che Nezuko era diventata un demone.",
  },
  "PictureBook_Line:1061" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
        255,
