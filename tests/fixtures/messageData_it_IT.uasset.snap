        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 214,
    "idSub": 0,
    "message": "Mi hai profondamente deluso.",
  },
  "APK2_BSG01_MemoryFragment_001_0090:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        8,
        0,
        0,
        0,
        122,
