    "id": 7931,
    "idSub": 1011,
    "message": "Le nostre uniformi sono realizzate con una fibra speciale che risulta molto comoda, resiste all'umidità ed è difficile da bruciare.",
  },
  "PictureBook_Line:1021" => {
    "attribute": {
