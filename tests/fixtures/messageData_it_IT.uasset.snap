      ],
      "type": "Buffer",
    },
    "id": 249,
    "idSub": 0,
    "message": "Prima di ogni cosa, voi tre. Poi, i civili che saranno coinvolti... E infine, il sottoscritto.",
  },
  "APK2_BSG01_MemoryFragment_007_0050:0" => {
