    "id": 8030,
    "idSub": 0,
    "message": "Ma io non sono da meno! Devo mangiarne di più così potrò diventare più forte, come la signorina Kanroji!",
  },
  "PictureBook_Line:1001" => {
    "attribute": {
      "data": [
