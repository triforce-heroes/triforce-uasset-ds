        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2330,
    "idSub": 1914,
    "message": "I'm not the person you should be complaining to! Tell it to the Hashira who came up with this twisted training!",
  },
  "APK_Main20_Talk:1915" => {
    "attribute": {
      "data": [
        0,
        9,
