        0,
        0,
        230,
        22,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 327,
    "idSub": 0,
    "message": "The only kind of people who can help others are those chosen to do so!",
  },
  "APK2_BSG01_MemoryFragment_014_0080:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
