        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 217,
    "idSub": 0,
    "message": "The next time we meet, I'm going to enjoy bashing in your brains!",
  },
  "APK2_BSG01_MemoryFragment_002_0010:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        11,
