        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 246,
    "idSub": 0,
    "message": "Nothing in this world is more important to me than the lives of my dear wives. I even told them as much long ago.",
  },
  "APK2_BSG01_MemoryFragment_007_0020:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
