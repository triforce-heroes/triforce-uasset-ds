        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 380,
    "idSub": 0,
    "message": "I've had a blind masseur at this court before. However, unlike you, he would face the wall until I started speaking.",
  },
  "APK2_BSG01_MemoryFragment_019_0060:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
