      ],
      "type": "Buffer",
    },
    "id": 429,
    "idSub": 0,
    "message": "Soon, both Nezuko and Ubuyashiki will run out of places to hide.",
  },
  "APK2_BSG01_MemoryFragment_023_0090:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
