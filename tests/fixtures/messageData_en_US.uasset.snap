      "type": "Buffer",
    },
    "id": 266,
    "idSub": 0,
    "message": "I was hideous and utterly disgusting.",
  },
  "APK2_BSG01_MemoryFragment_009_0030:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        60,
        0,
        0,
        0,
        49,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 267,
    "idSub": 0,
    "message": "In the Entertainment District, where beauty was the measure of your value, I was treated like a monster.",
  },
  "APK2_BSG01_MemoryFragment_009_0040:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        61,
        0,
        0,
        0,
        49,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 268,
    "idSub": 0,
    "message": "But soon my world began to change... after Ume was born.",
  },
  "APK2_BSG01_MemoryFragment_009_0050:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        62,
        0,
        0,
        0,
        49,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 269,
    "idSub": 0,
    "message": "Because I had such a gorgeous sister, my sense of inferiority had washed away as well.",
  },
  "APK2_BSG01_MemoryFragment_009_0060:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        63,
        0,
        0,
        0,
        49,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 270,
    "idSub": 0,
    "message": "Call it wishful thinking, but I had this feeling we were on the fast track to a better life.",
  },
  "APK2_BSG01_MemoryFragment_009_0070:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        64,
        0,
        0,
        0,
        49,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 271,
    "idSub": 0,
    "message": "Until Ume turned thirteen...",
  },
  "APK2_BSG01_MemoryFragment_009_0080:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        65,
        0,
        0,
        0,
        49,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 272,
    "idSub": 0,
    "message": "She stabbed a client in the eye with a hairpin in self-defense. When news got out it was a samurai, she was bound and burned alive.",
  },
  "APK2_BSG01_MemoryFragment_009_0090:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        66,
        0,
        0,
        0,
        49,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 273,
    "idSub": 0,
    "message": "I wasn't there. By the time I got home from work, she was already burnt to a crisp.",
  },
  "APK2_BSG01_MemoryFragment_009_0100:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        67,
        0,
        0,
        0,
        49,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 274,
    "idSub": 0,
    "message": "Nobody helped us. They never have, and they never will.",
  },
  "APK2_BSG01_MemoryFragment_009_0110:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        68,
        0,
        0,
        0,
        49,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 275,
    "idSub": 0,
    "message": "I have no regrets about becoming a demon. I'd do it again, however many times I'm reborn.",
  },
  "APK2_BSG01_MemoryFragment_009_0120:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        69,
        0,
        0,
        0,
        49,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 276,
    "idSub": 0,
    "message": "But, Ume... You're different. You could have walked a different path.",
  },
  "APK2_BSG01_MemoryFragment_009_0130:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        70,
        0,
        0,
        0,
        49,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 277,
    "idSub": 0,
    "message": "The one and only regret I ever had in life... was you.",
  },
  "APK2_BSG01_MemoryFragment_010_0010:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        71,
        0,
        0,
        0,
        49,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 278,
    "idSub": 0,
    "message": "While I was in the darkness, I realized Ume was right next to me.",
  },
  "APK2_BSG01_MemoryFragment_010_0020:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        72,
        0,
        0,
        0,
        49,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 279,
    "idSub": 0,
    "message": "Ume, you don't have to follow me around anymore.",
  },
  "APK2_BSG01_MemoryFragment_010_0030:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        73,
        0,
        0,
        0,
        47,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 280,
    "idSub": 0,
    "message": "Wh-Why? Wait, hold on, I—",
  },
  "APK2_BSG01_MemoryFragment_010_0040:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        74,
        0,
        0,
        0,
        49,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 281,
    "idSub": 0,
    "message": "You're not my sister anymore. It's time we say goodbye. I'll go this way—you walk towards the light.",
  },
  "APK2_BSG01_MemoryFragment_010_0050:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        75,
