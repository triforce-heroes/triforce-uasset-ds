        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1451,
    "message": "Now you're alone, so why? Why won't you give up!? Why're you so damn determined to decapitate me!?",
  },
  "FamousSaying:1461" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        145,
