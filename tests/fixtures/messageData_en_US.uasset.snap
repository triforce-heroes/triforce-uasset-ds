      "type": "Buffer",
    },
    "id": 256,
    "idSub": 0,
    "message": "Even after I abandoned my post as his instructor, he continued to study the Guide to Flame Breathing and became a Hashira.",
  },
  "APK2_BSG01_MemoryFragment_008_0050:0" => {
    "attribute": {
      "data": [
