        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2330,
    "idSub": 1912,
    "message": "Hey, it's not like I want to hit people! Besides, I don't want to hear that from someone who was tied up!",
  },
  "APK_Main20_Talk:1913" => {
    "attribute": {
      "data": [
