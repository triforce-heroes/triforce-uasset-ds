        71,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 393,
    "idSub": 0,
    "message": "Being forced to lie low during the day was nothing short of humiliating. I had reached my boiling point.",
  },
  "APK2_BSG01_MemoryFragment_020_0090:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
