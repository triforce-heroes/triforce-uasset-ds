        0,
        0,
        0,
        238,
        26,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 219,
    "idSub": 0,
    "message": "Although I couldn't speak with his father, I told his younger brother Senjuro how he met his end.",
  },
  "APK2_BSG01_MemoryFragment_002_0030:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
