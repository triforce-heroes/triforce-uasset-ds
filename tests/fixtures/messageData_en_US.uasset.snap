    "id": 422,
    "idSub": 0,
    "message": "After making Nakime into an Upper Rank, I had her search for the girl who had conquered the sun.",
  },
  "APK2_BSG01_MemoryFragment_023_0020:0" => {
    "attribute": {
      "data": [
