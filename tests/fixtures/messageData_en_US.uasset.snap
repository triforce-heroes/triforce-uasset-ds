        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1591,
    "message": "Not to mention my speed and unparalleled flexibility! Plus, my scales allow me to move without restraint!",
  },
  "FamousSaying:1601" => {
    "attribute": {
      "data": [
        0,
        9,
