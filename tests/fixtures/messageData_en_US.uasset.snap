        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2724,
    "idSub": 5161,
    "message": "...You did the right thing—coming to me. Slaying demons is just too much for you to handle.",
  },
  "APK_Sub05_Talk:5171" => {
