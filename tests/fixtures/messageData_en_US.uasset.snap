        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 8168,
    "idSub": 0,
    "message": "After our mission at the Drum Mansion, Zenitsu, Inosuke, and I took some time to recuperate at the Wisteria House.",
  },
  "PictureBook_Line_0030:0" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
