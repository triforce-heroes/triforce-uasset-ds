        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 8169,
    "idSub": 0,
    "message": "When we left, the old lady there wished us good luck by striking sparks.",
  },
  "PictureBook_Line_0040:0" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
