        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 488,
    "idSub": 0,
    "message": "How anxious you must be because you can't seem to remember anything...",
  },
  "APK2_BSG01_MemoryFragment_033_0050:0" => {
    "attribute": {
      "data": [
        0,
        9,
