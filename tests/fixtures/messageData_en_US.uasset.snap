      ],
      "type": "Buffer",
    },
    "id": 238,
    "idSub": 0,
    "message": "Lord Tengen, please forgive me...",
  },
  "APK2_BSG01_MemoryFragment_006_0040:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
