        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 360,
    "idSub": 0,
    "message": "I'm sorry I said such awful things to you, Brother...",
  },
  "APK2_BSG01_MemoryFragment_020_0010:0" => {
    "attribute": {
