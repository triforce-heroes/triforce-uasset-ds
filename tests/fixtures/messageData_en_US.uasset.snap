    "id": 10567,
    "idSub": 0,
    "message": "Interact with glowing spots on the field to get Kimetsu Points. These can be used to unlock reward panels. Be sure to explore every nook and cranny to collect as many as you can!",
  },
  "Tutorial_text_0092_01:0" => {
