        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10268,
    "idSub": 21,
    "message": "Rank Points will decrease upon defeat. Corps Points will accumulate over the seasons and will not be lost when losing matches.",
  },
  "Tutorial_APK2_DLC_Title_0030:11" => {
