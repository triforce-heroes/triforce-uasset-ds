      ],
      "type": "Buffer",
    },
    "id": 249,
    "idSub": 0,
    "message": "First, prioritize your own lives. Then, second, those of law-abiding civilians... And, lastly, my own.",
  },
  "APK2_BSG01_MemoryFragment_007_0050:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
