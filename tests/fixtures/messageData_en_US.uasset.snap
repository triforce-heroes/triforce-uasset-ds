      "type": "Buffer",
    },
    "id": 4721,
    "idSub": 0,
    "message": "Activates when you have less HP than the opponent. <color_2830ffff>The rate at which the special gauge fills will increase</>. This effect ends once you have more HP than the opponent.",
  },
  "Equipment_Text_0300:0" => {
