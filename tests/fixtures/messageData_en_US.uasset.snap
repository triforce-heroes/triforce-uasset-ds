        0,
        0,
        240,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 448,
    "idSub": 0,
    "message": "Had the master not intervened, I would have been executed. Because of what happened, I grew distrustful of those around me.",
  },
  "APK2_BSG01_MemoryFragment_025_0110:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
