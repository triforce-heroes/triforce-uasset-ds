        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10333,
    "idSub": 0,
    "message": "Activate an Ultimate Art to deal a large amount of damage by using one of your stocked special bars.",
  },
  "Tutorial_APK2_text_0061_01:0" => {
    "attribute": {
      "data": [
