        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2330,
    "idSub": 1902,
    "message": "A crow wearing a pink headpiece showed up with a letter. Once he read it, he completely changed.",
  },
  "APK_Main20_Talk:1903" => {
    "attribute": {
