        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10335,
    "idSub": 0,
    "message": "If you find an item in an area that relates to a memory of Tanjiro or others, it'll be registered in the Hinokami Records. View the memory associated with that item there.",
  },
  "Tutorial_APK2_text_0063_00:0" => {
