      ],
      "type": "Buffer",
    },
    "id": 261,
    "idSub": 0,
    "message": "It's a burn mark I got from the time I protected my younger brother from a falling brazier.",
  },
  "APK2_BSG01_MemoryFragment_008_0100:0" => {
    "attribute": {
      "data": [
