        0,
      ],
      "type": "Buffer",
    },
    "id": 303,
    "idSub": 0,
    "message": "In the two months I was rendered unconscious after defeating Upper Six of the Twelve Kizuki, I had a dream...",
  },
  "APK2_BSG01_MemoryFragment_012_0020:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
