      ],
      "type": "Buffer",
    },
    "id": 386,
    "idSub": 0,
    "message": "Back then, during what became known as the Heian period...",
  },
  "APK2_BSG01_MemoryFragment_020_0020:0" => {
    "attribute": {
      "data": [
