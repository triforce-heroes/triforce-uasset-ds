        181,
        23,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 304,
    "idSub": 0,
    "message": "Sumiyoshi, those who have mastered their skill all share the same fate.",
  },
  "APK2_BSG01_MemoryFragment_012_0030:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        98,
        0,
        0,
        0,
        181,
        23,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 305,
    "idSub": 0,
    "message": "You seem to think of me as some extraordinary person, but that couldn't be any farther from the truth.",
  },
  "APK2_BSG01_MemoryFragment_012_0040:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        99,
