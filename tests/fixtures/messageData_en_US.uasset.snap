  "StoryBoard_Message_0010:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9409,
    "idSub": 0,
    "message": "In the blood-soaked Entertainment District, Tanjiro Kamado of the Demon Slayer Corps confronts a demon, enraged by how she toys with humans for her own amusement.",
  },
  "StoryBoard_Message_0020:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9410,
    "idSub": 0,
    "message": "We go back in time. Tanjiro, who has been traveling throughout the country, sends a letter to his mentor, Urokodaki. As he reads Tanjiro's carefully written words, Urokodaki senses a fierce resolve within his student.",
  },
  "StoryBoard_Message_0030:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9411,
    "idSub": 0,
    "message": "Tanjiro stands at the foot of a mountain in the pouring rain. Ordered to defeat the demon who lurks around the mountain temple, he makes his way up the muddy incline.",
  },
  "StoryBoard_Message_0040:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9412,
    "idSub": 0,
    "message": "Tanjiro arrives at the mountain temple and seeks out the demon lurking there. He and his sister Nezuko take on the ferocious demon together.",
  },
  "StoryBoard_Message_0050:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9413,
    "idSub": 0,
    "message": "Having succeeded in his mission to kill the demon, Tanjiro descends the mountain as the sun rises. He reminisces about the past—when he was able to walk under the sun with his sister...",
  },
  "StoryBoard_Message_0060:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9414,
    "idSub": 0,
    "message": "At the Butterfly Mansion, Tengen Uzui, the Sound Hashira, is looking for recruits to join his mission to infiltrate the Entertainment district. Tanjiro suggests that he, Inosuke, and Zenitsu accompany him.",
  },
  "StoryBoard_Message_0070:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9415,
    "idSub": 0,
    "message": "Uzui holds a strategy meeting before they undergo their mission to infiltrate the Entertainment District. His motive is then revealed...",
  },
  "StoryBoard_Message_0080:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9416,
    "idSub": 0,
    "message": "Before heading to the Entertainment District, Tanjiro reminisces about the time he visited the childhood home of Kyojuro Rengoku, the Flame Hashira, to deliver his message.",
  },
  "StoryBoard_Message_0090:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9417,
    "idSub": 0,
    "message": "Fraught with the vanity and desire of men and women, the Entertainment District surges with passion and hatred once night falls. Trekking down the bustling streets are Tanjiro and company, disguised yet out of place.",
  },
  "StoryBoard_Message_0100:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9418,
    "idSub": 0,
    "message": "There is only one goal to infiltrating the Entertainment District: find Uzui's wives. Tanjiro and the others are each assigned a courtesan house to join.",
  },
  "StoryBoard_Message_0110:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9419,
    "idSub": 0,
    "message": "Disguised as Inoko, Inosuke walks around House Ogimoto to investigate. While doing so, he hears a strange rumor...",
  },
  "StoryBoard_Message_0120:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9420,
    "idSub": 0,
    "message": "At House Kyogoku, Zenitsu, disguised as Zenko, becomes very invested in the shamisen. After regaining his composure, he hears a girl's cries with his keen hearing...",
  },
  "StoryBoard_Message_0130:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9421,
    "idSub": 0,
    "message": "Uzui reports that Zenitsu is missing. Tanjiro and Inosuke feel the presence of a demon getting stronger. The battle at the Entertainment District draws near...",
  },
  "StoryBoard_Message_0140:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9422,
    "idSub": 0,
    "message": "While on his way to see Inosuke at House Ogimoto, Tanjiro picks up the scent of a ferocious demon coming from House Tokito...",
  },
  "StoryBoard_Message_0150:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
