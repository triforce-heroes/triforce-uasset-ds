      "type": "Buffer",
    },
    "id": 10331,
    "idSub": 0,
    "message": "Acquire more gear, Battle Attires, quotes, and Slayer ID frames by purchasing them with Kimetsu Points.",
  },
  "Tutorial_APK2_text_0060_00:0" => {
    "attribute": {
      "data": [
