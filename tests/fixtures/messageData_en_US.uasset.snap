        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2635,
    "idSub": 0,
    "message": "O-Oh, nice to meet you... I'm Zenitsu Agatsuma. Anyway, what's a tailor doing in a place like this?",
  },
  "APK_Sub04_Talk_0250:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        9,
