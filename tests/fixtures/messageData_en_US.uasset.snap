        0,
        0,
        181,
        23,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 306,
    "idSub": 0,
    "message": "I failed to protect everyone I cherished, nor could I accomplish any of my goals in life...",
  },
  "APK2_BSG01_MemoryFragment_012_0050:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        100,
        0,
        0,
        0,
        181,
        23,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 307,
    "idSub": 0,
    "message": "My name is as worthless as I am.",
  },
  "APK2_BSG01_MemoryFragment_012_0060:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
