      "type": "Buffer",
    },
    "id": 490,
    "idSub": 0,
    "message": "I don't have much longer, and though I have no regrets... I still worry for you.",
  },
  "APK2_BSG01_MemoryFragment_033_0070:0" => {
    "attribute": {
      "data": [
