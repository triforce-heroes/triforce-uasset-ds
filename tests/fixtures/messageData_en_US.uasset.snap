        0,
        0,
        176,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 321,
    "idSub": 0,
    "message": "After Lady Amane told my older brother and me that we were descendants of the First Breathing swordsmen, she recruited the two of us to join the Demon Slayer Corps.",
  },
  "APK2_BSG01_MemoryFragment_014_0020:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        115,
        0,
        0,
        0,
        176,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 322,
    "idSub": 0,
    "message": "I wanted to become a swordsman so that I could help other people... but my brother didn't think the same way.",
  },
  "APK2_BSG01_MemoryFragment_014_0030:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        116,
        0,
        0,
        0,
        230,
        22,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 323,
    "idSub": 0,
    "message": "What makes you think you could ever save anyone!?",
  },
  "APK2_BSG01_MemoryFragment_014_0040:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        117,
        0,
        0,
        0,
        230,
        22,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 324,
    "idSub": 0,
    "message": "What the hell is wrong with you!? You're no different from Mother and Father—too optimistic for your own good!",
  },
  "APK2_BSG01_MemoryFragment_014_0050:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        118,
        0,
        0,
        0,
        230,
        22,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 325,
    "idSub": 0,
    "message": "Just like Mother, who wound up working herself to death! Like Father, who got himself killed searching for some herbs!",
  },
  "APK2_BSG01_MemoryFragment_014_0060:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        119,
        0,
        0,
        0,
        230,
        22,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 326,
    "idSub": 0,
    "message": "Even though I tried to stop him! Even though I begged Mother to rest, over and over!",
  },
  "APK2_BSG01_MemoryFragment_014_0070:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        120,
