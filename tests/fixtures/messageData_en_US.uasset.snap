        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 260,
    "idSub": 0,
    "message": "But you're wrong, Mr. Shinjuro. I wasn't born with this scar to begin with.",
  },
  "APK2_BSG01_MemoryFragment_008_0090:0" => {
    "attribute": {
      "data": [
        0,
        9,
