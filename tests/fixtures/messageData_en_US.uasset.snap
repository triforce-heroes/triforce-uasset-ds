      "type": "Buffer",
    },
    "id": 240,
    "idSub": 0,
    "message": "So I tried to escape from the house by drinking some poison...",
  },
  "APK2_BSG01_MemoryFragment_006_0060:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
