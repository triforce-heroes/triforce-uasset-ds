        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1561,
    "message": "What do you think of my god-like power? Everything my fists touch turns into the most amazing fish you've seen!",
  },
  "FamousSaying:1571" => {
    "attribute": {
      "data": [
        0,
