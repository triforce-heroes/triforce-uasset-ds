        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1531,
    "message": "Grrr... I don't like this one bit. I've never concentrated this hard on one of my pieces before. It makes me feel as if I'm the inferior artist!",
  },
  "FamousSaying:1541" => {
    "attribute": {
      "data": [
