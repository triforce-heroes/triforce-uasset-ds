        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 359,
    "idSub": 0,
    "message": "Having to kill his mother with his own two hands, then being denounced by his only surviving brother... I can't imagine how he must have felt.",
  },
  "APK2_BSG01_MemoryFragment_017_0140:0" => {
    "attribute": {
      "data": [
