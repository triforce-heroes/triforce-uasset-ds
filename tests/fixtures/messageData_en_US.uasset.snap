    "id": 290,
    "idSub": 0,
    "message": "Gyutaro is no longer with us—meaning the Upper Ranks are now incomplete...",
  },
  "APK2_BSG01_MemoryFragment_011_0040:0" => {
    "attribute": {
      "data": [
