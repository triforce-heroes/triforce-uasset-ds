        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 424,
    "idSub": 0,
    "message": "I've now located around sixty percent of the Demon Slayer Corps. Though it matters not, as the girl continues to elude me.",
  },
  "APK2_BSG01_MemoryFragment_023_0040:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
