        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 391,
    "idSub": 0,
    "message": "My body forbade me from stepping into the sunlight.",
  },
  "APK2_BSG01_MemoryFragment_020_0070:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
