      ],
      "type": "Buffer",
    },
    "id": 423,
    "idSub": 0,
    "message": "I have found another one of them.",
  },
  "APK2_BSG01_MemoryFragment_023_0030:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
