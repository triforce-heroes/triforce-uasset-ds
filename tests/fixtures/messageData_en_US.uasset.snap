        0,
        0,
        240,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 444,
    "idSub": 0,
    "message": "When help arrived on the scene, this is what she told them:",
  },
  "APK2_BSG01_MemoryFragment_025_0070:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        239,
        0,
        0,
        0,
        240,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 445,
    "idSub": 0,
    "message": ""That man is a monster. He's the one who did it... who killed everyone."",
  },
  "APK2_BSG01_MemoryFragment_025_0080:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
