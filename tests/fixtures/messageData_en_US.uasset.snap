      ],
      "type": "Buffer",
    },
    "id": 8173,
    "idSub": 0,
    "message": "Back when I was staying with Mr. Urokodaki, I also kept a journal about Nezuko.",
  },
  "PictureBook_Line_0080:0" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
