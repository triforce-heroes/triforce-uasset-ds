      "type": "Buffer",
    },
    "id": 2724,
    "idSub": 5151,
    "message": "Um... Actually, I have a favor to ask you. I'll cut straight to the point: I need you to kill a demon.",
  },
  "APK_Sub05_Talk:5161" => {
    "attribute": {
      "data": [
