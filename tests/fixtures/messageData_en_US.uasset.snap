        71,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 388,
    "idSub": 0,
    "message": "Unfortunately, my worsening condition led me to spiral and kill that damn quack.",
  },
  "APK2_BSG01_MemoryFragment_020_0040:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
