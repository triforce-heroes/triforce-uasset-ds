        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1481,
    "message": "Two is better than one, you know?",
  },
  "FamousSaying:1491" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        148,
        0,
        0,
        0,
