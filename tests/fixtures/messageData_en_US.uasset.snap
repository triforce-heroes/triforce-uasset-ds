      "type": "Buffer",
    },
    "id": 259,
    "idSub": 0,
    "message": "Those who are chosen to wield Sun Breathing are born with the same red mark on their forehead that you have.",
  },
  "APK2_BSG01_MemoryFragment_008_0080:0" => {
    "attribute": {
      "data": [
