    },
    "id": 10336,
    "idSub": 0,
    "message": "Switch fighters while attacking. Use <kcId_kcId_Battle_Support/> + <kcId_kcId_Battle_Guard/> simultaneously while attacking to switch. When switching, the combo timer will be slightly restored.",
  },
