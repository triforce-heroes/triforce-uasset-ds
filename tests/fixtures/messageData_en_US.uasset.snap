        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1491,
    "message": "It makes you bitter, huh? Realizing how weak you are. Humans are so cute, looking to the sky when you grieve. All so you don't let your tears fall down your face.",
  },
  "FamousSaying:1501" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        149,
        0,
        0,
        0,
        49,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1501,
    "message": "When you die, my words will ring through your skull. I'll show no mercy so you'll never forget the name Gyutaro!",
  },
  "FamousSaying:1511" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        150,
        0,
        0,
        0,
        79,
