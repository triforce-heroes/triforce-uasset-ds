        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 358,
    "idSub": 0,
    "message": "What I thought was a wolf that attacked our family was actually our mother, who'd turned into a demon.",
  },
  "APK2_BSG01_MemoryFragment_017_0130:0" => {
    "attribute": {
      "data": [
