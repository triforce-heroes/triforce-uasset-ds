        0,
        0,
        240,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 449,
    "idSub": 0,
    "message": "Children are prone to lying and acts of cruelty. They are selfishness personified.",
  },
  "APK2_BSG01_MemoryFragment_025_0120:0" => {
    "attribute": {
      "data": [
