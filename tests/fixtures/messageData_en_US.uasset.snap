        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 381,
    "idSub": 0,
    "message": "You say your hands are to blame? Then we'll tie your hands together—and sever them!",
  },
  "APK2_BSG01_MemoryFragment_019_0070:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
