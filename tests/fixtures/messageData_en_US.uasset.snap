      "type": "Buffer",
    },
    "id": 258,
    "idSub": 0,
    "message": "But, Kamado... You are just as exceptional—if not more so, young man.",
  },
  "APK2_BSG01_MemoryFragment_008_0070:0" => {
    "attribute": {
      "data": [
        0,
        9,
