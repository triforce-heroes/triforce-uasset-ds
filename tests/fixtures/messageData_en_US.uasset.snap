        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 434,
    "idSub": 0,
    "message": "It's clear now... What I should do—what I must do, no matter what.",
  },
  "APK2_BSG01_MemoryFragment_024_0040:0" => {
    "attribute": {
      "data": [
        0,
