        0,
        0,
        170,
        23,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2636,
    "idSub": 0,
    "message": "Well, you see, after wrapping my latest creations up in a cloth, safe and secure, I was on my merry way to deliver them...",
  },
  "APK_Sub04_Talk_0260:0" => {
    "attribute": {
      "data": [
        0,
        9,
