        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1511,
    "message": "You have some nerve, slashing my art! My magnificent creation! Only a philistine with no eye for beauty would do such a thing!",
  },
  "FamousSaying:1521" => {
    "attribute": {
      "data": [
        0,
