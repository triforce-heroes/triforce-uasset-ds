        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 365,
    "idSub": 0,
    "message": "Isn't there something I can do? Some way I can help others while being true to myself?",
  },
  "APK2_BSG01_MemoryFragment_018_0060:0" => {
    "attribute": {
