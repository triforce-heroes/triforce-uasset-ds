      "type": "Buffer",
    },
    "id": 257,
    "idSub": 0,
    "message": "He must take after his mother Ruka more. Both Kyojuro and Senjuro are splendid sons.",
  },
  "APK2_BSG01_MemoryFragment_008_0060:0" => {
    "attribute": {
      "data": [
