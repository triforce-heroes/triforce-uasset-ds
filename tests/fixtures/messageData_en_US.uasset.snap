        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 218,
    "idSub": 0,
    "message": "After the dust settled on the Mugen Train, I visited Mr. Rengoku's family to relay his last words.",
  },
  "APK2_BSG01_MemoryFragment_002_0020:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
