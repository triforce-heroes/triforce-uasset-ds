      ],
      "type": "Buffer",
    },
    "id": 264,
    "idSub": 0,
    "message": "But even so, even if I'm not a chosen one, I have to beat Muzan Kibutsuji—no matter what.",
  },
  "APK2_BSG01_MemoryFragment_006_0010:0" => {
    "attribute": {
