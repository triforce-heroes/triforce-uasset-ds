        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1701,
    "message": "Silence, shameless tramp. There's only one person who can order me around, and it isn't you.",
  },
  "FamousSaying:1711" => {
