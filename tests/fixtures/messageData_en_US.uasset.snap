    "id": 427,
    "idSub": 0,
    "message": "What's left to peruse...? How about around here?",
  },
  "APK2_BSG01_MemoryFragment_023_0070:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
