        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 489,
    "idSub": 0,
    "message": "And how you strive so hard you end up vomiting blood. Who could possibly understand you...?",
  },
  "APK2_BSG01_MemoryFragment_033_0060:0" => {
    "attribute": {
      "data": [
        0,
        9,
