        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 255,
    "idSub": 0,
    "message": "Unlike me, Kyojuro somehow grew into a fine man.",
  },
  "APK2_BSG01_MemoryFragment_008_0040:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
