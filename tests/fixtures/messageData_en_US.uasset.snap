      ],
      "type": "Buffer",
    },
    "id": 236,
    "idSub": 0,
    "message": "I learned from House Kyogoku they had Hinatsuru sent to the kirimise.",
  },
  "APK2_BSG01_MemoryFragment_006_0020:0" => {
    "attribute": {
      "data": [
        0,
        9,
