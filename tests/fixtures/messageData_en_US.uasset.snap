        0,
        0,
        157,
        22,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 221,
    "idSub": 0,
    "message": "Wait, Mr. Tanjiro, before you go—please, take this. It's the hand guard from my brother's Nichirin sword.",
  },
  "APK2_BSG01_MemoryFragment_002_0050:0" => {
    "attribute": {
      "data": [
