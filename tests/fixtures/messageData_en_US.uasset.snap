        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 287,
    "idSub": 0,
    "message": "Together, we're stronger than we are alone.",
  },
  "APK2_BSG01_MemoryFragment_012_0010:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
