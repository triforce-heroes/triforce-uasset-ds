      ],
      "type": "Buffer",
    },
    "id": 239,
    "idSub": 0,
    "message": "By the time I realized Oiran Warabihime was a demon, she was already suspicious of me...",
  },
  "APK2_BSG01_MemoryFragment_006_0050:0" => {
    "attribute": {
      "data": [
