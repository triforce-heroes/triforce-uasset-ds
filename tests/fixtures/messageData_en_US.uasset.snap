        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 384,
    "idSub": 0,
    "message": "What is this...? Is that me from when I was human?",
  },
  "APK2_BSG01_MemoryFragment_019_0100:0" => {
    "attribute": {
      "data": [
        0,
        9,
