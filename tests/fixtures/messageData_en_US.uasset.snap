      ],
      "type": "Buffer",
    },
    "id": 220,
    "idSub": 0,
    "message": "Then, right when I was about to leave...",
  },
  "APK2_BSG01_MemoryFragment_002_0040:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        14,
