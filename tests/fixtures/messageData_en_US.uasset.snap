        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10332,
    "idSub": 0,
    "message": "The more you play with a character, the more your mastery with them will increase. When reaching certain levels of mastery, you'll receive a reward.",
  },
  "Tutorial_APK2_text_0061_00:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
