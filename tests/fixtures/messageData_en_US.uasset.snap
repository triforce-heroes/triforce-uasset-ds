        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1441,
    "message": "You really are a disgrace, huh? Imagine being so useless, you can't protect your own sister.",
  },
  "FamousSaying:1451" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        144,
        0,
        0,
        0,
