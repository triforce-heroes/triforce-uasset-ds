        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2639,
    "idSub": 0,
    "message": "It has no idea the hardship I suffered to create those garments! I have to retrieve them, no matter what!",
  },
  "APK_Sub04_Talk_0281:0" => {
    "attribute": {
      "data": [
        0,
        9,
