        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 8170,
    "idSub": 0,
    "message": "The people at the Wisteria House always assist the Demon Slayer Corps without asking for anything in return.",
  },
  "PictureBook_Line_0050:0" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
