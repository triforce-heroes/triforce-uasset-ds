        255,
        170,
        23,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2637,
    "idSub": 0,
    "message": "Until I spotted a demon prowling about! I dropped everything and took shelter to hide from its view—LITERALLY!",
  },
  "APK_Sub04_Talk_0270:0" => {
    "attribute": {
      "data": [
