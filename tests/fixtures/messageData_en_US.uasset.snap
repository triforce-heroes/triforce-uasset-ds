      "type": "Buffer",
    },
    "id": 396,
    "idSub": 0,
    "message": "Were I to devour that girl and inherit her traits, then I too shall conquer the sun!",
  },
  "APK2_BSG01_MemoryFragment_024_0010:0" => {
    "attribute": {
