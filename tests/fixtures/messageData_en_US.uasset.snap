    "id": 231,
    "idSub": 0,
    "message": "I see you've devoured a multitude of humans. You've grown far more powerful than I anticipated.",
  },
  "APK2_BSG01_MemoryFragment_005_0050:0" => {
    "attribute": {
      "data": [
