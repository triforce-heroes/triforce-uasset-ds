        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 450,
    "idSub": 0,
    "message": "Naturally, I did not trust Tanjiro Kamado at first...",
  },
  "APK2_BSG01_MemoryFragment_033_0010:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
