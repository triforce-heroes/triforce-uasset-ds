      "type": "Buffer",
    },
    "id": 362,
    "idSub": 0,
    "message": "When I was pretending to be weak and helpless, someone else came forward, claiming he wanted to marry me.",
  },
  "APK2_BSG01_MemoryFragment_018_0030:0" => {
    "attribute": {
