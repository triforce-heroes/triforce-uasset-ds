        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9819,
    "idSub": 0,
    "message": "Yahaba and Susamaru met for the first time on the day they fought Tanjiro. They became friends as they chatted on their way to Tamayo's clinic.",
  },
  "TaishoRumorContent_0061:0" => {
    "attribute": {
