        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 425,
    "idSub": 0,
    "message": "Oh, Nakime, how you've grown. You've become far more valuable than I ever imagined. How magnificent.",
  },
  "APK2_BSG01_MemoryFragment_023_0050:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
