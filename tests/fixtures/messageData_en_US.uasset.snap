        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 250,
    "idSub": 0,
    "message": "As a demon slayer, it goes without saying I'll protect the public leading their mundane lives.",
  },
  "APK2_BSG01_MemoryFragment_007_0060:0" => {
    "attribute": {
      "data": [
        0,
