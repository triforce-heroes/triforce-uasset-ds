        0,
        0,
        47,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 282,
    "idSub": 0,
    "message": "No! Brother, please...! Please don't leave! You can't! I won't let go!",
  },
  "APK2_BSG01_MemoryFragment_010_0060:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        76,
        0,
        0,
        0,
        47,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 283,
    "idSub": 0,
    "message": "Don't you remember your promise!?",
  },
  "APK2_BSG01_MemoryFragment_010_0070:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        77,
        0,
        0,
        0,
        49,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 284,
    "idSub": 0,
    "message": "If we're together, nothing can shake us. The cold or hunger doesn't bother us at all",
  },
  "APK2_BSG01_MemoryFragment_010_0080:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        78,
        0,
        0,
        0,
        49,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 285,
    "idSub": 0,
    "message": "I promise you we'll always be together. I will never leave your side! See? Not afraid of anything now, are you?",
  },
  "APK2_BSG01_MemoryFragment_010_0090:0" => {
    "attribute": {
      "data": [
        0,
        9,
