        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 392,
    "idSub": 0,
    "message": "There was no doubt in my mind. If I were to be exposed to it, I would die.",
  },
  "APK2_BSG01_MemoryFragment_020_0080:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
