        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1521,
    "message": "I'm getting giddy thinking of all the artwork I could make from you!",
  },
  "FamousSaying:1531" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
