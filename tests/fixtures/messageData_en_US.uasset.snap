        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 363,
    "idSub": 0,
    "message": "Is this all right? Am I really okay with this? Am I going to spend the rest of my life like this?",
  },
  "APK2_BSG01_MemoryFragment_018_0040:0" => {
    "attribute": {
      "data": [
