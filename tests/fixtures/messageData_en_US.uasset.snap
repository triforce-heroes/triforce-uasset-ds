        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 395,
    "idSub": 0,
    "message": "Now at long last I have found her.",
  },
  "APK2_BSG01_MemoryFragment_020_0104:0" => {
    "attribute": {
      "data": [
