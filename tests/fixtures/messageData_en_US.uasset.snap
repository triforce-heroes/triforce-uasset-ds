        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 430,
    "idSub": 0,
    "message": "At long last, my dream is nearing fruition.",
  },
  "APK2_BSG01_MemoryFragment_023_0100:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        225,
