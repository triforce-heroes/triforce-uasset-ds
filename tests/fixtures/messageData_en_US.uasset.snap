        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 383,
    "idSub": 0,
    "message": "There will come a day when you shall atone for your sins with your own filthy life!",
  },
  "APK2_BSG01_MemoryFragment_019_0090:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
