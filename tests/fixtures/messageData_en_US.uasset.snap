        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2330,
    "idSub": 1901,
    "message": "During training, the look on the Serpent Hashira's face changed suddenly—it was like he turned bloodthirsty! Not to mention he started swinging with full force.",
  },
  "APK_Main20_Talk:1902" => {
    "attribute": {
      "data": [
