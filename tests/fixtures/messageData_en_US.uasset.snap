        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 248,
    "idSub": 0,
    "message": "Your life comes before the mission! Do I make myself loud, flashy, and clear?",
  },
  "APK2_BSG01_MemoryFragment_007_0040:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
