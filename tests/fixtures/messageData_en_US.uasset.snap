        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 433,
    "idSub": 0,
    "message": "Are you all right, Zenitsu? You haven't been speaking much lately. It's got me worried...",
  },
  "APK2_BSG01_MemoryFragment_024_0030:0" => {
    "attribute": {
      "data": [
