        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 485,
    "idSub": 0,
    "message": "I used to have my swords forged by Mr. Tetsuido, who later passed away from heart disease.",
  },
  "APK2_BSG01_MemoryFragment_033_0020:0" => {
    "attribute": {
      "data": [
