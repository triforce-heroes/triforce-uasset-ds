        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10334,
    "idSub": 0,
    "message": "If you use two of your stocked special bars to activate an Ultimate Art, you can pair up with your support fighter to dish out a Dual Ultimate.",
  },
  "Tutorial_APK2_text_0062_00:0" => {
    "attribute": {
