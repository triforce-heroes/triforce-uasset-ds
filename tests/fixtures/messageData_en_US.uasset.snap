        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 382,
    "idSub": 0,
    "message": "No matter what you say, the truth remains the same. Silencing me changes nothing!",
  },
  "APK2_BSG01_MemoryFragment_019_0080:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
