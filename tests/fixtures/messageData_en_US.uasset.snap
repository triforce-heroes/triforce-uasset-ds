        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2638,
    "idSub": 0,
    "message": "That demon snatched up my work, carrying cloth and all, and left! Ugh, how absolutely aggravating!",
  },
  "APK_Sub04_Talk_0275:0" => {
    "attribute": {
      "data": [
        0,
        9,
