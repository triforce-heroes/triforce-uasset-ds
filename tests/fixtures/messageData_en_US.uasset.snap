      ],
      "type": "Buffer",
    },
    "id": 379,
    "idSub": 0,
    "message": "I know damn well you can see just fine!",
  },
  "APK2_BSG01_MemoryFragment_019_0050:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
