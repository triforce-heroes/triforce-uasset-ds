        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 426,
    "idSub": 0,
    "message": "It is an honor to hear you say that.",
  },
  "APK2_BSG01_MemoryFragment_023_0060:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
