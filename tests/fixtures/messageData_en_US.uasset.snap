        0,
        0,
        240,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 447,
    "idSub": 0,
    "message": "The demon's corpse had turned to ash, and all that remained were the bodies of the orphans I cared for. Soon after, I was imprisoned for murder.",
  },
  "APK2_BSG01_MemoryFragment_025_0100:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        242,
