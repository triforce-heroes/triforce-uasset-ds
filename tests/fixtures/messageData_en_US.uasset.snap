        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1541,
    "message": "Hyo, hyo! My, what a childish insult! Don't tell me you really thought that would be enough to fluster me!",
  },
  "FamousSaying:1551" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        154,
