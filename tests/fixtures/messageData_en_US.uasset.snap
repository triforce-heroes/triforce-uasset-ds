        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10268,
    "idSub": 11,
    "message": "Compete and win battles in this mode to obtain Rank Points and Corps Points. Rankings are split in seasons, which last for one month.",
  },
  "Tutorial_APK2_DLC_text_0020:21" => {
    "attribute": {
      "data": [
