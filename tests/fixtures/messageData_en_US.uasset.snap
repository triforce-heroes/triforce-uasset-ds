        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 263,
    "idSub": 0,
    "message": "I'm no chosen one. There's nothing particularly special about me.",
  },
  "APK2_BSG01_MemoryFragment_008_0120:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
