        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1601,
    "message": "Bear witness to my unbridled strength and all its glory!",
  },
  "FamousSaying:1611" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
