        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1431,
    "message": "You can summon all the underlings you want, but, unfortunately, your fate was sealed from the start.",
  },
  "FamousSaying:1441" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        143,
        0,
        0,
        0,
        49,
