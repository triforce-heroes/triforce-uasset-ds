        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 389,
    "idSub": 0,
    "message": "Not long after I killed him, I realized that his medicine had been effective.",
  },
  "APK2_BSG01_MemoryFragment_020_0050:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
