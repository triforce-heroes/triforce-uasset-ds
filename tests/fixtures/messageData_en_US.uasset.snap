        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1581,
    "message": "You simply can't appreciate high class culture and elegance, because an imbecile like you is too poor and uneducated to comprehend!",
  },
  "FamousSaying:1591" => {
