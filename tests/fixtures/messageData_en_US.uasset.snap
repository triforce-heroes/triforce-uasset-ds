        0,
        3,
        23,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 486,
    "idSub": 0,
    "message": "I worry about you very much, boy. Who could ever understand what you're going through?",
  },
  "APK2_BSG01_MemoryFragment_033_0030:0" => {
    "attribute": {
      "data": [
        0,
        9,
