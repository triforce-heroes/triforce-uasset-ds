    "idSub": 1341,
    "message": "You humans never cease to amaze me with how pathetic you are. If that was the best you could do, then I actually feel a little bad for you.",
  },
  "FamousSaying:1351" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        134,
        0,
        0,
        0,
        11,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1351,
    "message": "Ugly as you are, that was very cute of you. I think I'm starting to grow fond of you. You're like a rat on the brink of death!",
  },
  "FamousSaying:1361" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        135,
        0,
        0,
        0,
        11,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1361,
    "message": "Life is better like this. We demons don't have to buy food or grow old. We'll never get sick, or die. We have nothing to lose.",
  },
  "FamousSaying:1371" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        136,
        0,
        0,
        0,
        11,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1371,
    "message": "Not a single one of those fools lived to see daybreak! After all, we always have the long nights on our side.",
  },
  "FamousSaying:1381" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        137,
        0,
        0,
        0,
        11,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1381,
    "message": "Die! Die! All of you just die! Waaaaaah! He cut my head off! He cut my head off! Help me, Brother!",
  },
  "FamousSaying:1391" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        138,
        0,
        0,
        0,
        11,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1391,
    "message": "I can't believe this is happening! I'm not ready to die! Do something, please! Brother!",
  },
  "FamousSaying:1401" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        139,
        0,
        0,
        0,
        11,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1401,
    "message": "Please don't leave! You can't! I won't let you go! I won't! We're always going to be together! No matter how many times I'm reborn, I'll always be your sister.",
  },
  "FamousSaying:1411" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        140,
        0,
        0,
        0,
        49,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1411,
    "message": "My dearest sister did her best with what little brains she has. Now it's up to me to massacre her tormentors.",
  },
  "FamousSaying:1421" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        141,
        0,
        0,
        0,
        49,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1421,
    "message": "You could say I'm a firm believer in vengeance. I'll exact on you the same pain you inflicted upon her.",
  },
  "FamousSaying:1431" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        142,
        0,
        0,
        0,
