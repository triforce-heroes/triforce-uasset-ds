  "PictureBook_Line:1021" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        238,
        26,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 8166,
    "idSub": 1021,
    "message": "A weaker demon's fangs and claws won't even penetrate the fabric.",
  },
  "PictureBook_Line:1031" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        238,
        26,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 8166,
    "idSub": 1031,
    "message": "I owe it to the Corps tailors for keeping me safe.",
  },
  "PictureBook_Line:1041" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        63,
        5,
        0,
        0,
        238,
