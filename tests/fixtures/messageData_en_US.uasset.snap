        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 364,
    "idSub": 0,
    "message": "Eating a lot, being strong, my hair color... That's all part of who I am. Am I going to pretend to be someone I'm not?",
  },
  "APK2_BSG01_MemoryFragment_018_0050:0" => {
    "attribute": {
      "data": [
