        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 254,
    "idSub": 0,
    "message": "Dear Kamado... I know now that I wronged you. Thank you for shedding the tears I couldn't over my son.",
  },
  "APK2_BSG01_MemoryFragment_008_0030:0" => {
    "attribute": {
      "data": [
