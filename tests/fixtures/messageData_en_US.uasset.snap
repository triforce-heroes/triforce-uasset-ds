      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1631,
    "message": "Don't you feel... the least bit sorry... for someone small like me!?",
  },
  "FamousSaying:1641" => {
    "attribute": {
      "data": [
