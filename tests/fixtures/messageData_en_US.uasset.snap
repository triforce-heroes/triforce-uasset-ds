    "id": 491,
    "idSub": 0,
    "message": "Back then, you always worried yourself sick over my well-being, Mr. Tetsuido... But I'm doing okay now.",
  },
  "APK2_BSG01_MemoryFragment_033_0080:0" => {
    "attribute": {
