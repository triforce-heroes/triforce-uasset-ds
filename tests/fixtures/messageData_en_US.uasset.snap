    },
    "id": 286,
    "idSub": 0,
    "message": "[wailing]",
  },
  "APK2_BSG01_MemoryFragment_010_0100:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        80,
