      ],
      "type": "Buffer",
    },
    "id": 432,
    "idSub": 0,
    "message": "Sometime during our training under Mr. Himejima, Zenitsu started acting strangely...",
  },
  "APK2_BSG01_MemoryFragment_024_0020:0" => {
    "attribute": {
      "data": [
        0,
