      "type": "Buffer",
    },
    "id": 2634,
    "idSub": 0,
    "message": "I'm Masao Maeda, one of the Kakushi! I tailor the Corps uniforms myself.",
  },
  "APK_Sub04_Talk_0240:0" => {
    "attribute": {
      "data": [
