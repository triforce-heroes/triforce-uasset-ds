      "type": "Buffer",
    },
    "id": 9818,
    "idSub": 0,
    "message": "Yushiro's hobby is keeping a "Lady Tamayo journal." He adds around seven to ten pages each day.",
  },
  "TaishoRumorContent_0060:0" => {
    "attribute": {
      "data": [
