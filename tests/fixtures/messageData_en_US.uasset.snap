        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 253,
    "idSub": 0,
    "message": "Approximately four months after Mr. Rengoku's passing, to my surprise, I received a letter from his father, Mr. Shinjuro.",
  },
  "APK2_BSG01_MemoryFragment_008_0020:0" => {
    "attribute": {
      "data": [
