        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 394,
    "idSub": 0,
    "message": "Therefore, I searched for a way to overcome my aversion to sunlight and become truly immortal.",
  },
  "APK2_BSG01_MemoryFragment_020_0102:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
