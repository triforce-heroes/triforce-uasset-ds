      ],
      "type": "Buffer",
    },
    "id": 237,
    "idSub": 0,
    "message": "Courtesans who fall ill are shipped off to those lowest-ranking houses. Knowing that, I hurried over to her.",
  },
  "APK2_BSG01_MemoryFragment_006_0030:0" => {
    "attribute": {
      "data": [
