        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 378,
    "idSub": 0,
    "message": "That's absurd. I'm not capable of such a thing! As someone who's blind—",
  },
  "APK2_BSG01_MemoryFragment_019_0040:0" => {
    "attribute": {
      "data": [
        0,
        9,
