        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 207,
    "idSub": 0,
    "message": "After disposing of Kyojuro, I returned to Lord Muzan to give my report.",
  },
  "APK2_BSG01_MemoryFragment_001_0020:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        1,
        0,
        0,
        0,
        219,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 208,
    "idSub": 0,
    "message": "As per your orders, I've eliminated one of the Hashira, so please rest easy.",
  },
  "APK2_BSG01_MemoryFragment_001_0030:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        2,
        0,
        0,
        0,
        71,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 209,
    "idSub": 0,
    "message": "It seems you have the wrong idea about how things work here, Akaza.",
  },
  "APK2_BSG01_MemoryFragment_001_0040:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        3,
        0,
        0,
        0,
        71,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 210,
    "idSub": 0,
    "message": "Did you expect praise? He was a mere cockroach. A demon defeating a human is a foregone conclusion.",
  },
  "APK2_BSG01_MemoryFragment_001_0050:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        4,
        0,
        0,
        0,
        71,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 211,
    "idSub": 0,
    "message": "What I want is for the Demon Slayer Corps to be wiped out so that I never have to lay my eyes on another filthy hunter again!",
  },
  "APK2_BSG01_MemoryFragment_001_0060:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        5,
        0,
        0,
        0,
        71,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 212,
    "idSub": 0,
    "message": "Yet you return here, boasting of your triumph over one Hashira while three other demon slayers escaped with their lives.",
  },
  "APK2_BSG01_MemoryFragment_001_0070:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        6,
        0,
        0,
        0,
        71,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 213,
    "idSub": 0,
    "message": "Why did you not kill them when you had the chance?",
  },
  "APK2_BSG01_MemoryFragment_001_0080:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        7,
        0,
        0,
        0,
        71,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 214,
    "idSub": 0,
    "message": "You have disappointed me so.",
  },
  "APK2_BSG01_MemoryFragment_001_0090:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        8,
        0,
        0,
        0,
        71,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 215,
    "idSub": 0,
    "message": "To think you suffered a blow from someone who isn't even a Hashira. How far you have fallen, Upper Three.",
  },
  "APK2_BSG01_MemoryFragment_001_0100:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        9,
        0,
        0,
        0,
        219,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 216,
    "idSub": 0,
    "message": "That arrogant brat...!",
  },
  "APK2_BSG01_MemoryFragment_001_0110:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
