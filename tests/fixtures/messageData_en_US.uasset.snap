        0,
        0,
        136,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 247,
    "idSub": 0,
    "message": "From now on, you three are only to think of your own lives above all else. Your top priority is to come back alive.",
  },
  "APK2_BSG01_MemoryFragment_007_0030:0" => {
    "attribute": {
      "data": [
