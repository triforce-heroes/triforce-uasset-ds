        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1461,
    "message": "Why was that? So much for "fortune and misfortune are intertwined." We only knew tragedy and pain.",
  },
  "FamousSaying:1471" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        146,
        0,
        0,
        0,
        49,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1471,
    "message": "If we're together, nothing can shake us. Cold or hunger doesn't bother us at all. I promise you we'll always be together. I will never leave your side! See? You're not afraid of anything now, are you?",
  },
  "FamousSaying:1481" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        147,
        0,
        0,
        0,
