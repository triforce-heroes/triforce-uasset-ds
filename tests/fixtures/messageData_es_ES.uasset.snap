        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10021,
    "idSub": 11,
    "message": "Compite y gana batallas en este modo para obtener puntos de rango y puntos del cuerpo. Las clasificaciones se dividen en temporadas, que duran un mes.",
  },
  "Tutorial_APK2_DLC_text_0020:21" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
