        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 7931,
    "idSub": 1021,
    "message": "Los demonios corrientes no pueden atravesarlo con sus colmillos o garras.",
  },
  "PictureBook_Line:1031" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        78,
