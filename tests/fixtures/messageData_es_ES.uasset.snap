      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1491,
    "message": "Qué rabia da descubrir lo débil que eres, ¿eh? Los humanos sois adorables; miráis al cielo cuando estáis afligidos. Lo que sea con tal de no derramar lágrimas.",
  },
  "FamousSaying:1501" => {
    "attribute": {
