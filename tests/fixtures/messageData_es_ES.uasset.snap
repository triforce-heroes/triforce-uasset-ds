    "id": 2400,
    "idSub": 0,
    "message": "Mira que es duro el entrenamiento del Pilar de la Niebla, ¡pero su cuervo Kasugai es aún peor!",
  },
  "APK_Main20_Talk_0651:0" => {
    "attribute": {
