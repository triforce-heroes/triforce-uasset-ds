    "id": 1316,
    "idSub": 0,
    "message": "No habla mucho, pero dicen que es una preciosidad. ¡Qué ganas de verla!",
  },
  "APK_Main12_Talk_0172:0" => {
    "attribute": {
      "data": [
        0,
