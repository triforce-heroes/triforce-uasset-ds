      "type": "Buffer",
    },
    "id": 2444,
    "idSub": 0,
    "message": "Ay... Qué ganas tengo de empezar el entrenamiento del Pilar del Amor. Je, je, je...",
  },
  "APK_Main20_Talk_0834:0" => {
    "attribute": {
