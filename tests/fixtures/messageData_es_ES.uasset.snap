        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2420,
    "idSub": 0,
    "message": "El otro día vi al Pilar del Amor en un restaurante. ¡Me quedé de piedra!",
  },
  "APK_Main20_Talk_0711:0" => {
    "attribute": {
      "data": [
