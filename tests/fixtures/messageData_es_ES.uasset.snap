      ],
      "type": "Buffer",
    },
    "id": 2443,
    "idSub": 0,
    "message": "Pero ¿qué dices? Si por algo es conocido el Pilar del Amor es por su bondad. ¡No me creo que pueda ser tan despiadada! ¡Ja, ja, ja! ¡Sería ridículo!",
  },
  "APK_Main20_Talk_0833:0" => {
    "attribute": {
      "data": [
