        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2421,
    "idSub": 0,
    "message": "¿Por qué? Los pilares también tienen que comer, ¿sabes?",
  },
  "APK_Main20_Talk_0712:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
