        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2441,
    "idSub": 0,
    "message": "Ay, ¡voy a entrenar con el Pilar del Amor! ¡No quepo en mí de la emoción! ¿Y si nos rozamos las manos sin querer?",
  },
  "APK_Main20_Talk_0831:0" => {
    "attribute": {
      "data": [
