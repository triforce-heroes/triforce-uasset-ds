      ],
      "type": "Buffer",
    },
    "id": 1122,
    "idSub": 2682,
    "message": "¡Pero, cuando te vi sin maquillaje, me volví a sorprender con lo guapa que eres!",
  },
  "APK_Main11_Talk:2683" => {
    "attribute": {
      "data": [
        0,
        9,
