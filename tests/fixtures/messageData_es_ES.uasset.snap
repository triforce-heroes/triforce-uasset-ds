      "type": "Buffer",
    },
    "id": 2330,
    "idSub": 1902,
    "message": "Después apareció un cuervo con un tocado rosa. Llevaba una carta. En cuanto la leyó, cambió por completo.",
  },
  "APK_Main20_Talk:1903" => {
    "attribute": {
