    "id": 2330,
    "idSub": 1901,
    "message": "Durante el entrenamiento, la expresión del Pilar de las Serpientes cambió de pronto. ¡Como si tuviera sed de sangre! Y, por si fuera poco, empezó a luchar con todas sus fuerzas.",
  },
  "APK_Main20_Talk:1902" => {
    "attribute": {
      "data": [
