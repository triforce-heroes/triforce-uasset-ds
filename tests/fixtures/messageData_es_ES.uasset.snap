        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1341,
    "message": "Los humanos nunca dejáis de asombrarme con lo patéticos que podéis llegar a ser. Si eso es todo lo que podéis hacer, quizá empiece a sentirme mal por vosotros.",
  },
  "FamousSaying:1351" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        134,
        0,
        0,
        0,
        47,
