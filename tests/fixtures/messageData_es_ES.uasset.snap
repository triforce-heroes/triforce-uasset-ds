        0,
      ],
      "type": "Buffer",
    },
    "id": 16455,
    "idSub": 0,
    "message": "Verlo ahí, sin más, que no está ni tan siquiera atado, me pone del hígado.",
  },
  "V_P0016_V00_C00_TaishiHyo_0240:0" => {
    "attribute": {
      "data": [
