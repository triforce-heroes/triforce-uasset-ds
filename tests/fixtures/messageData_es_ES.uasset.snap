    "id": 1324,
    "idSub": 0,
    "message": "Cuando piensas en mujeres excepcionales, las oiran son lo primero que te viene a la cabeza. ¡Son guapas y tienen muy buenos modales!",
  },
  "APK_Main12_Talk_0201:0" => {
