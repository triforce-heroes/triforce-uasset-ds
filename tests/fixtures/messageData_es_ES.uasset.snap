      "type": "Buffer",
    },
    "id": 1122,
    "idSub": 3712,
    "message": "Al principio, la madama se puso hecha un basilisco, pero resulta que la chica trabaja como la que más.",
  },
  "APK_Main11_Talk:3713" => {
    "attribute": {
      "data": [
        0,
        9,
