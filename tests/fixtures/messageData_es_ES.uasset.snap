      "type": "Buffer",
    },
    "id": 2417,
    "idSub": 0,
    "message": "Me han dicho que Kanroji recibió entrenamiento de Rengoku hace mucho tiempo.",
  },
  "APK_Main20_Talk_0701:0" => {
    "attribute": {
      "data": [
