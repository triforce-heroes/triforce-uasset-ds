      "type": "Buffer",
    },
    "id": 1325,
    "idSub": 0,
    "message": "Pero ¿sabes qué? A pesar de su hermosura, hay oiran que tienen muy mal carácter.",
  },
  "APK_Main12_Talk_0202:0" => {
    "attribute": {
      "data": [
