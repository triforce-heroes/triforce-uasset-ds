        0,
        78,
        26,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 8028,
    "idSub": 0,
    "message": "Ah, mochis de sakura... El aperitivo favorito de Kanroji, si no recuerdo mal.",
  },
  "PictureBook_Line_0980:0" => {
    "attribute": {
