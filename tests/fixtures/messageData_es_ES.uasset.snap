        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1321,
    "message": "¿De quién crees que son las ganancias que han permitido que esta casa haya prosperado, vieja?",
  },
  "FamousSaying:1331" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
