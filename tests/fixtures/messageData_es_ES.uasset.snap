        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2434,
    "idSub": 0,
    "message": "¡Por eso me sorprendió! El Pilar del Amor estaba tan contenta... ¡Y nada menos que con el Pilar de las Serpientes!",
  },
  "APK_Main20_Talk_0813:0" => {
    "attribute": {
      "data": [
