      "type": "Buffer",
    },
    "id": 1338,
    "idSub": 0,
    "message": "No deja de ser un negocio. Es de esperar que no den techo a quienes no pueden aportar nada.",
  },
  "APK_Main12_Talk_0240:0" => {
    "attribute": {
      "data": [
