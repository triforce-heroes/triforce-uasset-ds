        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10021,
    "idSub": 21,
    "message": "Se restarán puntos de rango al perder. Los puntos del cuerpo se irán acumulando cada temporada y no se restan al perder partidas.",
  },
  "Tutorial_APK2_DLC_Title_0030:11" => {
