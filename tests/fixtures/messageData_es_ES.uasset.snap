        255,
      ],
      "type": "Buffer",
    },
    "id": 10041,
    "idSub": 0,
    "message": "Hay varios objetos esparcidos por diferentes zonas, incluso en callejones y techos.",
  },
  "Tutorial_t_0101:0" => {
    "attribute": {
