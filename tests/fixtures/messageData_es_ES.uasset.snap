        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2432,
    "idSub": 0,
    "message": "El otro día vi al Pilar del Amor y al Pilar de las Serpientes comiendo juntos. ¡No me lo esperaba! Parece que se llevan bien.",
  },
  "APK_Main20_Talk_0811:0" => {
    "attribute": {
      "data": [
