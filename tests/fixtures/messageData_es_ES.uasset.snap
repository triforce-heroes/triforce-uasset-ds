    "id": 1122,
    "idSub": 3714,
    "message": "¡Una mujer de verdad no solo es guapa! Tienes que esforzarte tanto como la chica de Casa Tokitō.",
  },
  "APK_Main11_Talk:3721" => {
    "attribute": {
