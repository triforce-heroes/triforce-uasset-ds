      "type": "Buffer",
    },
    "id": 2440,
    "idSub": 0,
    "message": "Los cuervos empiezan a parecerse a sus dueños a medida que pasan tiempo juntos.",
  },
  "APK_Main20_Talk_0830:0" => {
    "attribute": {
      "data": [
