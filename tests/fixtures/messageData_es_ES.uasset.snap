      "type": "Buffer",
    },
    "id": 2419,
    "idSub": 0,
    "message": "Kanroji no se quejó jamás durante el entrenamiento de Rengoku. Es increíble.",
  },
  "APK_Main20_Talk_0710:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        157,
