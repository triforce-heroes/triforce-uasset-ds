        0,
      ],
      "type": "Buffer",
    },
    "id": 7931,
    "idSub": 1011,
    "message": "Nuestros uniformes están confeccionados con un tejido ligero que protege de la humedad y del fuego.",
  },
  "PictureBook_Line:1021" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
        255,
        255,
