      ],
      "type": "Buffer",
    },
    "id": 7931,
    "idSub": 1001,
    "message": "Es el uniforme del cuerpo de matademonios... Alguien se lo ha dejado tirado.",
  },
  "PictureBook_Line:1011" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
