      "type": "Buffer",
    },
    "id": 1333,
    "idSub": 0,
    "message": "Cuando llegué, el personal del establecimiento me dijo que seguramente había oído mal.",
  },
  "APK_Main12_Talk_0222:0" => {
    "attribute": {
      "data": [
