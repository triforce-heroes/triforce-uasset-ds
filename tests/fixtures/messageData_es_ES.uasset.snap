      "type": "Buffer",
    },
    "id": 1318,
    "idSub": 0,
    "message": "¡He visto a alguien saltando por los tejados! ¡En serio, no miento!",
  },
  "APK_Main12_Talk_0181:0" => {
    "attribute": {
      "data": [
