      "type": "Buffer",
    },
    "id": 2445,
    "idSub": 0,
    "message": "¡A ver si despiertas de una vez y te enfrentas a la realidad! ¡Solo así sentirás la desesperación!",
  },
  "APK_Main20_Talk_0840:0" => {
