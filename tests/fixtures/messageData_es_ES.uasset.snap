      ],
      "type": "Buffer",
    },
    "id": 4653,
    "idSub": 0,
    "message": "(Temía que la gente volviera a hablar de mí como si no fuese humana. Por eso, estuve mucho tiempo reprimiéndome... Pero se acabó).",
  },
  "FamousSaying_0780:0" => {
