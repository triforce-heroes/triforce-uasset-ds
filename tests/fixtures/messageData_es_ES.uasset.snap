    "id": 1122,
    "idSub": 2663,
    "message": "La pega es que tiene una cicatriz enorme en la frente... Aunque solo es un rumor, así que no sé si será verdad.",
  },
  "APK_Main11_Talk:2664" => {
    "attribute": {
      "data": [
