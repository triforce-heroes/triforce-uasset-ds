      ],
      "type": "Buffer",
    },
    "id": 16673,
    "idSub": 0,
    "message": "Quemados o ahorcados, todo vale. ¡Si no, no hay forma de estar seguros!",
  },
  "V_P0016_V00_C00_TaishiHyo_0250:0" => {
    "attribute": {
      "data": [
