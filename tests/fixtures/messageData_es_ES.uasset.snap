        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10174,
    "idSub": 0,
    "message": "Fin de la partida",
  },
  "Tutorial_BookTitle_0031:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10175,
