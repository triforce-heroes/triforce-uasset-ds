    "id": 1122,
    "idSub": 2692,
    "message": "Te veo acalorada o estresada... ¿Qué ocurre? ¿Te encuentras bien?",
  },
  "APK_Main11_Talk:2693" => {
    "attribute": {
      "data": [
        0,
