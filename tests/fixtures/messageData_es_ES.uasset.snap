        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2442,
    "idSub": 0,
    "message": "¡Baja de las nubes! ¡El entrenamiento es una crueldad!",
  },
  "APK_Main20_Talk_0832:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
