  "StoryBoard_Message_0010:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9174,
    "idSub": 0,
    "message": "En un distrito de entretenimiento bañado en sangre, Tanjirō Kamado, del cuerpo de matademonios, se enfurece y lucha contra un demonio que juega con los humanos por diversión.",
  },
  "StoryBoard_Message_0020:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9175,
    "idSub": 0,
    "message": "Retrocedamos en el tiempo. Tras haber recorrido todo el país, Tanjirō envía una carta a su mentor, Urokodaki. El esmero con el que está escrita la carta consigue transmitir la determinación de Tanjirō a su mentor.",
  },
  "StoryBoard_Message_0030:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9176,
    "idSub": 0,
    "message": "Tanjirō está al pie de la montaña bajo la lluvia. Con la orden de derrotar al demonio que ronda el templo de la zona, se abre paso por la pendiente embarrada.",
  },
  "StoryBoard_Message_0040:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9177,
    "idSub": 0,
    "message": "Tanjirō llega al templo de la montaña y busca al demonio que acecha la zona. Su hermana Nezuko y él se enfrentan al feroz enemigo juntos.",
  },
  "StoryBoard_Message_0050:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9178,
    "idSub": 0,
    "message": "Tras cumplir con su misión de matar al demonio, Tanjirō baja la montaña a la vez que amanece. Le trae recuerdos del pasado, cuando podía caminar bajo el sol con su hermana...",
  },
  "StoryBoard_Message_0060:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9179,
    "idSub": 0,
    "message": "En la Finca Mariposa, Tengen Uzui, el Pilar del Sonido, busca a reclutas para una misión de infiltración en el distrito de entretenimiento. Tanjirō propone que Inosuke, Zenitsu y él mismo se unan a Tengen.",
  },
  "StoryBoard_Message_0070:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9180,
    "idSub": 0,
    "message": "Uzui les revela la estrategia que deben seguir antes de emprender la misión de infiltración en el distrito de entretenimiento. Es entonces que se conocen sus verdaderos motivos...",
  },
  "StoryBoard_Message_0080:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9181,
    "idSub": 0,
    "message": "Antes de entrar en el distrito de entretenimiento, Tanjirō reflexiona sobre la visita que hizo en casa de Kyōjurō Rengoku, el Pilar de las Llamas, para entregar su mensaje.",
  },
  "StoryBoard_Message_0090:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9182,
    "idSub": 0,
    "message": "Impregnado de la vanidad y los deseos de hombres y mujeres, el distrito de entretenimiento bulle con pasión y odio en cuanto cae la noche. Tanjirō y compañía recorren las animadas calles disfrazados, pero con toda la pinta de no encajar.",
  },
  "StoryBoard_Message_0100:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9183,
    "idSub": 0,
    "message": "El único objetivo tras infiltrarse en el distrito de entretenimiento es encontrar a las esposas de Uzui. Tanjirō y los demás se unen cada uno a una casa de cortesanas.",
  },
  "StoryBoard_Message_0110:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9184,
    "idSub": 0,
    "message": "Haciéndose pasar por Inoko, Inosuke recorre Casa Ogimoto para investigar. No se le escapa un extraño rumor...",
  },
  "StoryBoard_Message_0120:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9185,
    "idSub": 0,
    "message": "En Casa Kyōgoku, Zenitsu, bajo la identidad de Zenko, se obsesiona con el shamisen. Tras recobrar la compostura, oye el llanto de una chica con su oído agudizado...",
  },
  "StoryBoard_Message_0130:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9186,
    "idSub": 0,
    "message": "Uzui informa de que Zenitsu ha desaparecido. Tanjirō e Inosuke notan la presencia de un demonio volverse cada vez más fuerte. La batalla en el distrito de entretenimiento está a la vuelta de la esquina...",
  },
  "StoryBoard_Message_0140:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9187,
    "idSub": 0,
    "message": "De camino para reunirse con Inosuke en Casa Ogimoto, Tanjirō detecta el olor de un demonio con un poder atroz. Descubre que procede de Casa Tokitō...",
  },
  "StoryBoard_Message_0150:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9188,
    "idSub": 0,
    "message": "Daki, la Luna Superior que ha hecho del distrito de entretenimiento su coto de caza, se enfrenta a Tanjirō. Superando sus miedos, Tanjirō decide empuñar su katana.",
  },
  "StoryBoard_Message_0160:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9189,
    "idSub": 0,
    "message": "Echemos la vista un poco atrás. Cansado de esperar a Tanjirō, Inosuke decide ir por su cuenta y buscar el camino oculto que utiliza el demonio.",
  },
  "StoryBoard_Message_0170:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9190,
    "idSub": 0,
    "message": "Mientras buscaba un pasadizo oculto, Inosuke da con una enorme cueva bajo el distrito de entretenimiento. Allí se esconde un extraño demonio con aspecto de faja.",
  },
  "StoryBoard_Message_0180:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9191,
    "idSub": 0,
    "message": "La pelea entre Tanjirō y Daki se intensifica cuando el demonio faja sale de su guarida para unirse a Daki y revelar su forma final.",
  },
  "StoryBoard_Message_0190:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9192,
    "idSub": 0,
    "message": "Tanjirō llega a su límite, pero Nezuko aparece para salvarlo. En este inesperado giro de los acontecimientos, llega también Uzui, pero un segundo demonio surge de la espalda de Daki...",
  },
  "StoryBoard_Message_0200:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9193,
    "idSub": 0,
    "message": "Da comienzo una feroz batalla entre Uzui y Gyūtarō. Mientras tanto, Tanjirō se retira de ese enfrentamiento para reunirse con Inosuke y Zenitsu. Juntos vuelven corriendo al lado de Uzui.",
  },
  "StoryBoard_Message_0210:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9194,
    "idSub": 0,
    "message": "Tanjirō y compañía forman equipo con Uzui y se dividen en dos grupos. Inosuke y Zenitsu se enfrentan a Daki, mientras que Tanjirō y Uzui combaten contra Gyūtarō.",
  },
  "StoryBoard_Message_0220:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9195,
    "idSub": 0,
    "message": "Se acerca el final de este mortal enfrentamiento entre el cuerpo y los demonios. A pesar de las adversidades, los matademonios siguen luchando, hasta que llega la oportunidad de poner punto final...",
  },
  "StoryBoard_Message_0230:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9196,
    "idSub": 0,
    "message": "Las dos Sextas Lunas Superiores han sido derrotadas. Cuando Ubuyashiki se entera, lo interpreta como una señal del cambio venidero en la larga historia de la lucha contra los demonios.",
  },
  "StoryBoard_Message_0240:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9197,
    "idSub": 0,
    "message": "Mientras descansa en la Finca Mariposa tras el intenso combate en el distrito de entretenimiento, Tanjirō tiene un sueño...",
  },
  "StoryBoard_Message_0250:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9198,
    "idSub": 0,
    "message": "Tanjirō pide permiso para visitar la aldea de los herreros y comprobar el estado de su espada, que se melló en la batalla. Mientras espera el veredicto, no obstante, tiene mucho tiempo libre...",
  },
  "StoryBoard_Message_0260:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9199,
    "idSub": 0,
    "message": "En pleno momento de paz, Tanjirō recibe una carta del cuartel general del cuerpo de matademonios: el esperado permiso para visitar la aldea de los herreros.",
  },
  "StoryBoard_Message_0270:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9200,
    "idSub": 0,
    "message": "Con el permiso concedido, Tanjirō se pone en marcha con un kakushi como guía.",
  },
  "StoryBoard_Message_0280:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9201,
    "idSub": 0,
    "message": "La aldea de los herreros está escondida para evitar que los demonios la invadan. Frente a este lugar tan peculiar, Tanjirō se queda boquiabierto.",
  },
  "StoryBoard_Message_0290:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9202,
    "idSub": 0,
    "message": "Después de saludar a Tecchin, el jefe de la aldea, a Tanjirō le enseñan el lugar y...",
  },
  "StoryBoard_Message_0300:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9203,
    "idSub": 0,
    "message": "Mientras Tanjirō se recupera en la aldea de los herreros, Mitsuri Kanroji, el Pilar del Amor, le cuenta algo muy interesante...",
  },
  "StoryBoard_Message_0310:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9204,
    "idSub": 0,
    "message": "En plena búsqueda del arma secreta, Tanjirō se cruza con Kotetsu y Muichirō Tokitō, el Pilar de la Niebla. Con la idea de vengarse de Muichirō, Kotetsu entrena a Tanjirō con Yoriichi modelo cero.",
  },
  "StoryBoard_Message_0320:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9205,
    "idSub": 0,
    "message": "Tras el entrenamiento con el títere mecánico, Tanjirō y Muichirō conversan en el alojamiento, cuando de repente un demonio aparece. Es Hantengu, la Cuarta Luna Superior.",
  },
  "StoryBoard_Message_0330:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9206,
    "idSub": 0,
    "message": "Karaku, tras separarse de Hantengu, ataca a Muichirō y lo lanza por los aires hasta el bosque. Allí, Muichirō ve a un demonio a punto de atacar a Kotetsu.",
  },
  "StoryBoard_Message_0340:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9207,
    "idSub": 0,
    "message": "A pesar de que los demonios casi destruyen la aldea de los herreros, Mitsuri aparece para ayudar a los aldeanos en estos momentos de crisis.",
  },
  "StoryBoard_Message_0350:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9208,
    "idSub": 0,
    "message": "Muichirō recupera la memoria en su enfrentamiento contra Gyokko, la Quinta Luna Superior. Recuerda a su madre, su padre y su queridísimo hermano mayor, Yuichirō...",
  },
  "StoryBoard_Message_0360:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9209,
    "idSub": 0,
    "message": "Gyokko revela su forma final y juega con Muichirō, que no se inmuta tras recuperar sus recuerdos. Espada en mano, pretende cortarle el cuello al demonio como si fuera mantequilla.",
  },
  "StoryBoard_Message_0370:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9210,
    "idSub": 0,
    "message": "Muichirō decapita a Gyokko. Sin embargo, su cuerpo llega a su límite y cae redondo. En ese momento, oye las voces de su familia...",
  },
  "StoryBoard_Message_0380:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9211,
    "idSub": 0,
    "message": "La lucha entre Hantengu y el cuerpo de matademonios es cada vez más violenta. Tras dividirse en cuatro demonios, Hantengu pilla a Tanjirō desprevenido y lo lanza por los aires hacia el bosque.",
  },
  "StoryBoard_Message_0390:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9212,
    "idSub": 0,
    "message": "Tras volar por los aires y aterrizar en el bosque, Tanjirō se percata del aroma de otro matademonios. Es Genya Shinazugawa, otro miembro del cuerpo que también se enfrenta a una división de Hantengu.",
  },
  "StoryBoard_Message_0400:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9213,
    "idSub": 0,
    "message": "Tanjirō encuentra a Nezuko enterrada bajo los escombros. Incapaz de apartarse del camino del enemigo, Nezuko alcanza la hoja de Tanjirō para convertirla en la espada de sangre explosiva.",
  },
  "StoryBoard_Message_0410:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9214,
    "idSub": 0,
    "message": "Tanjirō, Nezuko y Genya acorralan a Hantengu. Sin embargo, los cuerpos en los que se había dividido se unen en Zohakuten y se cambian las tornas.",
  },
  "StoryBoard_Message_0420:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9215,
    "idSub": 0,
    "message": "Tanjirō y sus aliados están en desventaja contra los ataques de Zohakuten. Por suerte, Mitsuri irrumpe en la escena y se enfrenta al demonio. A medida que se desarrolla la tensa batalla, el cuerpo de Mitsuri comienza a cambiar...",
  },
  "StoryBoard_Message_0430:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9216,
    "idSub": 0,
    "message": "En mitad del enfrentamiento, Tanjirō detecta otra forma de Hantengu. Al agudizar los sentidos, Tanjirō da por fin con el demonio. Con la ayuda de sus amigos, blande su espada...",
  },
  "StoryBoard_Message_0440:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9217,
    "idSub": 0,
    "message": "Hantengu sigue huyendo. El sol se alza; pronto se hará de día. ¿Matar al demonio o salvar a Nezuko? Tanjirō se enfrenta a una decisión complicada.",
  },
  "StoryBoard_Message_0450:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9218,
    "idSub": 0,
    "message": "Tras el empujón de Nezuko, Tanjirō consigue derrotar a Hantengu. El joven llora el sacrificio de su hermana.",
  },
  "StoryBoard_Message_0460:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9219,
    "idSub": 0,
    "message": "Muzan está encantado con lo que ha pasado en la aldea de los herreros. Ahora que Nezuko ha sobrevivido al sol, está a punto de desatarse una gran batalla en la que ella es el epicentro...",
  },
  "StoryBoard_Message_0470:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9220,
    "idSub": 0,
    "message": "Zenitsu visita la Finca Mariposa para ver a Tanjirō y lo saluda Nezuko, quien ahora es inmune al sol.",
  },
  "StoryBoard_Message_0480:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9221,
    "idSub": 0,
    "message": "Zenitsu profesa su amor hacia Nezuko, a quien ahora puede ver bajo los rayos del sol. Finalmente, recuerda el propósito de su visita a la Finca Mariposa: ver a Tanjirō.",
  },
  "StoryBoard_Message_0490:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9222,
    "idSub": 0,
    "message": "Con Tanjirō postrado en la cama, Zenitsu inicia una tranquila conversación con él. Pasan un rato agradable...",
  },
  "StoryBoard_Message_0500:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9223,
    "idSub": 0,
    "message": "La luna brilla esta noche. Sanemi Shinazugawa, el Pilar del Viento, y Obanai Iguro, el Pilar de las Serpientes, desempeñan su tarea de investigar un viejo castillo. Parece que está repleto de demonios...",
  },
  "StoryBoard_Message_0510:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9224,
    "idSub": 0,
    "message": "Dentro del viejo castillo, Sanemi e Iguro se topan con una horda de demonios. Los dos pilares preparan las espadas con la sensación de que aquí hay gato encerrado.",
  },
  "StoryBoard_Message_0520:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9225,
    "idSub": 0,
    "message": "A medida que suben la torre del castillo en busca de demonios, ambos pilares quedan estupefactos: una dimensión alternativa se materializa ante sus ojos. Sanemi blande su espada contra un demonio que huye hacia la dimensión, pero...",
  },
  "StoryBoard_Message_0530:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9226,
    "idSub": 0,
    "message": "Los pilares se reúnen para hablar de lo ocurrido en la aldea de los herreros. Tras debatir acerca de la manifestación de las marcas, se propone que los pilares entrenen al resto del cuerpo de matademonios de cara a la inminente batalla.",
  },
  "StoryBoard_Message_0540:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9227,
    "idSub": 0,
    "message": "Aunque el entrenamiento de los pilares ya ha comenzado, Giyū Tomioka, el Pilar del Agua, se niega a participar. Solo cede ante la insistencia de Tanjirō.",
  },
  "StoryBoard_Message_0550:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9228,
    "idSub": 0,
    "message": "Totalmente recuperado de sus heridas, Tanjirō se une al entrenamiento de los pilares con unos días de retraso. Primero supera el entrenamiento de Uzui para mejorar el aguante.",
  },
  "StoryBoard_Message_0560:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9229,
    "idSub": 0,
    "message": "Después de ver a Uzui, Tanjirō se dirige a la finca de Muichirō. Bajo las exigentes y precisas instrucciones de Muichirō, Tanjirō consigue superar el entrenamiento de agilidad.",
  },
  "StoryBoard_Message_0570:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9230,
    "idSub": 0,
    "message": "Una vez superado el entrenamiento de Muichirō, Tanjirō marcha a la finca de Kanroji. El entrenamiento de Mitsuri sirve para mejorar la flexibilidad y, aunque parezca inofensivo, forzar así el cuerpo conlleva un dolor infernal...",
  },
  "StoryBoard_Message_0580:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9231,
    "idSub": 0,
    "message": "Tanjirō supera el entrenamiento de flexibilidad de Mitsuri y se dirige a la finca de Iguro. Mientras soporta las duras palabras de Iguro, Tanjirō corrige su manejo de la espada.",
  },
  "StoryBoard_Message_0590:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9232,
    "idSub": 0,
    "message": "Cae la noche en casa de Iguro. Tanjirō ve cómo el pilar se marcha de la mansión y decide seguirlo hasta un lugar donde se reúne con otros dos pilares...",
  },
  "StoryBoard_Message_0600:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9233,
    "idSub": 0,
    "message": "Una vez finalizado el entrenamiento con la espada de Iguro, Tanjirō se dirige a la finca de Shinazugawa para la siguiente sesión...",
  },
  "StoryBoard_Message_0610:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9234,
    "idSub": 0,
    "message": "Tanjirō trata desesperadamente de seguir el ritmo de Sanemi, mientras el resto de miembros del cuerpo tiemblan de miedo. A pesar de todo, Tanjirō es incapaz de detener los incesantes ataques de Sanemi...",
  },
  "StoryBoard_Message_0620:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9235,
    "idSub": 0,
    "message": "Después de que le prohíban acercarse a Sanemi, Tanjirō prosigue su entrenamiento con Gyōmei Himejima, el Pilar de las Rocas. Los miembros del cuerpo lo tienen difícil para superar sus tres tareas.",
  },
  "StoryBoard_Message_0630:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9236,
    "idSub": 0,
    "message": "Una vez completado el entrenamiento de Himejima, Tanjirō se dirige a la casa de Giyū para la última sesión.",
  },
  "StoryBoard_Message_0640:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9237,
    "idSub": 0,
    "message": "Es la prueba final de Tanjirō: un duelo contra Giyū. Poniendo en práctica todo lo aprendido, es el momento de que Tanjirō desate toda su fuerza contra él.",
  },
  "StoryBoard_Message_0650:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9238,
    "idSub": 0,
    "message": "Muzan aparece en la mansión Ubuyashiki. Tras enterarse, los pilares se apresuran hacia allí. Blanden la espada contra su archienemigo, sin embargo...",
  },
