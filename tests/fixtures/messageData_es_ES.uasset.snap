        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 8030,
    "idSub": 0,
    "message": "¡Pero yo tampoco me quedo atrás! Tengo que comer más para hacerme más fuerte... ¡Como Kanroji!",
  },
  "PictureBook_Line:1001" => {
    "attribute": {
      "data": [
        0,
