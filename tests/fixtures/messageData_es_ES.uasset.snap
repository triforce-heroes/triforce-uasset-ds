        22,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 1122,
    "idSub": 2652,
    "message": "Normal que la madama esté tan contenta. Tienes una piel preciosa y muy suave, ¡como una muñequita!",
  },
  "APK_Main11_Talk:2653" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        123,
        22,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 1122,
    "idSub": 2653,
    "message": "Con lo guapa que eres, subirás a lo más alto y te convertirás en oiran. Serás la estrella de esta casa.",
  },
  "APK_Main11_Talk:2654" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        8,
