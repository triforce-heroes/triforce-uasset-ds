      "type": "Buffer",
    },
    "id": 1342,
    "idSub": 0,
    "message": "Hay una chica que se parece mucho a ti y te había confundido con ella. Pero tú no eres una cortesana, y mucho menos una chica.",
  },
  "APK_Main12_Talk_0250:0" => {
    "attribute": {
