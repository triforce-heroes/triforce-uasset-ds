        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1451,
    "message": "¡Estás solo! ¡¿Por qué no te rindes?! ¡¿A qué viene tanta obsesión por decapitarme?!",
  },
  "FamousSaying:1461" => {
    "attribute": {
      "data": [
