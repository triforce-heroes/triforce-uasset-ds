      "type": "Buffer",
    },
    "id": 1122,
    "idSub": 2673,
    "message": "¿Y si acaba saliendo a la luz algún escándalo o delito? ¡Ten cuidado!",
  },
  "APK_Main11_Talk:2674" => {
    "attribute": {
      "data": [
        0,
