    "id": 1341,
    "idSub": 0,
    "message": "Además, está claro que tú no eres una chica. ¡Y no creo que te haya dado por disfrazarte de una! ¡Ja, ja, ja!",
  },
  "APK_Main12_Talk_0243:0" => {
