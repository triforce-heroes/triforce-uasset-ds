        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 7931,
    "idSub": 1031,
    "message": "Les debo mi vida a los sastres del cuerpo.",
  },
  "PictureBook_Line:1041" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        63,
