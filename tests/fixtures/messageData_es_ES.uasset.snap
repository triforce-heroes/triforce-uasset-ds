        0,
        0,
        206,
        22,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2422,
    "idSub": 0,
    "message": "La cosa es que la vi devorar ocho raciones de fideos soba, nueve cuencos de ternera y seis guarniciones. ¡Y luego pidió más! Ver para creer.",
  },
  "APK_Main20_Talk_0713:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        183,
        0,
        0,
        0,
        207,
        22,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2423,
    "idSub": 0,
    "message": "Vaya, pues sí que es para quedarse de piedra...",
  },
  "APK_Main20_Talk_0714:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        153,
