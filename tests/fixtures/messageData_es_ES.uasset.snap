      ],
      "type": "Buffer",
    },
    "id": 8029,
    "idSub": 0,
    "message": "Por lo visto, devoró tantos de niña que le cambió el color del pelo y de los ojos.",
  },
  "PictureBook_Line_0990:0" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
        255,
