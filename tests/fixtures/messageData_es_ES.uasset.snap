      "type": "Buffer",
    },
    "id": 9586,
    "idSub": 0,
    "message": "A Kyōgai le encanta «La leyenda de los ocho guerreros perro», de Takizawa Bakin. Fue esta novela la que lo llevó a escribir.",
  },
  "TaishoRumorContent_0063:0" => {
