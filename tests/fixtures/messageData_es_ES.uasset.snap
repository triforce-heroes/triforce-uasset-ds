  "Tutorial_text_0084_00:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10309,
    "idSub": 0,
    "message": "Yahaba ataca lanzando flechas. Las flechas no infligen daño, pero pueden aturdir a tu oponente y crear una oportunidad para ataques posteriores.

También puedes dañar al oponente usando las flechas para estamparlo contra el suelo o lanzarle rocas.",
  },
  "Tutorial_text_0088_00:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10313,
    "idSub": 0,
    "message": "Si entras en contacto con el veneno de un contrincante o pisas un charco en el suelo, te envenenarás, lo que hará que tu salud vaya bajando poco a poco. Aunque el veneno se cura automáticamente con el tiempo o al cambiar de combatiente, es preferible evitarlo.",
  },
  "Tutorial_text_0089_00:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
