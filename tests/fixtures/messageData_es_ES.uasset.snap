        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1421,
    "message": "Pienso cobrarme esta afrenta. Os causaré el mismo dolor que le habéis provocado a ella.",
  },
  "FamousSaying:1431" => {
    "attribute": {
      "data": [
        0,
        9,
