      "type": "Buffer",
    },
    "id": 2429,
    "idSub": 0,
    "message": "Oye, el otro día me preguntaba... ¿Cuánto cobran los pilares?",
  },
  "APK_Main20_Talk_0801:0" => {
    "attribute": {
      "data": [
        0,
