      "type": "Buffer",
    },
    "id": 2430,
    "idSub": 0,
    "message": "Según se ve, tienen fincas increíbles. Seguro que ganan una bestialidad.",
  },
  "APK_Main20_Talk_0802:0" => {
    "attribute": {
      "data": [
