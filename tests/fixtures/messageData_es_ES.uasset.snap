      "type": "Buffer",
    },
    "id": 1320,
    "idSub": 0,
    "message": "¡Había alguien saltando por los tejados! ¡Lo juro! ¡Tienes que creerme!",
  },
  "APK_Main12_Talk_0190:0" => {
    "attribute": {
      "data": [
