      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1331,
    "message": "¡Los demonios atractivos y poderosos podemos hacer lo que queramos!",
  },
  "FamousSaying:1341" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        133,
        0,
