        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 1122,
    "idSub": 2623,
    "message": "Tú verás si prefieres no hablar, pero no descuides tus tareas.",
  },
  "APK_Main11_Talk:2631" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        213,
        6,
        0,
        0,
