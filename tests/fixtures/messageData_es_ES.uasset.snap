      "type": "Buffer",
    },
    "id": 1122,
    "idSub": 3713,
    "message": "No dejan de alabarla por lo mucho que se esfuerza. Ya sabes lo que te toca: una mujer es mucho más que una cara bonita.",
  },
  "APK_Main11_Talk:3714" => {
    "attribute": {
      "data": [
