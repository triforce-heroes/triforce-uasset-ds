        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1361,
    "message": "Esta vida es mucho mejor. Los demonios no tenemos que comprar comida, no envejecemos, ni enfermamos, ni morimos. No tenemos nada que perder.",
  },
  "FamousSaying:1371" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        136,
        0,
        0,
        0,
        47,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1371,
    "message": "¡Ninguno de esos ineptos llegó a ver el amanecer! Al fin y al cabo, las noches largas juegan a nuestro favor.",
  },
  "FamousSaying:1381" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        137,
        0,
        0,
        0,
        47,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1381,
    "message": "¡Morid, morid todos de una vez! ¡Buaaaaa! ¡Me ha cortado la cabeza! ¡Me ha decapitado! ¡Ayúdame, hermano!",
  },
  "FamousSaying:1391" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        138,
        0,
        0,
        0,
        47,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1391,
    "message": "¡No me puedo creer que esto esté pasando! ¡No quiero morir! ¡Haz algo, hermano!",
  },
  "FamousSaying:1401" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        139,
        0,
        0,
        0,
        47,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1401,
    "message": "¡No te vayas, por favor! ¡No puedes! ¡No te dejaré! ¡Siempre vamos a estar juntos! Da igual las veces que renazca, siempre seré tu hermana.",
  },
  "FamousSaying:1411" => {
    "attribute": {
      "data": [
