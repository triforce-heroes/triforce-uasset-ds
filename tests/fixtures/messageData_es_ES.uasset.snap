      "type": "Buffer",
    },
    "id": 4651,
    "idSub": 0,
    "message": "Pero yo en realidad como mucho, soy muy fuerte y tengo el pelo distinto. Así soy yo. ¿Por qué debo fingir ser otra?",
  },
  "FamousSaying_0760:0" => {
