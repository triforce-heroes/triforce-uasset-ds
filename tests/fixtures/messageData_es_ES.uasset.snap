      "type": "Buffer",
    },
    "id": 1122,
    "idSub": 2674,
    "message": "Quizá haya algo más oscuro detrás y pretendan taparlo como un caso de ashinuke... Ten cuidado.",
  },
  "APK_Main11_Talk:2681" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
