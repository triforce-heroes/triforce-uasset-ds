      "type": "Buffer",
    },
    "id": 1339,
    "idSub": 0,
    "message": "¿Eh? Un momento, ¿no eres...? No, me he equivocado. Perdona.",
  },
  "APK_Main12_Talk_0241:0" => {
    "attribute": {
      "data": [
