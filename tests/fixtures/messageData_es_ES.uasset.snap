      "type": "Buffer",
    },
    "id": 2425,
    "idSub": 0,
    "message": "Para mí también es mucho. Ocho raciones de fideos soba, nueve cuencos de ternera... ¡Puaj!",
  },
  "APK_Main20_Talk_0720:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        11,
        0,
        0,
        0,
        208,
        22,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2426,
    "idSub": 0,
    "message": "La espada del Pilar del Amor parece un látigo. Le pregunté cómo la guarda en su vaina.",
  },
  "APK_Main20_Talk_0721:0" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        208,
        22,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2427,
    "idSub": 0,
    "message": "Y entonces me lo demostró. ¡La espada hizo "pa-cham"! ¡Y luego "chis-pam"! ¡Fue alucinante!",
  },
  "APK_Main20_Talk_0722:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        28,
