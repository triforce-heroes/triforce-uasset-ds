      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1431,
    "message": "Invoca a todos los esbirros que quieras, pero tu destino estaba escrito desde el principio.",
  },
  "FamousSaying:1441" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
