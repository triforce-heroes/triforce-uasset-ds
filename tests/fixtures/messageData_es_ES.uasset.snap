        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2433,
    "idSub": 0,
    "message": "¿Eh? ¿De verdad? ¡Si el Pilar del Amor y el Pilar de las Serpientes son como el día y la noche!",
  },
  "APK_Main20_Talk_0812:0" => {
    "attribute": {
      "data": [
