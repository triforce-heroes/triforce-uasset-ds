        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1481,
    "message": "Dos es mejor que uno, ¿sabes?",
  },
  "FamousSaying:1491" => {
    "attribute": {
      "data": [
