        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1441,
    "message": "Qué desgraciado eres, ¿no? ¿Tan inútil eres que no has podido ni proteger a tu hermana?",
  },
  "FamousSaying:1451" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        144,
        0,
        0,
