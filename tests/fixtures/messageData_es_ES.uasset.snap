      ],
      "type": "Buffer",
    },
    "id": 1332,
    "idSub": 0,
    "message": "Me dijeron que en Casa Kyōgoku había una chica a la que se le da de vicio el shamisen, así que fui a saciar mi curiosidad.",
  },
  "APK_Main12_Talk_0221:0" => {
