      "type": "Buffer",
    },
    "id": 2398,
    "idSub": 0,
    "message": "¿Cuánto entrenaría para convertirse en pilar en solo dos meses?",
  },
  "APK_Main20_Talk_0645:0" => {
    "attribute": {
