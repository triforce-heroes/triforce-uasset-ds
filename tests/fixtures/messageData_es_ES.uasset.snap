        22,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2428,
    "idSub": 0,
    "message": "¡Los pilares son increíbles! ¡No soy capaz de moverme como hacen ellos!",
  },
  "APK_Main20_Talk_0800:0" => {
    "attribute": {
      "data": [
        0,
        9,
