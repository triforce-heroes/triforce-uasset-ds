        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1461,
    "message": "¿Y por qué razón? ¿Acaso las cosas buenas y las malas vienen siempre de la mano? Nosotros solo conocíamos la tragedia y el dolor.",
  },
  "FamousSaying:1471" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        146,
        0,
        0,
        0,
        85,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1471,
    "message": "Si estamos juntos, nada podrá con nosotros. Ni el frío ni el hambre nos afectarán. Te prometo que estaremos siempre juntos. ¡Jamás te abandonaré! ¿Lo ves? ¿A que ya no tienes miedo?",
  },
  "FamousSaying:1481" => {
    "attribute": {
      "data": [
