    "id": 1340,
    "idSub": 0,
    "message": "La chica nueva de Casa Tokitō tiene una cicatriz igual en la frente. Te había confundido con ella.",
  },
  "APK_Main12_Talk_0242:0" => {
    "attribute": {
      "data": [
