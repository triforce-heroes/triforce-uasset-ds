      ],
      "type": "Buffer",
    },
    "id": 1122,
    "idSub": 2683,
    "message": "¿Por qué dejaste que te pintarrajearan así? En fin, qué más da eso. Si te esfuerzas, seguro que consigues muchas cosas.",
  },
  "APK_Main11_Talk:2691" => {
    "attribute": {
