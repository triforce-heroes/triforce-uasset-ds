        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 1122,
    "idSub": 2654,
    "message": "¡Cada vez que te miro me pareces más guapa! Me muero de ganas de ver el tipo de cortesana en que te convertirás.",
  },
  "APK_Main11_Talk:2661" => {
    "attribute": {
      "data": [
