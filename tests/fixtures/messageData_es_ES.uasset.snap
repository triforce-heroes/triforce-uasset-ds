    "id": 1122,
    "idSub": 3723,
    "message": "¡Qué pelo tan llamativo! Si no fueras tan fea, podríamos haberlo potenciado como tu mayor atractivo.",
  },
  "APK_Main11_Talk:3731" => {
    "attribute": {
      "data": [
