        0,
        0,
        206,
        22,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2424,
    "idSub": 0,
    "message": "¡Ni en sueños podría comer tanto! Quizás ese sea el secreto de la fuerza del Pilar del Amor.",
  },
  "APK_Main20_Talk_0715:0" => {
    "attribute": {
      "data": [
