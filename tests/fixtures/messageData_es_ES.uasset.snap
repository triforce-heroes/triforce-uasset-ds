        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1351,
    "message": "Para lo feo que eres, ese movimiento ha sido precioso. Creo que estoy empezando a encariñarme de ti. ¡Eres como un ratoncito al borde de la muerte!",
  },
  "FamousSaying:1361" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        135,
        0,
        0,
        0,
        47,
        30,
        0,
