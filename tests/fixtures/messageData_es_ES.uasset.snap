      "type": "Buffer",
    },
    "id": 2435,
    "idSub": 0,
    "message": "¡Es imposible que el Pilar del Amor y el Pilar de las Serpientes se lleven bien!",
  },
  "APK_Main20_Talk_0814:0" => {
    "attribute": {
