      "type": "Buffer",
    },
    "id": 1319,
    "idSub": 0,
    "message": "Le brillaba algo en el brazo y en la frente, pero todo el mundo dice que me lo debo de haber imaginado. ¡Te juro que lo vi!",
  },
  "APK_Main12_Talk_0182:0" => {
    "attribute": {
      "data": [
