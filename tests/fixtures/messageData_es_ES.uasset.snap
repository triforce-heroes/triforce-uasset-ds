        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 1122,
    "idSub": 2681,
    "message": "¡Me llevé una sorpresa cuando llegaste a la casa! Te eché un vistazo y no me podía creer que hubiesen dejado entrar a semejante mostrenco.",
  },
  "APK_Main11_Talk:2682" => {
    "attribute": {
      "data": [
