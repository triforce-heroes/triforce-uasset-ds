        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4576,
    "idSub": 1411,
    "message": "Mi hermanita lo ha dado todo con ese cerebro de cacahuete que tiene. Voy a tener que destrozar a sus acosadores.",
  },
  "FamousSaying:1421" => {
    "attribute": {
      "data": [
