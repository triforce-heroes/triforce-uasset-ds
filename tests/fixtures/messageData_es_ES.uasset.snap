    },
    "id": 10022,
    "idSub": 11,
    "message": "Se sumarán puntos del cuerpo en función del total conseguido al ganar partidas clasificatorias. ¡Intenta llegar al rango más alto de pilar!",
  },
  "Tutorial_APK2_DLC_Title_0040:11" => {
