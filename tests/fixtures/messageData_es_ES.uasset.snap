      "type": "Buffer",
    },
    "id": 1122,
    "idSub": 3711,
    "message": "¿Te has enterado? La chica nueva de Casa Tokitō tiene una cicatriz enorme en la frente. La tenía escondida bajo el maquillaje.",
  },
  "APK_Main11_Talk:3712" => {
    "attribute": {
      "data": [
