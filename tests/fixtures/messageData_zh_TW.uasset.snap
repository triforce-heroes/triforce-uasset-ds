      "type": "Buffer",
    },
    "id": 8168,
    "idSub": 0,
    "message": "我們完成鼓之宅院的任務後，在紫藤花家紋的家
暫時停留，當我們要離開時……",
  },
  "PictureBook_Line_0030:0" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
