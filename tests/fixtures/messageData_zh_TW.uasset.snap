      ],
      "type": "Buffer",
    },
    "id": 2418,
    "idSub": 0,
    "message": "據說煉獄大人的訓練非常嚴苛，
但甘露寺大人卻毫無怨言。",
  },
  "APK_Main20_Talk_0702:0" => {
    "attribute": {
      "data": [
