        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2428,
    "idSub": 0,
    "message": "柱果然厲害！
那種動作我肯定做不到。",
  },
  "APK_Main20_Talk_0800:0" => {
    "attribute": {
      "data": [
