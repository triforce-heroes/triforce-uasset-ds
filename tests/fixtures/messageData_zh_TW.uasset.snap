        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1391,
    "message": "我好不甘心，好不甘心，快想想辦法啊，哥哥！！",
  },
  "FamousSaying:1401" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        139,
        0,
        0,
        0,
        11,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1401,
    "message": "我不離開！！我絕對不會離開，我要永遠和你在一起！！不論投胎轉世多少次，我都要成為哥哥的妹妹！！",
  },
  "FamousSaying:1411" => {
    "attribute": {
      "data": [
