        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2432,
    "idSub": 0,
    "message": "我之前看到一個令人意外的場景，戀柱和蛇柱
居然在一起吃飯，沒想到他們這麼要好。",
  },
  "APK_Main20_Talk_0811:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        99,
        0,
        0,
        0,
        113,
        23,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2433,
    "idSub": 0,
    "message": "什麼？你看錯了吧？
他們個性不是天差地遠嗎？",
  },
  "APK_Main20_Talk_0812:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        62,
