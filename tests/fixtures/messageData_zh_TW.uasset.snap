        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1211,
    "message": "你什麼都沒有學到！你根本沒把那些變成自己的東西！！",
  },
  "FamousSaying:1221" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
