        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2356,
    "idSub": 0,
    "message": "之前能接受柱指導的只有繼子。",
  },
  "APK_Main20_Talk_0511:0" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
