        0,
        0,
        219,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 208,
    "idSub": 0,
    "message": "遵照您的命令，已經解決掉其中一名柱。
請您放心……",
  },
  "APK2_BSG01_MemoryFragment_001_0030:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        2,
        0,
        0,
        0,
        71,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 209,
    "idSub": 0,
    "message": "看來你好像誤會了什麼啊，
猗窩座。",
  },
  "APK2_BSG01_MemoryFragment_001_0040:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        3,
