      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1531,
    "message": "真……真令人不爽！！連我都不曾這麼專心過！！感覺我身為藝術家輸給了他！！",
  },
  "FamousSaying:1541" => {
    "attribute": {
