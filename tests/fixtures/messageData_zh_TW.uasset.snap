      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1431,
    "message": "不管來多少個小角色，都不可能迎接幸福的未來。",
  },
  "FamousSaying:1441" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
