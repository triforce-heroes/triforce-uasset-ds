  "Tutorial_APK2_DLC_Title_0010:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10276,
    "idSub": 11,
    "message": "關於自由對戰",
  },
  "Tutorial_APK2_DLC_text_0010:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10267,
    "idSub": 11,
    "message": "自由對戰能夠不指定條件，
立即尋找可配對的對手展開對戰。
推薦在想要輕鬆對戰時遊玩。",
  },
  "Tutorial_APK2_DLC_Title_0020:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10277,
    "idSub": 11,
    "message": "關於積分對戰",
  },
  "Tutorial_APK2_DLC_text_0020:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10268,
    "idSub": 11,
    "message": "收集對戰獲勝時獲得的「級別點數」與「階級點數」，
並以此競爭點數多寡的模式。
排名以每個月份為一賽季舉行。",
  },
  "Tutorial_APK2_DLC_text_0020:21" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10268,
    "idSub": 21,
    "message": "敗北會減少「級別點數」。
「階級點數」不分賽季皆可累積，
即便敗北也不會減少。",
  },
  "Tutorial_APK2_DLC_Title_0030:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10278,
    "idSub": 11,
    "message": "關於階級",
  },
  "Tutorial_APK2_DLC_text_0030:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10269,
    "idSub": 11,
    "message": "透過累積積分對戰獲勝時獲得的「階級點數」，
階級也會隨之提升。
努力成為最高位階的「柱」吧。",
  },
  "Tutorial_APK2_DLC_Title_0040:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10279,
    "idSub": 11,
    "message": "關於可武裝的積分對戰",
  },
  "Tutorial_APK2_DLC_text_0040:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10270,
    "idSub": 11,
    "message": "與一般的積分對戰不同，此模式將以可武裝的狀態對戰。
這是收集「可武裝級別點數」，並以此競爭點數多寡的模式。
熟練使用武裝，努力達到上級級別吧。",
  },
  "Tutorial_APK2_DLC_Title_0050:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10280,
    "idSub": 11,
    "message": "關於級別",
  },
  "Tutorial_APK2_DLC_text_0050:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10271,
    "idSub": 11,
    "message": "級別會依據該賽季
獲得的「級別點數」變動。
敗北時會減少點數，級別可能會因此下降。",
  },
  "Tutorial_APK2_DLC_text_0050:21" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10271,
    "idSub": 21,
    "message": "級別會在賽季結束後重置。
下一賽季開啟後也努力達到上級級別吧。",
  },
  "Tutorial_APK2_DLC_Title_0060:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10281,
    "idSub": 11,
    "message": "關於生日活動",
  },
  "Tutorial_APK2_DLC_text_0060:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10272,
    "idSub": 11,
    "message": "角色生日前後時會舉辦的活動。
積分對戰中可以收集「活動點數」
來獲取道具。",
  },
  "Tutorial_APK2_DLC_text_0060:21" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10272,
    "idSub": 21,
    "message": "使用生日角色可以獲得額外獎勵點數，
將能獲得更多點數。",
  },
  "Tutorial_APK2_DLC_Title_0090:11" => {
