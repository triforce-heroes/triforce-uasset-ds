      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1341,
    "message": "人類還真是悲慘的生物，不管再怎麼努力也不過如此，我都有點同情了。",
  },
  "FamousSaying:1351" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
