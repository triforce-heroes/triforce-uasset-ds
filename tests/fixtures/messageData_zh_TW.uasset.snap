        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1521,
    "message": "要把你做成怎樣的作品呢？真令人興奮。",
  },
  "FamousSaying:1531" => {
    "attribute": {
      "data": [
        0,
        9,
