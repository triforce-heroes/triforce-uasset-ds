    "id": 2330,
    "idSub": 1914,
    "message": "你對我抱怨根本就沒用！
要講就去跟想出這種訓練的蛇柱說啊！",
  },
  "APK_Main20_Talk:1915" => {
    "attribute": {
      "data": [
