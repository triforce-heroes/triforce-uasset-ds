        0,
      ],
      "type": "Buffer",
    },
    "id": 2419,
    "idSub": 0,
    "message": "接受那位煉獄大人的訓練卻毫無怨言，
甘露寺大人真是了不起。",
  },
  "APK_Main20_Talk_0710:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        157,
        0,
        0,
        0,
        108,
        23,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2420,
    "idSub": 0,
    "message": "我之前在餐廳看到戀柱，
讓我大吃一驚。",
  },
  "APK_Main20_Talk_0711:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        189,
        0,
        0,
        0,
        109,
        23,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2421,
    "idSub": 0,
    "message": "為什麼？柱也是會吃飯的吧。",
  },
  "APK_Main20_Talk_0712:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        151,
