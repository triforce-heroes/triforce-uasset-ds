        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 247,
    "idSub": 0,
    "message": "妳們只要想著保命就好。
不管要放棄什麼事情，都先回來找我就對了。",
  },
  "APK2_BSG01_MemoryFragment_007_0030:0" => {
    "attribute": {
