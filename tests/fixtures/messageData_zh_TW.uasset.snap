        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1471,
    "message": "我們兩個在一起就無敵了，不管寒冷還是餓肚子都小事一樁。說好囉，我會永遠陪著妳，絕對不離開。妳看，沒什麼好怕的吧。",
  },
  "FamousSaying:1481" => {
    "attribute": {
