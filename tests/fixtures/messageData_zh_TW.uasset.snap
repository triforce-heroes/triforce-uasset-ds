        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 8181,
    "idSub": 0,
    "message": "是看起來很好吃的便當。",
  },
  "PictureBook_Line_0160:0" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        238,
        26,
