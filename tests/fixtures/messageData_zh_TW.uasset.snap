        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 253,
    "idSub": 0,
    "message": "煉獄先生去世四個月後左右，
我收到了煉獄先生的父親……也就是槙壽郎先生的來信。",
  },
  "APK2_BSG01_MemoryFragment_008_0020:0" => {
    "attribute": {
