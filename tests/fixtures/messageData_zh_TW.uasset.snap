        0,
      ],
      "type": "Buffer",
    },
    "id": 2353,
    "idSub": 0,
    "message": "最近好像都沒有鬼出沒了。",
  },
  "APK_Main20_Talk_0501:0" => {
    "attribute": {
      "data": [
        0,
        9,
