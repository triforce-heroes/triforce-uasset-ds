    },
    "id": 17053,
    "idSub": 0,
    "message": "不能信任不能信任，
而且我最討厭的就是鬼。",
  },
  "V_P0015_V00_C00_TaishiHyo_0090:0" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        193,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 17054,
    "idSub": 0,
    "message": "人連綁都沒綁，我看了就頭痛。",
  },
  "V_P0016_V00_C00_TaishiHyo_0240:0" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        209,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 17272,
    "idSub": 0,
    "message": "想死的話儘管去死一死！
這根本算不上什麼保證！",
  },
  "V_P0016_V00_C00_TaishiHyo_0250:0" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        209,
        29,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 17273,
    "idSub": 0,
    "message": "主公大人……！！讓我來證明給您看！
鬼是多麼醜陋的東西！！",
  },
  "V_P0018_V00_C00_TaishiHyo_0080:0" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
