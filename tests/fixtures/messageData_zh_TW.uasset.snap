        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1451,
    "message": "只剩下他一人為什麼還不放棄！！為什麼不氣餒！！為什麼這股非打敗我不可的意志會這麼堅定！！",
  },
  "FamousSaying:1461" => {
    "attribute": {
      "data": [
