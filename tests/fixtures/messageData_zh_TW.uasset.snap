      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1311,
    "message": "囉哩囉嗦的真是煩死了，以前的事誰還記得啊。",
  },
  "FamousSaying:1321" => {
    "attribute": {
      "data": [
