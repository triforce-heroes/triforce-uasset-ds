        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1201,
    "message": "因為悲鳴嶼先生也不太會教，所以不好好看著偷學起來是不行的。",
  },
  "FamousSaying:1211" => {
    "attribute": {
      "data": [
