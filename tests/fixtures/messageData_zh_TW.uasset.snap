        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2442,
    "idSub": 0,
    "message": "你在說什麼傻話，
我告訴你，現實是殘酷的！",
  },
  "APK_Main20_Talk_0832:0" => {
    "attribute": {
