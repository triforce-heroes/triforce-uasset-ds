        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1231,
    "message": "你儘管放一百二十萬個心，我比你還強！！因為我能劈開岩石！！",
  },
  "FamousSaying:1241" => {
    "attribute": {
