      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1331,
    "message": "美麗又強悍的鬼想做什麼都可以……！！",
  },
  "FamousSaying:1341" => {
    "attribute": {
      "data": [
        0,
        9,
