  "StoryBoard_Message_0010:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9409,
    "idSub": 0,
    "message": "在鮮血四濺的遊郭中，一名劍士正在與鬼對峙。
對於鬼恣意踐踏、毫不尊重生命的惡行，
鬼殺隊隊員．竈門炭治郎的憤怒已達到最高點。",
  },
  "StoryBoard_Message_0020:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9410,
    "idSub": 0,
    "message": "──時光回溯，成為鬼殺隊員，在各地奔波的炭治郎寫了一封信，
向他的培育者鱗瀧報告近況，
鱗瀧從信中恭謹的文字感受到了炭治郎明確的決心。",
  },
  "StoryBoard_Message_0030:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9411,
    "idSub": 0,
    "message": "炭治郎站在細雨紛紛的山腳下，
他受命討伐潛伏於寺廟裡的鬼，
正準備踏上充滿泥濘的路途前往山上。",
  },
  "StoryBoard_Message_0040:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9412,
    "idSub": 0,
    "message": "炭治郎抵達山上的寺廟，找出了潛伏在該地的鬼。
面對凶猛的惡鬼，炭治郎與妹妹禰豆子一同迎戰。",
  },
  "StoryBoard_Message_0050:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9413,
    "idSub": 0,
    "message": "炭治郎成功剷除了鬼，迎著晨光下山，
與此同時，內心遙想著與妹妹一同漫步於陽光下的未來……",
  },
  "StoryBoard_Message_0060:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9414,
    "idSub": 0,
    "message": "回到蝴蝶屋的炭治郎遇見了音柱．宇髓天元。
宇髓計畫選出適合潛入遊郭的隊員，
對此，炭治郎提議由他與善逸、伊之助陪宇髓一同前去。",
  },
  "StoryBoard_Message_0070:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9415,
    "idSub": 0,
    "message": "宇髓針對潛入遊郭一事，與一行人召開了作戰會議，
他即將說明的目的究竟為何……？",
  },
  "StoryBoard_Message_0080:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9416,
    "idSub": 0,
    "message": "在潛入遊郭前的片刻時光，
炭治郎回想起了當初為了轉達炎柱．
煉獄杏壽郎的遺言，而前往其老家拜訪時所發生的事。",
  },
  "StoryBoard_Message_0090:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9417,
    "idSub": 0,
    "message": "在男人和女人顯露虛榮與慾望，
愛恨交織的不夜城──遊郭裡，
炭治郎一行人身著變裝後怪裡怪氣的打扮，走在紛紛攘攘的大街上……",
  },
  "StoryBoard_Message_0100:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9418,
    "idSub": 0,
    "message": "尋找宇髓的老婆是潛入遊郭的目的之一，
炭治郎等人因此分別被安排進入不同的遊女屋……",
  },
  "StoryBoard_Message_0110:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9419,
    "idSub": 0,
    "message": "進入荻本屋的豬子──也就是伊之助，
在遊女屋內四處進行調查，就在此時，
他聽到了可疑的傳聞……",
  },
  "StoryBoard_Message_0120:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9420,
    "idSub": 0,
    "message": "進入京極屋的善子──也就是善逸，起初不知為何
卯足了勁學習三味線，後來終於恢復理智，豎耳傾聽周遭的聲音。
此時，他聽見了女孩子哭泣的聲音……",
  },
  "StoryBoard_Message_0130:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9421,
    "idSub": 0,
    "message": "──善逸失蹤了，收到宇髓的通知後，
炭治郎和伊之助更加強烈地感受到鬼的存在。
以遊郭為舞台的決戰時刻正逐步逼近……",
  },
  "StoryBoard_Message_0140:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9422,
    "idSub": 0,
    "message": "炭治郎結束潛入調查，準備前往荻本屋並與在那待命的伊之助會合，
但在路途中，他卻聞到了令人驚駭的鬼的氣味。",
  },
  "StoryBoard_Message_0150:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9423,
    "idSub": 0,
    "message": "盤據於遊郭的鬼．墮姬終於現身，
面對上弦之鬼散發出來的壓倒性殺氣，
炭治郎克服恐懼，舉起了手中的刀。",
  },
  "StoryBoard_Message_0160:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9424,
    "idSub": 0,
    "message": "時間稍微回溯，
伊之助遲遲等不到炭治郎，
便率先展開行動，開始搜索鬼的密道。",
  },
  "StoryBoard_Message_0170:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9425,
    "idSub": 0,
    "message": "伊之助穿越密道一路前進，抵達了在遊郭地底
打造的巨大空洞，而盤據於此的鬼，
有著如同腰帶般的奇異樣貌……",
  },
  "StoryBoard_Message_0180:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9426,
    "idSub": 0,
    "message": "炭治郎與墮姬展開激戰，
此時逃出鬼巢穴的腰帶之鬼與墮姬融合，
使她搖身一變成為了完全體。",
  },
  "StoryBoard_Message_0190:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9427,
    "idSub": 0,
    "message": "炭治郎的呼吸達到極限，禰豆子為了拯救哥哥而現身戰場，
在這瞬息萬變的戰況之中，宇髓也趕到現場，
然而墮姬背上卻出現了另一隻鬼──",
  },
  "StoryBoard_Message_0200:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9428,
    "idSub": 0,
    "message": "宇髓與妓夫太郎展開了激烈的戰鬥。
另一方面，脫離戰場的炭治郎與善逸和伊之助會合，
並一同趕往宇髓的身邊。",
  },
  "StoryBoard_Message_0210:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9429,
    "idSub": 0,
    "message": "炭治郎等人趕到宇髓身邊加入戰局，
並且兵分兩路應戰，善逸和伊之助迎戰墮姬的同時，
炭治郎和宇髓也開始對抗妓夫太郎。",
  },
  "StoryBoard_Message_0220:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9430,
    "idSub": 0,
    "message": "鬼殺隊與鬼的激鬥邁入最終局面，
鬼殺隊即使陷入壓倒性的劣勢，
也依然奮戰不懈，最後的勝機終於來臨──",
  },
  "StoryBoard_Message_0230:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9431,
    "idSub": 0,
    "message": "耀哉聽聞上弦之陸已被消滅的消息，
感受到與鬼交戰的歷史
已萌生了變化的徵兆。",
  },
  "StoryBoard_Message_0240:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9432,
    "idSub": 0,
    "message": "歷經遊郭的激戰，
在蝴蝶屋休養的炭治郎做了一場夢。",
  },
  "StoryBoard_Message_0250:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9433,
    "idSub": 0,
    "message": "炭治郎的刀先前在戰鬥中折斷了，為了確認修繕進度，
他申請密訪刀匠村，在獲得許可之前，
只能暫時設法打發時間……",
  },
  "StoryBoard_Message_0260:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9434,
    "idSub": 0,
    "message": "炭治郎在度過一段平靜的時光後，
收到了來自鬼殺隊總部的信，那封信正是他期盼已久，
批准他拜訪刀匠村的許可信。",
  },
  "StoryBoard_Message_0270:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9435,
    "idSub": 0,
    "message": "炭治郎獲得拜訪刀匠村的許可後，
在隱的帶領下出發前往刀匠村。",
  },
  "StoryBoard_Message_0280:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9436,
    "idSub": 0,
    "message": "為了避免遭到鬼襲擊，刀匠村巧妙地隱藏了所在位置。
看著眼前充滿獨特風情的村落，炭治郎不禁發出讚嘆。",
  },
  "StoryBoard_Message_0290:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9437,
    "idSub": 0,
    "message": "炭治郎向刀匠村村長──鐵珍打過招呼後，
隨著嚮導參觀村子，此時……",
  },
  "StoryBoard_Message_0300:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9438,
    "idSub": 0,
    "message": "當炭治郎在刀匠村療養時，戀柱．甘露寺蜜璃
悄悄地告訴了他一個情報，據說在這座村子裡，
有著某種祕密武器……",
  },
  "StoryBoard_Message_0310:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9439,
    "idSub": 0,
    "message": "炭治郎在尋找祕密武器時，撞見了爭論不休的霞柱．時透無一郎
和小鐵。對無一郎懷恨在心的小鐵為了報復他，
便運用名為緣壹零式的機關人偶對炭治郎展開特訓……",
  },
  "StoryBoard_Message_0320:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9440,
    "idSub": 0,
    "message": "炭治郎完成與機關人偶的特訓後，在住宿處和無一郎交談。
此時……一隻身軀佝僂的鬼現身了，
他名叫半天狗──是擁有上弦之肆名號的鬼。",
  },
  "StoryBoard_Message_0330:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9441,
    "idSub": 0,
    "message": "無一郎遭到半天狗分裂出的可樂攻擊，
被轟飛到森林之中，
他在那裡遇見了正在遭受鬼襲擊的小鐵。",
  },
  "StoryBoard_Message_0340:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9442,
    "idSub": 0,
    "message": "刀匠村遭到鬼的襲擊而瀕臨毀滅，
在村子面臨生死存亡之際，蜜璃趕到了現場。",
  },
  "StoryBoard_Message_0350:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9443,
    "idSub": 0,
    "message": "與上弦之伍．玉壺交手的過程中，
無一郎找回了自己的記憶。
他想起了關於父母的回憶，還有他親愛的哥哥──有一郎……",
  },
  "StoryBoard_Message_0360:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9444,
    "idSub": 0,
    "message": "顯現真面目的玉壺將無一郎玩弄於股掌之間，
然而找回記憶的無一郎內心一絲不亂，
平靜地將手中的刀揮向鬼的脖子──",
  },
  "StoryBoard_Message_0370:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9445,
    "idSub": 0,
    "message": "雖然斬斷了玉壺的脖子，
但無一郎也因身體達到極限而倒地，
此時他聽見了家人的聲音……",
  },
  "StoryBoard_Message_0380:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9446,
    "idSub": 0,
    "message": "炭治郎等人與半天狗的戰況極為嚴峻，
面對會分裂的半天狗，炭治郎屈居劣勢。
他不慎露出一瞬間的破綻，遭趁隙而來的攻擊轟到森林之中。",
  },
  "StoryBoard_Message_0390:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9447,
    "idSub": 0,
    "message": "被轟到森林的炭治郎聞到了另一名隊員的氣味，
那股氣味來自與他同屆的不死川玄彌，
他也正在與分裂的半天狗交戰。",
  },
  "StoryBoard_Message_0400:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9448,
    "idSub": 0,
    "message": "炭治郎找到了被埋在瓦礫之下的禰豆子，
為了對抗步步逼近的強敵，無法動彈的禰豆子將手伸向炭治郎的刀，
用自己的血讓炭治郎的刀化為爆血刀。",
  },
  "StoryBoard_Message_0410:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9449,
    "idSub": 0,
    "message": "在炭治郎、禰豆子和玄彌的奮戰之下，半天狗終於被逼入了絕境。
然而他卻融合了分裂出去的身體，
化身成憎珀天，扭轉了戰況。",
  },
  "StoryBoard_Message_0420:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9450,
    "idSub": 0,
    "message": "憎珀天的攻勢使炭治郎一行人陷入苦戰，
此時蜜璃趕到，與憎珀天正面交鋒，
在愈發白熱化的激戰中，蜜璃的身體出現了變化……",
  },
  "StoryBoard_Message_0430:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9451,
    "idSub": 0,
    "message": "炭治郎在戰鬥中察覺到了另一個半天狗的存在。
經過聚精會神地找尋，總算掌握鬼的位置，
炭治郎借助夥伴們的力量，朝鬼揮出手中的刀刃……！",
  },
  "StoryBoard_Message_0440:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9452,
    "idSub": 0,
    "message": "即使不斷追殺，半天狗依然設法逃亡，
此時旭日升起，陽光開始灼燒禰豆子。
要殺鬼？還是要保護禰豆子？炭治郎的內心天人交戰。",
  },
  "StoryBoard_Message_0450:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9453,
    "idSub": 0,
    "message": "在禰豆子的行動促使下，炭治郎成功討伐了半天狗。
正當他因禰豆子的犧牲難過落淚時──",
  },
  "StoryBoard_Message_0460:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9454,
    "idSub": 0,
    "message": "刀匠村發生的事令無慘欣喜若狂，
如今禰豆子已克服陽光，
爭奪禰豆子的激烈大戰也即將展開……",
  },
  "StoryBoard_Message_0470:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9455,
    "idSub": 0,
    "message": "善逸為了探望炭治郎而造訪蝴蝶屋，
見到了克服陽光的禰豆子。",
  },
  "StoryBoard_Message_0480:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9456,
    "idSub": 0,
    "message": "善逸滔滔不絕地向克服陽光的禰豆子
傾訴自己的愛意之後，
想起了自己原本的目的是探望炭治郎。",
  },
  "StoryBoard_Message_0490:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9457,
    "idSub": 0,
    "message": "善逸來到炭治郎的病床邊，
兩人開心地交談，
度過了一段平靜的時光……",
  },
  "StoryBoard_Message_0500:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9458,
    "idSub": 0,
    "message": "在一個明月高掛的夜晚，風柱．不死川實彌
與蛇柱．伊黑小芭內正伺探著某座古城，
而鬼似乎就盤據其中……",
  },
  "StoryBoard_Message_0510:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9459,
    "idSub": 0,
    "message": "實彌和小芭內在古城裡看到了成群的鬼，
兩名柱感覺此異象背後有某種陰謀，
同時舉起了刀劍，面對眼前的眾多惡鬼。",
  },
  "StoryBoard_Message_0520:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9460,
    "idSub": 0,
    "message": "兩名柱為了追殺鬼而登上天守閣，卻對眼前的景象大為吃驚，
那裡有個與古城景色截然不同的神祕空間，
實彌對逃進裡面的鬼揮下了手中的刀，然而──",
  },
  "StoryBoard_Message_0530:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9461,
    "idSub": 0,
    "message": "在經歷刀匠村的事件之後，鬼殺隊召開了柱合會議，
眾人針對「出現印記」一事進行討論，
並提議舉行柱訓練以迎接即將到來的大戰。",
  },
  "StoryBoard_Message_0540:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9462,
    "idSub": 0,
    "message": "柱訓練開始了，然而水柱．富岡義勇卻拒絕參加。
炭治郎不屈不撓地多次嘗試與他交談，
義勇終於被炭治郎的毅力所折服……",
  },
  "StoryBoard_Message_0550:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9463,
    "idSub": 0,
    "message": "柱訓練開始數日後，
傷勢痊癒的炭治郎終於能如願參加柱訓練，
他開始挑戰由宇髓負責指導的基礎體力提升訓練，接著──",
  },
  "StoryBoard_Message_0560:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9464,
    "idSub": 0,
    "message": "完成宇髓的訓練後，炭治郎接著來到無一郎宅邸。
他在無一郎嚴厲又一針見血的指導下，
努力學習著高速移動。",
  },
  "StoryBoard_Message_0570:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9465,
    "idSub": 0,
    "message": "得到無一郎的合格認可後，炭治郎前往甘露寺宅邸。
蜜璃負責的是柔軟度訓練，但是與字面上的「柔軟」不同，
以蠻力強硬進行的訓練伴隨著地獄般的苦痛……",
  },
  "StoryBoard_Message_0580:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9466,
    "idSub": 0,
    "message": "完成蜜璃的柔軟度訓練後，炭治郎來到了伊黑宅邸，
他一邊忍受著伊黑接二連三地惡言相向，
一邊接受刀法的矯正。",
  },
  "StoryBoard_Message_0590:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9467,
    "idSub": 0,
    "message": "在伊黑宅邸，
炭治郎看到伊黑夜間外出便尾隨其後，
最後他看到三名柱聚集在一起……",
  },
  "StoryBoard_Message_0600:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9468,
    "idSub": 0,
    "message": "完成伊黑的刀法矯正後，
炭治郎為接受下一個訓練而前往不死川宅邸……",
  },
  "StoryBoard_Message_0610:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9469,
    "idSub": 0,
    "message": "實彌的訓練讓隊員們瑟瑟發抖，
炭治郎死命地接下攻擊，
但實彌無情的攻勢卻毫無歇息的跡象……",
  },
  "StoryBoard_Message_0620:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9470,
    "idSub": 0,
    "message": "實彌的訓練因故終止，炭治郎前往接受岩柱．悲鳴嶼行冥的指導。
悲鳴嶼的訓練課題是肌肉強化訓練，雖然內容單純，
但對身體的負荷很大，隊員們都陷入了苦戰。",
  },
  "StoryBoard_Message_0630:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9471,
    "idSub": 0,
    "message": "完成悲鳴嶼的訓練課題後，炭治郎終於要挑戰最後一場訓練，
他為此一步步走向富岡宅邸。",
  },
  "StoryBoard_Message_0640:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9472,
    "idSub": 0,
    "message": "最終試煉是與義勇一對一比試──
回想至今習得的修練成果，
朝義勇使出渾身解數的一擊……！",
  },
  "StoryBoard_Message_0650:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9473,
    "idSub": 0,
    "message": "無慘現身於產屋敷宅邸，
接獲緊急通知的柱們同時飛奔而至，
將刀揮向了宿敵，但是……",
  },
