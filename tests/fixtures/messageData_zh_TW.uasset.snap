      ],
      "type": "Buffer",
    },
    "id": 2365,
    "idSub": 0,
    "message": "你看過宇髓先生的烏鴉嗎？
很誇張對吧？",
  },
  "APK_Main20_Talk_0541:0" => {
    "attribute": {
      "data": [
