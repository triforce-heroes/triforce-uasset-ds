      "type": "Buffer",
    },
    "id": 2364,
    "idSub": 0,
    "message": "沒人能保證鬼真的不會出沒，
所以目前還是得繼續夜間巡邏跟警備工作。",
  },
  "APK_Main20_Talk_0540:0" => {
    "attribute": {
      "data": [
