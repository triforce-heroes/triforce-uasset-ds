      ],
      "type": "Buffer",
    },
    "id": 1598,
    "idSub": 0,
    "message": "我感覺自己一直遇到這種倒楣事！這是怎樣！？
我的待遇也太差了吧！！",
  },
  "APK_Main14_Talk_0573:0" => {
    "attribute": {
      "data": [
