        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2361,
    "idSub": 0,
    "message": "當柱真的很辛苦。",
  },
  "APK_Main20_Talk_0530:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
