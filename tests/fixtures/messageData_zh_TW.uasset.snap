      ],
      "type": "Buffer",
    },
    "id": 8184,
    "idSub": 0,
    "message": "是看起來很好吃的烏龍麵。",
  },
  "PictureBook_Line_0190:0" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
