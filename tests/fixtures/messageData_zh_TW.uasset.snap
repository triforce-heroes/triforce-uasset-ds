  },
  "Tutorial_title_0093_02:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10684,
    "idSub": 0,
    "message": "關於房間對戰　其之參",
  },
  "Tutorial_text_0093_00:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10569,
    "idSub": 0,
    "message": "房間對戰最多可以集合8人
在同個房間內對戰喔。
當其中2人進行對戰時，
其他玩家則會在旁觀戰。
若觀戰中想離開房間的話，就按下<kcId_kcId_Battle_Pause/>退出吧。

在房間對戰不會使級別點數增減喔。

另外，在房間內有2人以上的狀態下，
如果10分鐘內沒進行對戰的話，
房間便會自動解散喔。",
  },
  "Tutorial_text_0093_01:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10570,
    "idSub": 0,
    "message": "「設定條件進入房間」
　　設定條件搜尋可進入的房間。
　　若找不到房間，
　　可以自己建立房間。
　　在此建立的房間，任何人皆可進入。
　　想與隨機的對手遊玩時就選擇這個方法吧。",
  },
  "Tutorial_text_0093_02:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10571,
    "idSub": 0,
    "message": "「建立私人房間」
　　設定條件建立房間。
　　房間會被分配12碼的房間號碼。
　　在此建立的房間，
　　可透過「搜尋私人房間號碼」搜尋。
　　想與特定對象遊玩時就選擇這個方法吧。

「搜尋私人房間號碼」
　　輸入在「建立私人房間」時
　　取得的12碼房間號碼，
　　便能以該號碼進入房間。",
  },
