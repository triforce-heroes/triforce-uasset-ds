        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2354,
    "idSub": 0,
    "message": "聽說是跟一個叫禰豆子的女孩有關，
但具體原因是什麼就沒人知道了。",
  },
  "APK_Main20_Talk_0502:0" => {
    "attribute": {
      "data": [
