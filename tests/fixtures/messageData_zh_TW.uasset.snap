      "type": "Buffer",
    },
    "id": 2437,
    "idSub": 0,
    "message": "你不覺得戀柱的烏鴉滿可愛的嗎？",
  },
  "APK_Main20_Talk_0821:0" => {
    "attribute": {
      "data": [
