        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2359,
    "idSub": 0,
    "message": "柱負責的警備區域範圍很大，
而且還要收集情報跟自我鍛鍊，所以柱非常忙碌。",
  },
  "APK_Main20_Talk_0521:0" => {
    "attribute": {
      "data": [
