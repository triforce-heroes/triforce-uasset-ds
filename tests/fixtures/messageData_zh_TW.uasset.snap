      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1491,
    "message": "你對自己的軟弱感到很不甘心吧？人在感嘆的時候習慣仰望天空，為了不讓眼淚流出來。",
  },
  "FamousSaying:1501" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
