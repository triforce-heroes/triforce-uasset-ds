        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1221,
    "message": "給我進步！！如果你還是個男人的話！！如果你生為男人的話！除了進步沒別條路！！",
  },
  "FamousSaying:1231" => {
    "attribute": {
      "data": [
