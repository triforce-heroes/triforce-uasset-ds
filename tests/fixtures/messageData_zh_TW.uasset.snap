        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1371,
    "message": "沒有人能活到天亮！漫長的夜晚永遠都站在我們這邊。",
  },
  "FamousSaying:1381" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        137,
        0,
        0,
        0,
        11,
        31,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1381,
    "message": "去死！！去死！！所有人都去死！！嗚哇啊啊啊啊啊啊！！頭被砍斷了，我的頭被砍斷了啦──哥哥──────！！",
  },
  "FamousSaying:1391" => {
    "attribute": {
      "data": [
