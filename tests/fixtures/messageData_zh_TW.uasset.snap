        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2435,
    "idSub": 0,
    "message": "戀柱跟蛇柱……
那兩個人怎麼可能很要好嘛。",
  },
  "APK_Main20_Talk_0814:0" => {
    "attribute": {
