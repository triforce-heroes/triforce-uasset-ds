      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1321,
    "message": "妳以為這間店是靠誰賺的錢，才變得如此繁榮的，老太婆。",
  },
  "FamousSaying:1331" => {
    "attribute": {
