      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 2401,
    "message": "萬一禰豆子襲擊人類，竈門炭治郎以及鱗瀧左近次、富岡義勇將切腹謝罪以示負責。",
  },
  "FamousSaying:2411" => {
    "attribute": {
