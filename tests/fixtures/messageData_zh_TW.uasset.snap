        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2363,
    "idSub": 0,
    "message": "但柱跟我們都還是有在做夜間巡邏跟警備工作，
因為沒人能保證鬼是真的不會出現。",
  },
  "APK_Main20_Talk_0532:0" => {
    "attribute": {
      "data": [
        0,
        9,
