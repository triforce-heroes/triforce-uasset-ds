      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1351,
    "message": "真惹人憐愛，雖然長得很醜，總覺得有點戀戀不捨了。你啊，就好像快死的老鼠一樣。",
  },
  "FamousSaying:1361" => {
    "attribute": {
      "data": [
        0,
        9,
