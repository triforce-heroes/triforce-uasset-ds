        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1501,
    "message": "給我一遍又一遍地死去吧，我的名字叫做妓夫太郎！！",
  },
  "FamousSaying:1511" => {
    "attribute": {
      "data": [
