        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 2411,
    "message": "他到底有什麼企圖？產屋敷……是想騙我什麼？",
  },
  "FamousSaying:2421" => {
    "attribute": {
      "data": [
