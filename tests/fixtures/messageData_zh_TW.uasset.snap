      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 2421,
    "message": "要身為鬼的我，去鬼殺隊的據點……！？",
  },
  "FamousSaying:2431" => {
    "attribute": {
      "data": [
        0,
        9,
