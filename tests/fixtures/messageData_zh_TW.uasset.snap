        255,
        255,
        110,
        23,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2427,
    "idSub": 0,
    "message": "然後她就實際表演了一次給我看。
她咻咻幾下就把刀收好了，讓我大開眼界！",
  },
  "APK_Main20_Talk_0722:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        28,
