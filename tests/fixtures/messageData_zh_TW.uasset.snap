        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2362,
    "idSub": 0,
    "message": "自從鬼不再出沒後，
我們才得以像現在這樣接受訓練……",
  },
  "APK_Main20_Talk_0531:0" => {
    "attribute": {
      "data": [
