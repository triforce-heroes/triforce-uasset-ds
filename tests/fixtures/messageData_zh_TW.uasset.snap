        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1441,
    "message": "你真是太沒用了！這不是完全沒保護到妹妹嗎！！",
  },
  "FamousSaying:1451" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        144,
        0,
        0,
        0,
