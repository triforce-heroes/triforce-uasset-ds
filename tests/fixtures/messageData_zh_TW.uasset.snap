      "type": "Buffer",
    },
    "id": 2330,
    "idSub": 1913,
    "message": "你說什麼！？我是不能有意見喔！",
  },
  "APK_Main20_Talk:1914" => {
    "attribute": {
      "data": [
        0,
        9,
