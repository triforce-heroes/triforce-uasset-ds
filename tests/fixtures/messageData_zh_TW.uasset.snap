        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 254,
    "idSub": 0,
    "message": "竈門，之前對你失禮了。
謝謝你為了杏壽郎而哭。",
  },
  "APK2_BSG01_MemoryFragment_008_0030:0" => {
    "attribute": {
