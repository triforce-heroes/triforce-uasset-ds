        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2434,
    "idSub": 0,
    "message": "所以我才覺得意外啊！而且戀柱
看起來還跟那個蛇柱聊得很開心耶！？",
  },
  "APK_Main20_Talk_0813:0" => {
    "attribute": {
      "data": [
