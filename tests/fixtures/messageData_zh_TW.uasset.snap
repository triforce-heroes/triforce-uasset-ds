        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1241,
    "message": "過了半年……你的表情終於像個男人了。",
  },
  "FamousSaying:1251" => {
    "attribute": {
      "data": [
