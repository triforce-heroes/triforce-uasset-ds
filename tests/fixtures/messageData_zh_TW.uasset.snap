      "type": "Buffer",
    },
    "id": 2367,
    "idSub": 0,
    "message": "宇髓先生本人打扮就很華麗，
烏鴉當然也跟主人一樣囉。",
  },
  "APK_Main20_Talk_0543:0" => {
    "attribute": {
      "data": [
