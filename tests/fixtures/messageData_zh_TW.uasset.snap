      ],
      "type": "Buffer",
    },
    "id": 207,
    "idSub": 0,
    "message": "在解決杏壽郎之後，
我前去向無慘大人報告。",
  },
  "APK2_BSG01_MemoryFragment_001_0020:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        1,
