        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2357,
    "idSub": 0,
    "message": "而現在所有鬼殺隊員都可以接受指導！
這可是千載難逢的機會！！",
  },
  "APK_Main20_Talk_0512:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        57,
        0,
        0,
        0,
        86,
        23,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2358,
    "idSub": 0,
    "message": "我要把柱的技術好好學起來！
不然就太對不起抽空訓練我們的柱了！！",
  },
  "APK_Main20_Talk_0520:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        64,
