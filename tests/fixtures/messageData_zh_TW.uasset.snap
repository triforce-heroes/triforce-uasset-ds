        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1411,
    "message": "我可愛的妹妹用她那愚笨的腦袋努力在做事，欺負她的傢伙們我會通通殺掉。",
  },
  "FamousSaying:1421" => {
    "attribute": {
