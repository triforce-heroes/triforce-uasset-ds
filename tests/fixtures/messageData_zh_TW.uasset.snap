      ],
      "type": "Buffer",
    },
    "id": 2417,
    "idSub": 0,
    "message": "聽說甘露寺大人以前
曾接受過煉獄大人的訓練。",
  },
  "APK_Main20_Talk_0701:0" => {
    "attribute": {
      "data": [
