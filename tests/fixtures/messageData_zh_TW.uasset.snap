        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2330,
    "idSub": 1912,
    "message": "我又不是故意要打中你的！
而且被綁在上面的人就別抱怨了！",
  },
  "APK_Main20_Talk:1913" => {
    "attribute": {
      "data": [
