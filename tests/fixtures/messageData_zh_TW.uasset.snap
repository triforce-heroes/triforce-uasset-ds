  "TaishoRumorContent_0001:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9814,
    "idSub": 0,
    "message": "炭治郎的鎹鴉名叫
「天王寺松右衛門」。",
  },
  "TaishoRumorContent_0004:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9815,
    "idSub": 0,
    "message": "由於善逸不想去參加最終選拔，
因此惹了他的師父生氣，還被甩了好幾次巴掌。",
  },
  "TaishoRumorContent_0057:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9816,
    "idSub": 0,
    "message": "鱗瀧之所以戴著面具，是因為他的長相
十分和藹可親，讓他老是被鬼嘲笑。",
  },
  "TaishoRumorContent_0058:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9817,
    "idSub": 0,
    "message": "沼鬼的磨牙是他還身為人類時就有的習慣。",
  },
  "TaishoRumorContent_0059:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9818,
    "idSub": 0,
    "message": "愈史郎的興趣是寫「珠世大人日記」。
一天至少會寫上七到十頁的內容。",
  },
  "TaishoRumorContent_0060:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9819,
    "idSub": 0,
    "message": "矢琶羽和朱紗丸是在與炭治郎等人戰鬥的當天第一次碰面。
他們是在抵達珠世的診所前的
途中聊天才變熟的。",
  },
  "TaishoRumorContent_0061:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9820,
    "idSub": 0,
    "message": "基本上只要對象是女孩子，
不管是誰善逸都會非常在意並對她春心蕩漾。",
  },
  "TaishoRumorContent_0062:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9821,
    "idSub": 0,
    "message": "響凱非常喜歡瀧澤馬琴所著的「里見八犬傳」，
並受其影響而開始寫傳奇小說。",
  },
  "TaishoRumorContent_0063:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9822,
    "idSub": 0,
    "message": "鎹雀的名字叫「五加木」，
喜歡的食物是五加木飯。
但善逸對此並不知情，
總是餵牠豆子當飼料。",
  },
  "TaishoRumorContent_0064:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9823,
    "idSub": 0,
    "message": "伊之助叫別人的名字時，
大約每叫七次會有一次叫對。",
  },
  "TaishoRumorContent_0065:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9824,
    "idSub": 0,
    "message": "炭治郎喜歡吃梅子昆布飯糰，善逸則喜歡吃鮭魚飯糰。",
  },
  "TaishoRumorContent_0066:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9825,
    "idSub": 0,
    "message": "在炭治郎還是小孩子時，
他的雙親都會在祭典結束後烤仙貝給孩子吃。",
  },
  "TaishoRumorContent_0067:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9826,
    "idSub": 0,
    "message": "忍會在刀鞘裡調配刀上的毒，
刀鞘內的機關只有忍跟負責的刀匠才知道。",
  },
  "TaishoRumorContent_0068:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9827,
    "idSub": 0,
    "message": "忍會害怕貓和狗等
全身長滿毛的生物。",
  },
  "TaishoRumorContent_0069:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9828,
    "idSub": 0,
    "message": "在柱合會議時，
柱對耀哉的問候是先說的人先贏。",
  },
  "TaishoRumorContent_0070:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9829,
    "idSub": 0,
    "message": "耀哉是鬼殺隊的第九十七代當家。",
  },
  "TaishoRumorContent_0071:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9830,
    "idSub": 0,
    "message": "小葵有接受過忍的指導，
所以能調配簡單的藥物。",
  },
  "TaishoRumorContent_0072:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9831,
    "idSub": 0,
    "message": "把在蝴蝶屋的反射訓練中使用的藥水倒入浴池，
會產生消除疲勞和加速傷勢復原的效果。",
  },
