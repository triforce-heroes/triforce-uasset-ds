      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1461,
    "message": "為什麼呢？不是說「夫禍之與福兮，何異糾纆」嗎？好事和壞事倒是給我輪著來啊。",
  },
  "FamousSaying:1471" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        146,
        0,
        0,
        0,
