        0,
        0,
        108,
        23,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2422,
    "idSub": 0,
    "message": "那是因為她吃了八份蕎麥麵、九碗丼飯和六碟小菜，
而且還在繼續吃。很驚人吧？",
  },
  "APK_Main20_Talk_0713:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        183,
        0,
        0,
        0,
        109,
        23,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2423,
    "idSub": 0,
    "message": "的確很驚人。",
  },
  "APK_Main20_Talk_0714:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        153,
        0,
        0,
        0,
        108,
        23,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2424,
    "idSub": 0,
    "message": "我就沒辦法吃那麼多，
那該不會是戀柱強大的祕訣吧？",
  },
  "APK_Main20_Talk_0715:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        199,
        0,
        0,
        0,
        109,
        23,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2425,
    "idSub": 0,
    "message": "我也不行，
八份蕎麥麵和九碗丼飯……唔噁。",
  },
  "APK_Main20_Talk_0720:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        11,
        0,
        0,
        0,
        110,
        23,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2426,
    "idSub": 0,
    "message": "戀柱的刀不是像緞帶一樣嗎？
我之前有問她都是如何把刀收進刀鞘的。",
  },
  "APK_Main20_Talk_0721:0" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
