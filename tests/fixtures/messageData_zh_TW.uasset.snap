    "id": 4734,
    "idSub": 1291,
    "message": "你姊姊犧牲了性命才保住的生命，還有託付給你的未來，你都要延續下去啊，義勇。",
  },
  "FamousSaying:1301" => {
    "attribute": {
      "data": [
