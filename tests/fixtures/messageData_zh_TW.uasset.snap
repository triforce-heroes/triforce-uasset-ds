        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 7033,
    "idSub": 0,
    "message": "剛使出觸發攻擊時為無敵狀態。
觸發攻擊命中後會進入專用演出。",
  },
  "P0001_V01_C11_SkillInfo_0040:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
