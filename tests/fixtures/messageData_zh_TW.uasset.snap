      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1261,
    "message": "說不定會輸，也說不定會贏。不過，這當中有一個事實。",
  },
  "FamousSaying:1271" => {
    "attribute": {
      "data": [
