      ],
      "type": "Buffer",
    },
    "id": 2330,
    "idSub": 1915,
    "message": "你白痴喔！！我怎麼可能
敢跟他講，那樣太恐怖了！！",
  },
  "APK_Main20_Talk:1916" => {
    "attribute": {
