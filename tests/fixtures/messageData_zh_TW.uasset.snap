      "type": "Buffer",
    },
    "id": 255,
    "idSub": 0,
    "message": "杏壽郎跟我不一樣，是一位很優秀的兒子。",
  },
  "APK2_BSG01_MemoryFragment_008_0040:0" => {
    "attribute": {
      "data": [
