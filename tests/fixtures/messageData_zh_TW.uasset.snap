        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 2391,
    "message": "人都是妳的家人，要保護人。鬼都是仇敵，絕不能饒恕傷害人的鬼。",
  },
  "FamousSaying:2401" => {
    "attribute": {
