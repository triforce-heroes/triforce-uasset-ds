        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2360,
    "idSub": 0,
    "message": "聽說柱在指導我們之餘，還會運用空檔時間相互對練。
這次訓練他們真的很辛苦。",
  },
  "APK_Main20_Talk_0522:0" => {
    "attribute": {
      "data": [
