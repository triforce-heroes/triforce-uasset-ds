        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 9335,
    "idSub": 0,
    "message": "這段日子裡，我因為無法劈開岩石而備感煎熬……
此時錆兔現身了，他開始指導我。",
  },
  "StoryBattle_0170:0" => {
    "attribute": {
      "data": [
        0,
        9,
