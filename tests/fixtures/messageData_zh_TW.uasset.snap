        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2355,
    "idSub": 0,
    "message": "為什麼鬼都不出現了呢？",
  },
  "APK_Main20_Talk_0510:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        39,
