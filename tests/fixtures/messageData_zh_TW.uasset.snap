        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 210,
    "idSub": 0,
    "message": "區區一個柱……就算解決了又怎麼樣？
鬼贏過人類是理所當然的吧。",
  },
  "APK2_BSG01_MemoryFragment_001_0050:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        4,
        0,
        0,
        0,
        71,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 211,
    "idSub": 0,
    "message": "我的心願是殲滅鬼殺隊。
把他們所有人趕盡殺絕，再也無法出現在我眼前。",
  },
  "APK2_BSG01_MemoryFragment_001_0060:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        5,
        0,
        0,
        0,
        71,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 212,
    "idSub": 0,
    "message": "你得意洋洋來報告自己殺了柱，
但那個地方明明還有三名獵鬼人。",
  },
  "APK2_BSG01_MemoryFragment_001_0070:0" => {
    "attribute": {
