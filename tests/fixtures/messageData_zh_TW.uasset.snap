        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1361,
    "message": "鬼不會老。也不用賺錢吃飯。不會生病，也不會死。什麼都不會失去。",
  },
  "FamousSaying:1371" => {
    "attribute": {
      "data": [
