        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1511,
    "message": "竟敢砍壞我的壺……砍壞我的藝術！！完全不懂得審美的臭猴子！！",
  },
  "FamousSaying:1521" => {
    "attribute": {
      "data": [
