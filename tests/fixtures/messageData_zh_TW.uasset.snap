        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 17653,
    "idSub": 0,
    "message": "啊啊啊……他是被同化成鬼了吧。",
  },
  "V_P0018_V00_C00_TaishiHyo_0090:0" => {
    "attribute": {
      "data": [
