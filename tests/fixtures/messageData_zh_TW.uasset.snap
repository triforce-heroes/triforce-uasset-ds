      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1481,
    "message": "因為我們兩個是一心同體啊。",
  },
  "FamousSaying:1491" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
