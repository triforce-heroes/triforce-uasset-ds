      ],
      "type": "Buffer",
    },
    "id": 13764,
    "idSub": 0,
    "message": "んー…この先には<ruby べつ>別</ruby>に用がないよなぁ…
<ruby ちが>違</ruby>うとこ行こ",
  },
  "V_P0003_V00_C00_LevelAutoTalk_0150:0" => {
    "attribute": {
      "data": [
        0,
