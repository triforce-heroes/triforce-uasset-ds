      ],
      "type": "Buffer",
    },
    "id": 13763,
    "idSub": 0,
    "message": "…や、やめろよ！　<ruby おど>脅</ruby>かすのなし！　<ruby うご>動</ruby>いてくれよ！",
  },
  "V_P0003_V00_C00_LevelAutoTalk_0140:0" => {
    "attribute": {
      "data": [
        0,
        9,
