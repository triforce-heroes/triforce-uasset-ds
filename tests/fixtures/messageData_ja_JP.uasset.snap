        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9592,
    "idSub": 0,
    "message": "しのぶは<ruby ねこ>猫</ruby>や犬など、
<ruby ぜんしん>全身</ruby>に毛の<ruby は>生</ruby>えた<ruby い>生</ruby>き<ruby もの>物</ruby>が<ruby にがて>苦手</ruby>である。",
  },
  "TaishoRumorContent_0069:0" => {
    "attribute": {
      "data": [
        128,
