      "type": "Buffer",
    },
    "id": 10055,
    "idSub": 0,
    "message": "エリア内で<otherId_Icon_FreeMission/>が<ruby ひょうじ>表示</ruby>されている人に話しかけると
サブクエストを<ruby じゅちゅう>受注</ruby>できる。
クリアできればアイテムを<ruby かくとく>獲得</ruby>できるぞ。",
  },
  "Tutorial_APK2_text_0015_00:0" => {
    "attribute": {
      "data": [
        128,
