      ],
      "type": "Buffer",
    },
    "id": 2355,
    "idSub": 0,
    "message": "どうして<ruby おに>鬼</ruby>が<ruby で>出</ruby>なくなったんだろう？",
  },
  "APK_Main20_Talk_0510:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
