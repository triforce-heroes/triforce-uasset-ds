    "idSub": 0,
    "message": "<ruby かんじょう>感情</ruby>と<ruby にお>匂</ruby>いの色は<ruby いか>以下</ruby>の<ruby よう>様</ruby>に<ruby ひも>紐</ruby>づいているぞ。
黄：<ruby よろこ>喜</ruby>び　赤：<ruby いか>怒</ruby>り　青：<ruby ふあん>不安</ruby>",
  },
  "Tutorial_APK2_text_0012_00:0" => {
    "attribute": {
