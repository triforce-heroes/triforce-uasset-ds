        0,
      ],
      "type": "Buffer",
    },
    "id": 13755,
    "idSub": 0,
    "message": "今、何が<ruby お>起</ruby>きたの？",
  },
  "V_P0003_V00_C00_LevelAutoTalk_0060:0" => {
    "attribute": {
      "data": [
        0,
        9,
        18,
        0,
