      "type": "Buffer",
    },
    "id": 2361,
    "idSub": 0,
    "message": "<ruby はしら>柱</ruby>って<ruby ほんとう>本当</ruby>に<ruby たいへん>大変</ruby>だよな",
  },
  "APK_Main20_Talk_0530:0" => {
