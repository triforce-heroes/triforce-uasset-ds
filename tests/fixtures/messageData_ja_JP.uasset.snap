      ],
      "type": "Buffer",
    },
    "id": 13762,
    "idSub": 0,
    "message": "…どうしたの？　なんで<ruby うご>動</ruby>かないの？",
  },
  "V_P0003_V00_C00_LevelAutoTalk_0130:0" => {
    "attribute": {
      "data": [
        0,
        9,
        18,
        0,
