      ],
      "type": "Buffer",
    },
    "id": 13757,
    "idSub": 0,
    "message": "ちゃんと<ruby おれ>俺</ruby>を<ruby まも>守</ruby>ってくれよな",
  },
  "V_P0003_V00_C00_LevelAutoTalk_0080:0" => {
    "attribute": {
