        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2359,
    "idSub": 0,
    "message": "<ruby はしら>柱</ruby>は<ruby けいびたんとうちく>警備担当地区</ruby>が<ruby こうだい>広大</ruby>だし
<ruby じょうほうしゅうしゅう>情報収集</ruby>や<ruby じぶん>自分</ruby>の<ruby くんれん>訓練</ruby>もあるからな　<ruby いそが>忙</ruby>しいんだよ",
  },
  "APK_Main20_Talk_0521:0" => {
    "attribute": {
