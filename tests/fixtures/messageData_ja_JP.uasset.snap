      ],
      "type": "Buffer",
    },
    "id": 2354,
    "idSub": 0,
    "message": "<ruby ねずこ>禰豆子</ruby>って子が<ruby かんけい>関係</ruby>してるらしいけど
<ruby ぐたいてき>具体的</ruby>なことはなにもわからないんだよな",
  },
  "APK_Main20_Talk_0502:0" => {
