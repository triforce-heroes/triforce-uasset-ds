        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 13756,
    "idSub": 0,
    "message": "<ruby おれ>俺</ruby>を<ruby お>置</ruby>いていかないでくれよな",
  },
  "V_P0003_V00_C00_LevelAutoTalk_0070:0" => {
    "attribute": {
      "data": [
