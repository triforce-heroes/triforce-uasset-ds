        0,
      ],
      "type": "Buffer",
    },
    "id": 2357,
    "idSub": 0,
    "message": "それが<ruby きさつたいし>鬼殺隊士</ruby><ruby ぜんいん>全員</ruby>が<ruby たいしょう>対象</ruby>だなんて！
こんな<ruby きかい>機会</ruby><ruby にど>二度</ruby>とないぞ！！",
  },
  "APK_Main20_Talk_0512:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        57,
