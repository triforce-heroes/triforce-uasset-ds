      ],
      "type": "Buffer",
    },
    "id": 2360,
    "idSub": 0,
    "message": "<ruby こんかい>今回</ruby>も<ruby おれ>俺</ruby>たちに<ruby けいこ>稽古</ruby>をつけながら
<ruby はしらどうし>柱同士</ruby>で<ruby けいこ>稽古</ruby>するって聞くし <ruby ほんとう>本当</ruby>に<ruby たいへん>大変</ruby>だよな",
  },
  "APK_Main20_Talk_0522:0" => {
