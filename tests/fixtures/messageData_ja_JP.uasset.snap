        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2356,
    "idSub": 0,
    "message": "<ruby はしら>柱</ruby>が<ruby けいこ>稽古</ruby>をつけるといったら
これまでは<ruby つぐこ>継子</ruby><ruby あいて>相手</ruby>に<ruby かぎ>限</ruby>られていたんだ",
  },
  "APK_Main20_Talk_0511:0" => {
    "attribute": {
      "data": [
