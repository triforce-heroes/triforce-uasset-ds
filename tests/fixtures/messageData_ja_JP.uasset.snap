        255,
      ],
      "type": "Buffer",
    },
    "id": 10056,
    "idSub": 0,
    "message": "<ruby がめん>画面</ruby>に<ruby なが>流</ruby>れてくるアイコンがターゲットと<ruby かさ>重</ruby>なった時に
<ruby たいおう>対応</ruby>するボタンを<ruby お>押</ruby>そう。
<ruby いっていいじょう>一定以上</ruby>のスコアが<ruby たっせい>達成</ruby>できればクリアだ。",
  },
  "Tutorial_APK2_text_0017_00:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
