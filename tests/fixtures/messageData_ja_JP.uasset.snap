        22,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2358,
    "idSub": 0,
    "message": "<ruby はしら>柱</ruby>の<ruby ぎじゅつ>技術</ruby>をしっかり<ruby み>身</ruby>につけないと！
<ruby あいて>相手</ruby>をしてくれる<ruby はしら>柱</ruby>に<ruby もう>申</ruby>し<ruby わけ>訳</ruby>ないからな！！",
  },
  "APK_Main20_Talk_0520:0" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
