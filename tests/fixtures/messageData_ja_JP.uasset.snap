        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10057,
    "idSub": 0,
    "message": "<ruby ぜんいつ>善逸</ruby>は<kcId_kcId_Field_Smell/>で「聞き耳」を<ruby つか>使</ruby>える。
