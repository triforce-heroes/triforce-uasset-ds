      ],
      "type": "Buffer",
    },
    "id": 13761,
    "idSub": 0,
    "message": "<ruby こわ>怖</ruby>かったよおお！",
  },
  "V_P0003_V00_C00_LevelAutoTalk_0120:0" => {
    "attribute": {
      "data": [
        0,
