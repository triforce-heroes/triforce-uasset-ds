    "id": 13765,
    "idSub": 0,
    "message": "あれ？　なんでこっちに行こうと<ruby おも>思</ruby>ったんだっけ
何か用があるわけでもないし……<ruby もど>戻</ruby>ろ",
  },
  "V_P0003_V00_C00_LevelAutoTalk_0160:0" => {
