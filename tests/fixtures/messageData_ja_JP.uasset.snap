      "type": "Buffer",
    },
    "id": 7649,
    "idSub": 0,
    "message": "<ruby くも>蜘蛛</ruby>の<ruby すじょう>巣状</ruby>の糸を<ruby と>飛</ruby>ばして<ruby こうげき>攻撃</ruby>する。
<ruby おな>同</ruby>じコマンドを<ruby つづ>続</ruby>けて<ruby にゅうりょく>入力</ruby>すると、
<ruby さんだんかい>三段階</ruby>まで<ruby ついかこうげき>追加攻撃</ruby><ruby かのう>可能</ruby>。<ruby わざ>技</ruby>ゲージ20%<ruby しょうひ>消費</ruby>。",
  },
  "P1007_V00_C00_SkillInfo_0010:0" => {
