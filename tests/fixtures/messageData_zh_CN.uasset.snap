      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1691,
    "message": "斑纹……？！一开始就有的吗？那个……和鬼的花纹很像。",
  },
  "FamousSaying:1701" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
