      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1831,
    "message": "他年纪轻轻却能够将那么强烈的杀意深藏于心，值得惊叹。",
  },
  "FamousSaying:1841" => {
    "attribute": {
      "data": [
