        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1711,
    "message": "一定要变得比那个装模作样的臭小鬼更强……！！我会全力以赴帮助你的……！！",
  },
  "FamousSaying:1721" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        171,
        0,
        0,
        0,
        69,
