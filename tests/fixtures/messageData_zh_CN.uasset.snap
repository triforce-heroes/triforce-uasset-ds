      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1851,
    "message": "太漫长了……！！但就是为此，我这一千年里……才会不停增加我不想增加的同类。",
  },
  "FamousSaying:1861" => {
    "attribute": {
      "data": [
