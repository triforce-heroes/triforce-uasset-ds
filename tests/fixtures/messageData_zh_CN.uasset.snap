        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4151,
    "idSub": 0,
    "message": "我很清楚狯岳一直都很讨厌我。我也同样讨厌着他……",
  },
  "DLC_FamousSaying_0150:0" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
