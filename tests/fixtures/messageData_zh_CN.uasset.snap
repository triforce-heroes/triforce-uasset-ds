      "type": "Buffer",
    },
    "id": 250,
    "idSub": 0,
    "message": "身为鬼杀队，
当然要保护那些庸庸碌碌低调过活的凡人。",
  },
  "APK2_BSG01_MemoryFragment_007_0060:0" => {
    "attribute": {
