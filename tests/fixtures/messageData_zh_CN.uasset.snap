      "type": "Buffer",
    },
    "id": 2156,
    "idSub": 0,
    "message": "（我也想听祢豆子用她温柔的声音……！
　可恶啊！不可饶恕！！）",
  },
  "APK_Main19_AutoTalk_0090:0" => {
    "attribute": {
      "data": [
