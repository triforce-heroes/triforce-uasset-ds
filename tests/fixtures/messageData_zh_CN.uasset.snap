      "type": "Buffer",
    },
    "id": 2330,
    "idSub": 1901,
    "message": "训练的时候，蛇柱突然杀气大增，
刀法也变得更加凌厉了。",
  },
  "APK_Main20_Talk:1902" => {
    "attribute": {
