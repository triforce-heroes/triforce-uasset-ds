        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 3013,
    "idSub": 0,
    "message": "你好啊，能问你个问题吗？
你是不是和比你年长的好朋友吵架了……？",
  },
  "APK_Sub13_Talk_0380:0" => {
    "attribute": {
