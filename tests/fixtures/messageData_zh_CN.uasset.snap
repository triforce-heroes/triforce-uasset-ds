      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1401,
    "message": "我不要分开！！绝对不分开，我要和你永远在一起！！无论重来多少次，我都要当你的妹妹，都要当！！",
  },
  "FamousSaying:1411" => {
