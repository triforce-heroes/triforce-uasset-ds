        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 236,
    "idSub": 0,
    "message": "我在京极屋问出一个消息，
说是雏鹤去了最低级的房间。",
  },
  "APK2_BSG01_MemoryFragment_006_0020:0" => {
