        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 208,
    "idSub": 0,
    "message": "我已照您的吩咐除掉一柱，
还请您放心……",
  },
  "APK2_BSG01_MemoryFragment_001_0030:0" => {
    "attribute": {
