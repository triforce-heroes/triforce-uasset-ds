        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1721,
    "message": "无论如何我都不会给你钥匙的，用法也绝对不告诉你！！",
  },
  "FamousSaying:1731" => {
    "attribute": {
      "data": [
        0,
        9,
