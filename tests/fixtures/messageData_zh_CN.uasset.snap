        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 1738,
    "idSub": 1032,
    "message": "……啊呀，你来这里是有什么事吗？
什么？来找秘密武器？",
  },
  "APK_Main15_Talk:1033" => {
    "attribute": {
      "data": [
