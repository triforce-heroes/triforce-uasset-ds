      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1731,
    "message": "叫你海带头是我不对。",
  },
  "FamousSaying:1741" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        173,
        0,
        0,
        0,
        69,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1741,
    "message": "就这水平你都能被打个半死，也太没用了。你要努力。我再说一遍，抬起头来！！",
  },
  "FamousSaying:1751" => {
    "attribute": {
      "data": [
