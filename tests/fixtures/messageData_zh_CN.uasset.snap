        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 212,
    "idSub": 0,
    "message": "你志得意满地来向我报告说除掉了一柱，
但当时那里还有三个猎鬼人。",
  },
  "APK2_BSG01_MemoryFragment_001_0070:0" => {
    "attribute": {
