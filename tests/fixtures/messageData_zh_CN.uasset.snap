      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1811,
    "message": "只要吃掉那个女孩吸收掉她，我也能克服太阳！！",
  },
  "FamousSaying:1821" => {
    "attribute": {
      "data": [
