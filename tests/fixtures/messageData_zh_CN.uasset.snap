      "type": "Buffer",
    },
    "id": 247,
    "idSub": 0,
    "message": "你们只要考虑自己活命就行了，
哪怕把其他事全抛下，也得回来见我。",
  },
  "APK2_BSG01_MemoryFragment_007_0030:0" => {
    "attribute": {
