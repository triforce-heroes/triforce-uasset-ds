  "Tutorial_APK2_DLC_Title_0010:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10276,
    "idSub": 11,
    "message": "关于休闲对战",
  },
  "Tutorial_APK2_DLC_text_0010:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10267,
    "idSub": 11,
    "message": "休闲对战无需指定条件，
可立即寻找可匹配的对手进行对战。
想要轻松对战时推荐此模式。",
  },
  "Tutorial_APK2_DLC_Title_0020:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10277,
    "idSub": 11,
    "message": "关于排位赛",
  },
  "Tutorial_APK2_DLC_text_0020:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10268,
    "idSub": 11,
    "message": "通过在对战中获胜从而积累“排位积分”
与“阶级点数”，并以此竞争的模式。
排名将以月度赛季的形式进行举办。",
  },
  "Tutorial_APK2_DLC_text_0020:21" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10268,
    "idSub": 21,
    "message": "“排位积分”将随着对战败北而减少。
“阶级点数”则无关赛季可持续累加，
即使败北也不会减少。",
  },
  "Tutorial_APK2_DLC_Title_0030:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10278,
    "idSub": 11,
    "message": "关于阶级",
  },
  "Tutorial_APK2_DLC_text_0030:11" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10269,
    "idSub": 11,
    "message": "在排位赛中获胜之后可获得“阶级点数”，
随着累计点数的增加，阶级也会随之提升。
以成为最高阶级的“柱”为目标吧。",
  },
  "Tutorial_APK2_DLC_Title_0040:11" => {
