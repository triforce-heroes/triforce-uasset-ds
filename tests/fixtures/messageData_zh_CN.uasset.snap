  },
  "Tutorial_text_0093_00:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10569,
    "idSub": 0,
    "message": "房间对战最多可以支持8人在1个房间内进行对战。其中2人进行对战，其他玩家则在一旁观战。在观战中想要退出房间可以按<kcId_kcId_Battle_Pause/>。房间对战不会导致等级点数的增减。此外，房间内有2人以上时，10分钟内未对战，房间将自动解散。",
  },
  "Tutorial_text_0093_01:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10570,
    "idSub": 0,
    "message": "“选择条件进入房间”　　设置条件搜索可进入的房间。　　如果没有找到房间，　　则可以自己创建房间。　　这里创建的房间任何人都可以进入。　　想和随机的对手游玩可以选择这个选项。",
  },
  "Tutorial_text_0093_02:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10571,
    "idSub": 0,
    "message": "“创建私人房间”　　设置条件创建房间。　　房间将被分配到一个12位的房间编号。　　在这里创建的房间，　　可通过“搜索私人房间编号”进行搜索。　　想和特定的对手游玩可以选择这个选项。“搜索私人房间编号”　　通过输入“创建私人房间”时　　获得的12位房间编号，　　进入对应编号的房间。",
  },
