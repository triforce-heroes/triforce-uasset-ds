        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2429,
    "idSub": 0,
    "message": "最近我突然想到，
柱到底能拿多少薪酬呢。",
  },
  "APK_Main20_Talk_0801:0" => {
    "attribute": {
      "data": [
