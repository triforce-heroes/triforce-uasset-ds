    "id": 256,
    "idSub": 0,
    "message": "即使我放弃了对他的教导，
他也仔细研读了炎之呼吸的教本精进不休，成为了炎柱。",
  },
  "APK2_BSG01_MemoryFragment_008_0050:0" => {
    "attribute": {
      "data": [
