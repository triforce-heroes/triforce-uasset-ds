      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1351,
    "message": "真可爱，就是丑得要命。你都让我有点怜惜了呢，就像一只濒死的老鼠。",
  },
  "FamousSaying:1361" => {
    "attribute": {
      "data": [
