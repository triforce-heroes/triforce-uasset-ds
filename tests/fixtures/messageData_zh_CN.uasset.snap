  "Tutorial_text_0076_00:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10544,
    "idSub": 0,
    "message": "在线对战中使用的角色和场所，需要提前设置。

可以在“设置角色·场所”中
进行设置。",
  },
  "Tutorial_text_0076_01:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10545,
    "idSub": 0,
    "message": "在线对战中，基本上会选择
1P设置的场所，但也有例外。

在1P设置带有<otherId_Icon_DAYLIGHT/>图标的场所
&2P设置了“鬼”的角色时
会选择2P设置的场所。

“更改角色/场所并再战”时
会由1P重新选择场所。",
  },
  "Tutorial_text_0077_00:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10546,
    "idSub": 0,
    "message": "“队士票”会记录在线对战的战绩。查看一下自己的战绩吧。对战结束后，会互相交换各自的队士票，所以也能查看对战对手的信息。",
  },
  "Tutorial_text_0078_00:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10547,
    "idSub": 0,
    "message": "可以在“队士票设置”或“名言设置”中，使用“队士票底图”或“名言”定制队士票。用你专属的队士票，挑战线上对战吧。",
  },
  "Tutorial_text_0079_00:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10548,
    "idSub": 0,
    "message": "可以在“队士票一览”中查看已交换的队士票。“队士票一览”中能够保存的队士票的上限是30张。超过该数量，就会从旧队士票开始自动删除。如果有不想删除的队士票，只要将其关注，就算超过了上限张数也不会被自动删除。但是，可以关注的上限是20张。",
  },
