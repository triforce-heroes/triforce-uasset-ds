      "type": "Buffer",
    },
    "id": 2330,
    "idSub": 1913,
    "message": "你说什么？！难道我连抱怨一下都不行了吗！",
  },
  "APK_Main20_Talk:1914" => {
    "attribute": {
      "data": [
        0,
