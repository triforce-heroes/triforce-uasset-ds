        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 1738,
    "idSub": 1023,
    "message": "有备无患可是很重要的。
当然，最好还是不会有要用到它的那天。",
  },
  "APK_Main15_Talk:1031" => {
    "attribute": {
      "data": [
        0,
        9,
        17,
        0,
        0,
        0,
        141,
