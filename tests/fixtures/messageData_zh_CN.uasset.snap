        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2433,
    "idSub": 0,
    "message": "什么？你看错了吧？
恋柱和蛇柱完全就是两个世界的人吧。",
  },
  "APK_Main20_Talk_0812:0" => {
    "attribute": {
      "data": [
