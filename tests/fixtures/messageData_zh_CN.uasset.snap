        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 3012,
    "idSub": 0,
    "message": "（不管怎么说，他们的年龄相差也太大了……
　以防万一还是问一下吧。）",
  },
  "APK_Sub13_Talk_0370:0" => {
    "attribute": {
      "data": [
