        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 282,
    "idSub": 0,
    "message": "不要！我不要！我不要分开！！
绝对不分开！我要和你永远在一起！！",
  },
  "APK2_BSG01_MemoryFragment_010_0060:0" => {
