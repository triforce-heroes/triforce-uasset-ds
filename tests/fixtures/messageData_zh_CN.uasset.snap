        0,
        71,
        30,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 211,
    "idSub": 0,
    "message": "我是要你灭掉鬼杀队。
全都杀光一个不留，让他们不再脏我的眼睛。",
  },
  "APK2_BSG01_MemoryFragment_001_0060:0" => {
    "attribute": {
      "data": [
