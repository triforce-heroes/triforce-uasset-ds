        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4153,
    "idSub": 0,
    "message": "你是特别的。对爷爷和我来说，你是特别又很重要的人。但是，那样对你来说还不够吧。",
  },
  "DLC_FamousSaying_0170:0" => {
