        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2428,
    "idSub": 0,
    "message": "柱果然很厉害啊！
那种动作我根本办不到啊。",
  },
  "APK_Main20_Talk_0800:0" => {
    "attribute": {
      "data": [
