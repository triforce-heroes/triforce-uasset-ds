        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 248,
    "idSub": 0,
    "message": "比起完成任务，保命更重要，
我华丽而清晰地给人命排好了顺序。",
  },
  "APK2_BSG01_MemoryFragment_007_0040:0" => {
    "attribute": {
