        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2366,
    "idSub": 0,
    "message": "见到了见到了。那是什么来着？宝石吗？
头上脖子上戴满了饰品，实在太华丽了。",
  },
  "APK_Main20_Talk_0542:0" => {
    "attribute": {
