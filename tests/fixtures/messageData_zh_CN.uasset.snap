  "Tutorial_text_0084_00:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10556,
    "idSub": 0,
    "message": "矢琶羽会发射“箭头”进行攻击。“箭头”本身命中后虽然不会造成伤害，但会让对手大幅度后仰，造成可以追击的局面。可以通过“箭头”把对手砸向地面，或者发射岩石给对手造成伤害。",
  },
  "Tutorial_text_0088_00:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10560,
    "idSub": 0,
    "message": "触碰到敌人吐出的毒或掉在地面聚集着的毒，
就会进入中毒状态导致体力持续减少。

经过一定时间，
或者让同伴替换出场，中毒的效果会消失，
但还是多加小心，注意别碰到毒吧。",
  },
  "Tutorial_text_0089_00:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10561,
    "idSub": 0,
    "message": "在线任务是限定时间举办的活动。在限定时间内完成提出的条件就可以获得“鬼灭点数”。“每日任务”　　每天都能挑战的活动。“赛季任务”　　一定时间变换条件的活动。",
  },
  "Tutorial_text_0089_01:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10562,
    "idSub": 0,
    "message": "“特殊任务”　　鬼杀队方的角色和鬼方的角色　　在排位赛战斗，　　胜利的一方可以获得“鬼灭点数”。各任务的详情，可以查看在线任务界面。",
  },
