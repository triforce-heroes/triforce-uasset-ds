        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 251,
    "idSub": 0,
    "message": "但我可以华丽地直说，
我更在乎你们，所以别死了。",
  },
  "APK2_BSG01_MemoryFragment_007_0070:0" => {
    "attribute": {
