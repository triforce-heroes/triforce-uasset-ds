        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 210,
    "idSub": 0,
    "message": "区区一柱……你便是收拾了又如何？
鬼胜于人是天理。",
  },
  "APK2_BSG01_MemoryFragment_001_0050:0" => {
    "attribute": {
      "data": [
        0,
        9,
        35,
        0,
        0,
        0,
        4,
