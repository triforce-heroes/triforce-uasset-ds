  "Tutorial_text_0080_00:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10549,
    "idSub": 0,
    "message": "在线任务是限定时间举办的活动。在限定时间内完成提出的条件就可以获得“鬼灭点数”。“每日任务”　　每天都可以挑战的活动。“赛季任务”　　一定时间变换条件的活动。",
  },
  "Tutorial_text_0080_01:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10550,
    "idSub": 0,
    "message": "“特殊任务”　　鬼杀队方的角色和鬼方的角色　　在排位赛战斗，　　胜利的一方可以获得“鬼灭点数”。各任务的详情，可以查看在线任务界面。",
  },
  "Tutorial_text_0081_00:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10552,
    "idSub": 0,
    "message": "鬼不会共斗只能单独战斗。
（灶门祢豆子与鬼灭学园·灶门祢豆子可共斗）

在角色选择界面中，
鬼的图标上显示的<otherId_Icon_DEMON/>，
表明该角色会单独战斗。",
  },
  "Tutorial_text_0082_00:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10553,
    "idSub": 0,
    "message": "鬼没有共斗槽，
会有鬼专用的特殊槽。
（灶门祢豆子与鬼灭学园·灶门祢豆子除外）

红色的条就是特殊槽。
特殊槽积攒到50%或以上的状态下按下<kcId_kcId_Battle_Support/>，
就能发动2种动作。
（50%为1条特殊槽，100%为2条特殊槽）

消耗的特殊槽会随着时间的经过而恢复。",
  },
  "Tutorial_text_0082_01:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10554,
    "idSub": 0,
    "message": "“特殊技”　　按下<kcId_kcId_Battle_Support/>或　　按下<kcId_kcId_Battle_Move/>的同时按<kcId_kcId_Battle_Support/>，　　就会使出强大的攻击。　　※消耗50%特殊槽。“紧急脱离”　　在受到对手攻击时按下<kcId_kcId_Battle_Support/>，　　就能从对手攻击下逃离。　　※消耗100%特殊槽。",
  },
  "Tutorial_text_0083_00:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10555,
    "idSub": 0,
    "message": "鬼发动“觉醒”或“超觉醒”就会
恢复技能槽和特殊槽，
并恢复体力。
（灶门祢豆子与鬼灭学园·灶门祢豆子除外）

“超觉醒”的体力恢复量比“觉醒”多。

要注意，在受到对手的攻击，
以及在垫步或防御时，
会暂时停止体力的恢复，
导致恢复量减少。",
  },
