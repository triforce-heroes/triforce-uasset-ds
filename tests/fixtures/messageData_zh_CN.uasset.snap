        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1701,
    "message": "闭嘴，泼妇。世上有资格命令我的唯有那一位。",
  },
  "FamousSaying:1711" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        170,
        0,
        0,
        0,
        69,
