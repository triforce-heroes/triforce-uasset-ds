        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1651,
    "message": "欺凌弱者的畜生。不快，不愉快，不快至极。",
  },
  "FamousSaying:1661" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        165,
        0,
        0,
        0,
        104,
        31,
