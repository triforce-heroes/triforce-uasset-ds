      ],
      "type": "Buffer",
    },
    "id": 9572,
    "idSub": 0,
    "message": "伊之助从一位游女那里听到了
可能与庆典之神的妻子·槙於有关的话题。
伊之助能否帮她完成工作，
获得相关的情报呢……？",
  },
  "Summary_OnQuest_S27:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
