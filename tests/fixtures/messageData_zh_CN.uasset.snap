  "Tutorial_text_0080_01b:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10551,
    "idSub": 0,
    "message": "“特殊任务”　　鬼杀队方的角色和鬼方的角色　　在排位赛战斗，　　胜利的一方可以获得“鬼灭点数”。各任务的详情，查看在线任务界面。",
  },
  "Tutorial_text_0085_00:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10557,
    "idSub": 0,
    "message": "愈史郎·珠世是以愈史郎为主
进行战斗的二人一组的操作角色。

操作方法和其他的鬼相同，
虽然可以使用“特殊技”或“紧急脱离”，
但无法通过“换人”替换珠世上场。

珠世会在愈史郎使用“特殊技”时
进行支援。",
  },
  "Tutorial_text_0086_00:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10558,
    "idSub": 0,
    "message": "在线任务是限定时间举办的活动。在限定时间内完成提出的条件就可以获得“鬼灭点数”。“每日任务”　　每天都可以挑战的活动。“赛季任务”　　一定时间变换条件的活动。",
  },
  "Tutorial_text_0086_01:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10559,
    "idSub": 0,
    "message": "“特殊任务”　　鬼杀队方的角色和鬼方的角色　　在排位赛战斗，　　胜利的一方可以获得“鬼灭点数”。各任务的详情，查看在线任务界面。",
  },
  "Tutorial_text_0090_00:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10563,
    "idSub": 0,
    "message": "在标题界面的选项中将帧率从默认的30fps运行设置为60fps运行，就能以帧率优先，使游戏的动作更流畅。但是，和30fps运行相比游戏运行可能会有所差异。 另外，在线对战的排位赛、事件场景、小游戏和部分演出，即使设置为60fps也会以30fps运行。",
  },
  "Tutorial_text_0090_01:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10564,
    "idSub": 0,
    "message": "在设置为60fps运行的状态下，
若在线对战的玩家匹配或房间对战中
匹配到30fps运行的玩家时，
对战中会强制变更为30fps运行。

另外，在玩家匹配中
通过设定匹配或在房间对战中
通过“选择条件进入房间”
可以设置只匹配60fps运行的玩家。",
  },
