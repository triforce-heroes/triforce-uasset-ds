        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 1738,
    "idSub": 1031,
    "message": "那两个人吵来吵去的真烦人啊……",
  },
  "APK_Main15_Talk:1032" => {
    "attribute": {
      "data": [
        0,
        9,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        82,
