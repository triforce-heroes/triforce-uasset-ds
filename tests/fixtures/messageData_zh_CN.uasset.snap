        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2365,
    "idSub": 0,
    "message": "你见过宇髓先生的鎹鸦了吗？
总感觉很不一般啊？",
  },
  "APK_Main20_Talk_0541:0" => {
    "attribute": {
      "data": [
