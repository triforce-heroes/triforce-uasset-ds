        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9818,
    "idSub": 0,
    "message": "愈史郎的兴趣是写“珠世医生日记”。
一天会写七到十页。",
  },
  "TaishoRumorContent_0060:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9819,
    "idSub": 0,
    "message": "矢琶羽和朱纱丸在同炭治郎战斗那天是第一次见面。
他们在到达珠世的诊所前通过聊天变熟了。",
  },
  "TaishoRumorContent_0061:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9820,
    "idSub": 0,
    "message": "善逸基本上来说只要对方是女孩子，
不管对谁都会产生感觉，心神不定。",
  },
  "TaishoRumorContent_0062:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9821,
    "idSub": 0,
    "message": "响凯很爱看泷泽马琴的《里见八犬传》，
他就是受其影响才开始写传奇小说的。",
  },
  "TaishoRumorContent_0063:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9822,
    "idSub": 0,
    "message": "鎹雀的名字是“五加”，
最爱吃五加饭。
但善逸一直没有注意到，
所以总是只喂它豆子。",
  },
  "TaishoRumorContent_0064:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9823,
    "idSub": 0,
