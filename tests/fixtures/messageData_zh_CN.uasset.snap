      ],
      "type": "Buffer",
    },
    "id": 2434,
    "idSub": 0,
    "message": "所以我才惊讶啊！当时恋柱看起来还挺开心的，
对方可是那个蛇柱啊？！",
  },
  "APK_Main20_Talk_0813:0" => {
    "attribute": {
