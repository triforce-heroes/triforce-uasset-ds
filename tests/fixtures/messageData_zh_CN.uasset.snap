    "idSub": 0,
    "message": "炭治郎的鎹鸦，名字叫做“天王寺松右卫门”。",
  },
  "TaishoRumorContent_0004:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9815,
    "idSub": 0,
    "message": "善逸很抗拒最终选拔，
被愤怒的师父扇了很多巴掌。",
  },
  "TaishoRumorContent_0057:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 9816,
    "idSub": 0,
    "message": "鳞泷之所以一直戴着面具，
是因为他长得特别慈眉善目，曾因此被鬼取笑。",
  },
  "TaishoRumorContent_0058:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
