    },
    "id": 4147,
    "idSub": 0,
    "message": "那家伙肯定也在这里。他应该也一样，必须得见我才对。",
  },
  "DLC_FamousSaying_0120:0" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        111,
        1,
        0,
        0,
        206,
        27,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4148,
    "idSub": 0,
    "message": "狯岳，你变成了鬼，我再也不会把你当作师兄了。",
  },
  "DLC_FamousSaying_0130:0" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        112,
        1,
        0,
        0,
        206,
        27,
        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4149,
    "idSub": 0,
    "message": "如果我是废物，那你就是人渣。",
  },
  "DLC_FamousSaying_0140:0" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        113,
        1,
        0,
        0,
