      ],
      "type": "Buffer",
    },
    "id": 2432,
    "idSub": 0,
    "message": "我上次看到恋柱和蛇柱在一起吃饭啊。
真是太意外了，他们两位原来关系不错啊。",
  },
  "APK_Main20_Talk_0811:0" => {
    "attribute": {
      "data": [
