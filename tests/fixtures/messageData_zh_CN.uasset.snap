        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1411,
    "message": "我那个可爱的傻妹妹都这么努力了，你们居然还欺负她。我要杀光你们这些人。",
  },
  "FamousSaying:1421" => {
