        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1671,
    "message": "该死的极恶之徒们！",
  },
  "FamousSaying:1681" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        167,
        0,
        0,
        0,
