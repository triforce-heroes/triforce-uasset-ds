        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 2330,
    "idSub": 1912,
    "message": "我也不是故意要打你的啊！而且啊，
被绑在上面的家伙也好意思那么高高在上地说我吗！",
  },
  "APK_Main20_Talk:1913" => {
    "attribute": {
