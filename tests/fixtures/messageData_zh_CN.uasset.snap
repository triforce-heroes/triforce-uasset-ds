      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1746,
    "message": "呜哇——对不起，我之前很讨厌你。",
  },
  "FamousSaying:1811" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
