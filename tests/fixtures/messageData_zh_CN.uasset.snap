  "Tutorial_text_0092_00:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10567,
    "idSub": 0,
    "message": "区域中闪闪发光的地方，可以获得“鬼灭点数”。获得的“鬼灭点数”，可用于解锁褒奖牌。仔细探索区域每个角落收集鬼灭点数吧。",
  },
  "Tutorial_text_0092_01:0" => {
    "attribute": {
      "data": [
        128,
        9,
        4,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
        255,
      ],
      "type": "Buffer",
    },
    "id": 10568,
    "idSub": 0,
    "message": "“鬼灭点数”除了可以通过探索区域收集外，还可以在游戏中通过完成特定的条件获得。具体条件请查看褒奖盘。另外，可获得“鬼灭点数”的条件中，有些只能完成一次，有些不限次数。标有<otherId_Icon_Repeat/>的条件，每次完成都会获得“鬼灭点数”。",
  },
