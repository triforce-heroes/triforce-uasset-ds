        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4734,
    "idSub": 1681,
    "message": "这是何等的穷凶极恶？简直是畜生的行径。",
  },
  "FamousSaying:1691" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
        168,
