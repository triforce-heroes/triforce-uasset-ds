        0,
        0,
        0,
        0,
        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 4152,
    "idSub": 0,
    "message": "但我也打从心底尊敬你。你一直都很努力、勇往直前，我总是注视着你的背影。",
  },
  "DLC_FamousSaying_0160:0" => {
    "attribute": {
      "data": [
        0,
        9,
        38,
        0,
        0,
        0,
