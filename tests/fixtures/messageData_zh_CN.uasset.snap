        0,
        0,
      ],
      "type": "Buffer",
    },
    "id": 253,
    "idSub": 0,
    "message": "在炼狱先生离世差不多四个月后，
我收到了炼狱先生的父亲……槙寿郎先生的来信。",
  },
  "APK2_BSG01_MemoryFragment_008_0020:0" => {
    "attribute": {
