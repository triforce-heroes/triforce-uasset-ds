{
  "name": "@triforce-heroes/triforce-uasset-ds",
  "version": "1.0.0",
  "description": "Extract and rebuild .uasset for Demon Slayer II.",
  "license": "Apache License 2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./Extract": "./dist/Extract.js",
    "./Rebuild": "./dist/Rebuild.js"
  },
  "scripts": {
    "build": "rimraf ./dist && tspc -p ./tsconfig.build.json && swc ./dist -d .",
    "watch": "tsx --watch ./tools/watch.ts",
    "oxfmt": "oxfmt --check ./src ./tests ./tools",
    "oxfmt:fix": "oxfmt --write ./src ./tests ./tools",
    "eslint": "eslint ./src ./tests ./tools",
    "eslint:fix": "eslint --fix ./src ./tests ./tools",
    "test": "vitest"
  },
  "dependencies": {
    "@rheactor/eslint-config-rheactor": "github:rheactor/eslint-config-rheactor",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.40",
    "@triforce-heroes/triforce-core": "github:triforce-heroes/triforce-core",
    "@triforce-heroes/triforce-publisher": "github:triforce-heroes/triforce-publisher",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "oxfmt": "^0.53.0",
    "rimraf": "^6.1.3",
    "ts-patch": "^4.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-transform-paths": "^4.0.0",
    "vitest": "^4.1.8"
  }
}
